# Copiar a ~/.config/ime-ops-hub.env en srv1715444 y dejarlo en modo 600.
# ime-ops-hub.service lo carga con EnvironmentFile. No commitear valores reales.
# Siempre obligatorias: IME_OPS_TOKEN, IME_OPS_SECRET.
# IME_OPS_2FA=off (defecto) no pide código ni SMTP.
# IME_OPS_2FA=on exige el código y las variables SMTP de abajo.
# IME_OPS_TOTP_SECRET ya no se usa.
# Las rutas de vault y de kanban.db las completa Integrador; aquí solo hay marcadores.
IME_OPS_KANBAN_DIR=/RUTA/DEL/VAULT
IME_OPS_DB=/home/shoky/.local/state/ops-hub/ops-hub.db
IME_OPS_LOG=/home/shoky/.local/state/ops-hub/log
IME_HERMES_KANBAN_DB=/RUTA/DE/kanban.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PANEL_TABLON_WEBHOOK_URL=
PANEL_TABLON_WEBHOOK_SECRET=
IME_OPS_TOKEN=
IME_OPS_SECRET=
IME_OPS_2FA=off
IME_OPS_2FA_EMAIL=
IME_OPS_SMTP_HOST=
IME_OPS_SMTP_PORT=587
IME_OPS_SMTP_USER=
IME_OPS_SMTP_PASS=
IME_OPS_SMTP_FROM=
IME_OPS_REQUIRE_AUTH=1
OPS_ADMIN_USER=root@i-me.com.co
OPS_ADMIN_ALIAS=shoky
OPS_ADMIN_PASSWORD=
OPS_ADMIN_PASSWORD_ALT=
OPS_GERENCIA_USER=gerencia@i-me.com.co
OPS_GERENCIA_PASSWORD=
IME_CONTACTO_BBRAUN=
IME_CONTACTO_FRESENIUS=
