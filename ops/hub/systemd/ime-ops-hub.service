[Unit]
Description=Hub de ops.i-me.com.co
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/bin/ime-ops-hub
ExecStart=/usr/bin/python3 %h/bin/ime-ops-hub/ime-ops-hub.py
Environment=IME_OPS_BIND=127.0.0.1
Environment=IME_OPS_PORT=18880
# El archivo es obligatorio y debe ser modo 600. Sin el prefijo «-»:
# si no existe, systemd no arranca el proceso.
# Obligatorio: IME_OPS_TOKEN, IME_OPS_SECRET, IME_OPS_TOTP_SECRET.
EnvironmentFile=%h/.config/ime-ops-hub.env
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
