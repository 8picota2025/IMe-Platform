      "typeVersion": 1,
      "position": [280, 0],
      "notes": "Requiere IME_VAULT, IME_SENT_LOG, IME_CMS_CACHE y SUPABASE_ACCESS_TOKEN en el entorno del worker. No incluye secretos."
