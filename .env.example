# Supabase (proyecto en supabase.com) — TODO_CLIENTE
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # SOLO en Edge Functions
SITE_URL=https://i-me.com.co # URL publica del sitio, usada en redirects de pago

# Observabilidad / Sentry — opcional hasta disponer de proyecto y DSN
PUBLIC_SENTRY_DSN=          # DSN publico del proyecto Sentry para el cliente web
PUBLIC_SENTRY_RELEASE=      # release opcional (ej. commit SHA)
PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=          # solo CI/build si se suben source maps
SENTRY_DSN=                 # DSN para Edge Functions (secret en Supabase)

# Analítica y medición — GA4 + GTM + Clarity + Search Console
PUBLIC_GA_ID=G-YKKFCZHE2N   # GA4 Measurement ID (prod i-me.com.co)
PUBLIC_GTM_ID=              # GTM-XXXXXXX (opcional; gtag cubre GA4)
PUBLIC_CLARITY_ID=          # Clarity Project ID (heatmaps + session replay)
PUBLIC_SEARCH_CONSOLE_VERIFICATION=  # token del meta google-site-verification
PUBLIC_SEARCH_CONSOLE_FILE=          # googleXXXXXXXX.html (método archivo HTML)
PUBLIC_ANALYTICS_DOMAIN=i-me.com.co  # cookie_domain para GA/GTM

# LLM / IA — TODO_CLIENTE
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
LLM_PROVIDER=anthropic
LLM_CHAT_MODEL=claude-sonnet-4-6
LLM_INGEST_MODEL=claude-sonnet-4-6
BUDGET_MENSUAL_USD=50

# 9Router gateway local — TODO_CLIENTE
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=

# Embeddings Asesor RAG — cambiar provider/dim implica re-embeber todo el catalogo
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# Ollama (desarrollo local, sin credenciales, coste $0) — ver
# docs/decisions/0005-ollama-asesor-local.md. Si `supabase functions serve`
# corre en Docker y Ollama en el host, cambia localhost por
# http://172.17.0.1:11434 (bridge Linux) o http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
# OCR presupuestos competencia: moondream vía puente local (recomendado en prod).
OCR_VISION_PROVIDER=gemini
# Bridge engines: auto | gemini | google_vision | rapid | moondream
# OCR_ENGINE=auto
# OCR_GEMINI_MODEL=gemini-3.6-flash
# GEMINI_API_KEY=...   # o GOOGLE_API_KEY — vive en el bridge local
# OCR_TEXT_MODEL=qwen3-imeia
# OCR_RAPID_PYTHON=/path/to/.venv-ocr/bin/python
LLM_VISION_MODEL=moondream
# Puente: node scripts/ocr-moondream-bridge.mjs  → túnel Cloudflare a :3850
# OCR_BRIDGE_URL=https://xxxx.trycloudflare.com
# OCR_BRIDGE_SECRET=cambia-esto
# OLLAMA_VISION_TIMEOUT_MS=180000
# GOOGLE_VISION_API_KEY=...  # opcional: DOCUMENT_TEXT_DETECTION → qwen
# Alternativa local sin credenciales (desarrollo):
# LLM_PROVIDER=ollama
# LLM_CHAT_MODEL=qwen3:8b
# LLM_INGEST_MODEL=qwen3:8b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_DIM=1024

# Pagos Colombia — TODO_CLIENTE (wompi.co)
WOMPI_PUBLIC_KEY=           # pub_prod_... (llave pública — usada en URL checkout hospedado)
WOMPI_PRIVATE_KEY=          # prv_prod_... (llave privada — autenticación API server-side)
WOMPI_INTEGRITY_SECRET=     # secreto de integridad (firma de checkout)
WOMPI_EVENTS_SECRET=        # secreto de eventos (firma de webhooks)
WOMPI_API_BASE=https://production.wompi.co/v1  # sandbox: https://sandbox.wompi.co/v1

# Pagos Internacional — TODO_CLIENTE
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transferencia bancaria manual (cotizaciones formalizadas)
TRANSFERENCIA_BANCO=Bancolombia
TRANSFERENCIA_TITULAR=I-ME International Medical Enterprise S.A.S.
TRANSFERENCIA_NIT=
TRANSFERENCIA_TIPO_CUENTA=Ahorros
TRANSFERENCIA_NUMERO=
TRANSFERENCIA_SWIFT=
TRANSFERENCIA_INSTRUCCIONES=Transfiere el valor exacto de la cotizacion e indica la referencia en el concepto. Luego sube el comprobante en el enlace del correo.

# Fiscal Colombia / DIAN — configurar antes de activar facturacion electronica real
CO_DEFAULT_IVA_PCT=19
CO_DEFAULT_RETEFUENTE_PCT=
CO_DEFAULT_RETEIVA_PCT=
CO_DEFAULT_RETEICA_PCT=
CO_RETEFUENTE_BASE_MINIMA=
CO_RETEIVA_BASE_MINIMA=
CO_RETEICA_BASE_MINIMA=
# Fiscal Colombia / DIAN — facturacion electronica + consulta NIT
# Emision: Siigo (SIIGO_*). Consulta razon social por NIT:
#   DIAN_PROVIDER_NAME=verifik|coresoft|generic
#   DIAN_PROVIDER_API_URL=https://api.verifik.co/v2/co/company/dian
#   DIAN_PROVIDER_API_TOKEN=<bearer>
# Opcional: DIAN_PROVIDER_METHOD=GET|POST (default GET para verifik)
DIAN_PROVIDER_NAME=
DIAN_PROVIDER_API_URL=
DIAN_PROVIDER_API_TOKEN=

# Anti-bot — TODO_CLIENTE
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=   # mismo valor que TURNSTILE_SITE_KEY, expuesto al cliente para el widget Asesor

# IMEIA — Grok (xAI) con el mismo rol que WhatsApp Business.
# Ruta: widget → Edge Function `asesor` → api.x.ai/v1/chat/completions
# (producción en i-me.com.co NO usa PUBLIC_IMEIA_API_URL en el navegador).
# Ver docs/imeia-asesor-path.md. WhatsApp Business oficial: +57 313 724 7353.
# Preferido: XAI_API_KEY. Alternativa: IMEIA_API_URL=https://api.x.ai + IMEIA_API_KEY.
XAI_API_KEY=
XAI_API_URL=https://api.x.ai
# Gateway OpenAI-compat legado (Hermes). Si apunta a api.x.ai se trata como Grok.
PUBLIC_IMEIA_API_URL=
IMEIA_API_URL=
IMEIA_API_KEY=
# En xAI el default es grok-4. NUNCA `imeia` (agente SOUL de Hermes).
IMEIA_CHAT_MODEL=grok-4
PUBLIC_IMEIA_CHAT_MODEL=

# Rate-limit Asesor (ventana corta anti-burst + tope diario)
ASESOR_RATE_LIMIT_VENTANA_SEGUNDOS=60
ASESOR_RATE_LIMIT_MAX_VENTANA=8
ASESOR_RATE_LIMIT_MAX_DIA=60

# Rate-limit crear-pago (10/hora/IP — F4.1, docs/decisions/0001-rate-limit-crear-pago.md)
CREAR_PAGO_RATE_LIMIT_VENTANA_SEGUNDOS=3600
CREAR_PAGO_RATE_LIMIT_MAX_VENTANA=10
CREAR_PAGO_RATE_LIMIT_MAX_DIA=30

# notificar-proveedor, canal email — TODO_CLIENTE (estilo Resend; sin esto, canal='email' queda en estado 'error' con mensaje accionable)
MAILER_API_KEY=
MAILER_FROM=

# CMS Comercial (/comercial) — Twenty CRM (solo Edge Functions, nunca en el navegador)
TWENTY_BASE_URL=
TWENTY_API_KEY=
# WhatsApp sin Business API todavía: 'link' genera deep-links wa.me desde el backend
WHATSAPP_MODE=link
# Rate-limit de la Edge Function comercial-share (envío de catálogo por email/WhatsApp)
COMERCIAL_SHARE_RATE_LIMIT_VENTANA_SEGUNDOS=3600
COMERCIAL_SHARE_RATE_LIMIT_MAX_VENTANA=30
COMERCIAL_SHARE_RATE_LIMIT_MAX_DIA=100

# CI/CD Deploy — TODO_CLIENTE
CI_DEPLOY_HOOK=
