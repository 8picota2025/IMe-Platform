# I-ME F5 legacy redirects
# Apache/Hostinger static deployment. Keep redirects explicit; do not add SPA fallback.

RewriteEngine On

# Canonical host
# Evita la cadena www → raíz → /es/ para la URL de entrada más frecuente.
RewriteCond %{HTTP_HOST} ^www\.i-me\.com\.co$ [NC]
RewriteRule ^$ https://i-me.com.co/es/ [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.i-me\.com\.co$ [NC]
RewriteRule ^ https://i-me.com.co%{REQUEST_URI} [R=301,L]

# Canonical entry points
RewriteRule ^$ /es/ [R=301,L]
RewriteRule ^index\.html$ /es/ [R=301,L]
RewriteRule ^pagoswompi$ /pagoswompi/ [R=301,L]
RewriteRule ^clear-sw/?$ /clear-sw.html [L]
RewriteRule ^77/?$ /es/ [R=301,L]
RewriteRule ^77/index\.html$ /es/ [R=301,L]
RewriteRule ^es/productos/?$ /es/catalogo/ [R=301,L]
RewriteRule ^en/products/?$ /en/catalog/ [R=301,L]
RewriteRule ^en/contact$ /en/contact/ [R=301,L]

# Legacy editorial aliases → conocimiento / knowledge (trailing slash = site policy)
# Exact hubs only — do not blanket-redirect /blog/* without per-slug maps.
RewriteRule ^blog/?$ /es/conocimiento/ [R=301,L,NE]
RewriteRule ^conocimiento/?$ /es/conocimiento/ [R=301,L,NE]
RewriteRule ^en/blog/?$ /en/knowledge/ [R=301,L,NE]
RewriteRule ^knowledge/?$ /en/knowledge/ [R=301,L,NE]

# Sitemap aliases — bots often hit /sitemap.xml; real inventory is sitemap-index.xml
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^sitemap-0\.xml$ /sitemap-index.xml [R=301,L]

# Google Merchant feed: canonical site path → Edge Function (fuente dinámica).
# 302: permite cambiar backend sin cache permanente en crawlers.
RewriteRule ^feed-google\.xml$ https://nnfbucwiasuggyfoyydo.supabase.co/functions/v1/generar-feed-google [R=302,L]

# Typo product slug (missing leading "m") → canonical
RewriteRule ^es/productos/onitor-de-paciente-p22-biolight/?$ /es/productos/monitor-de-paciente-p22-biolight/ [R=301,L]
RewriteRule ^en/products/onitor-de-paciente-p22-biolight/?$ /en/products/monitor-de-paciente-p22-biolight/ [R=301,L]

# Root legacy HTML (duplicate catalog without redirect)
RewriteRule ^catalogo\.html$ /es/catalogo/ [R=301,L]

# Catalog ?familia= → SEO family landings (GSC: alternate canonical)
RewriteCond %{QUERY_STRING} ^familia=([a-z0-9-]+)(&.*)?$ [NC]
RewriteRule ^es/catalogo/?$ /es/familias/%1/? [R=301,L]

RewriteCond %{QUERY_STRING} ^familia=([a-z0-9-]+)(&.*)?$ [NC]
RewriteRule ^en/catalog/?$ /en/families/%1/? [R=301,L]

# Other catalog query variants → base catalog URL
RewriteCond %{QUERY_STRING} .+
RewriteRule ^es/catalogo/?$ /es/catalogo/? [R=301,L]

RewriteCond %{QUERY_STRING} .+
RewriteRule ^en/catalog/?$ /en/catalog/? [R=301,L]

# Contact tracking/query params → canonical contact page
RewriteCond %{QUERY_STRING} .+
RewriteRule ^es/contacto/?$ /es/contacto/? [R=301,L]

RewriteCond %{QUERY_STRING} .+
RewriteRule ^en/contact/?$ /en/contact/? [R=301,L]

# Legacy catalog and category URLs
RewriteRule ^77/catalogo\.html$ /es/catalogo/ [R=301,L]
RewriteRule ^77/monitores\.html$ /es/familias/monitores/ [R=301,L]
RewriteRule ^77/cardiologia\.html$ /es/familias/cardiologia/ [R=301,L]
RewriteRule ^77/sala-cirugia\.html$ /es/familias/sala-cirugia/ [R=301,L]
RewriteRule ^77/neonatologia\.html$ /es/familias/neonatologia/ [R=301,L]
RewriteRule ^77/ultrasonido\.html$ /es/familias/ultrasonido/ [R=301,L]
RewriteRule ^77/soluciones-iv\.html$ /es/familias/soluciones-iv/ [R=301,L]
RewriteRule ^77/mobiliario\.html$ /es/familias/mobiliario/ [R=301,L]
RewriteRule ^77/anestesia\.html$ /es/familias/anestesia/ [R=301,L]

# Legacy core pages
RewriteRule ^77/servicios\.html$ /es/servicios/ [R=301,L]
RewriteRule ^77/contacto\.html$ /es/contacto/ [R=301,L]
RewriteRule ^77/financiacion\.html$ /es/financiacion/ [R=301,L]

# Old archive. Default to Spanish home unless a future audited mapping says otherwise.
RewriteRule ^1old(/.*)?$ /es/ [R=301,L]

# MIME types: Hostinger/LiteSpeed serves .mjs as text/plain by default.
# With X-Content-Type-Options: nosniff that breaks ES module workers (pdf.js).
<IfModule mod_mime.c>
  AddType text/javascript .mjs
  AddType application/wasm .wasm
</IfModule>

# Security headers for static hosting.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>



