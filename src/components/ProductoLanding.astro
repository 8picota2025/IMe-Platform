    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem 2.25rem;
    box-shadow: var(--shadow-md);
    max-width: 720px;
  }
  .cert-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .cert-badge {
    display: inline-flex;
    align-items: center;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-mid);
  }
  .valor-card__texto {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--t900);
    margin: 0;
  }

  /* Relacionados */
  .relacionados__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* CTA final — degradado oscuro de ancho completo, como el modelo */
  .cta-final {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl);
    color: var(--white);
    text-align: center;
  }
  .cta-final__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--t900) 0%, var(--t700) 100%);
    z-index: -1;
  }
  .cta-final__inner h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 800;
    margin: 0 0 0.75rem;
    color: var(--white);
  }
  .cta-final__inner p {
    max-width: 520px;
    margin: 0 auto 1.75rem;
    opacity: 0.88;
  }
  .cta-final__acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* ─── PDP unificada (commerce / quote) — sin hero turquesa ───────── */
  .producto-landing > .breadcrumb.container,
  .producto-landing .pdp-top > .container,
  .producto-landing > .section.container,
  .producto-landing > .pdp-tabs.container,
  .producto-landing > .pdp-lower.container {
    max-width: 1440px;
    padding-inline: clamp(24px, 3vw, 48px);
  }

  .pdp-lower {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    padding-block: 1.5rem 2.5rem;
  }
  @media (min-width: 1024px) {
    .pdp-lower {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
      align-items: start;
    }
  }
  .pdp-tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .pdp-tabs__tab {
    appearance: none;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 0.75rem 0.15rem;
    font: inherit;
    font-weight: 700;
    color: var(--text-mid);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pdp-tabs__tab[aria-selected='true'] {
    color: var(--t700, #0f5a6d);
    border-bottom-color: var(--t700, #0f5a6d);
  }
  .pdp-tabs__tab:focus-visible {
    outline: 2px solid var(--t700);
    outline-offset: 2px;
  }
  .pdp-tabs__panel[hidden] {
    display: none;
  }
  .pdp-assist-card {
    display: grid;
    gap: 0.75rem;
    padding: 1.15rem 0 0;
    border: none;
    border-top: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    margin-bottom: 1.25rem;
  }
  .pdp-assist-card h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  .pdp-assist-card p {
    margin: 0;
    color: var(--text-mid);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .pdp-assist-card--muted {
    background: transparent;
  }
  .pdp-desc-highlights {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .pdp-desc-highlights li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--text);
  }
  .pdp-desc-highlights li > span:first-child {
    color: var(--t800);
    font-weight: 800;
  }

  .producto-landing > .section {
    padding-block: 1.75rem;
  }
  .producto-landing > .section.section-off {
    padding-block: 1.75rem;
  }
  .pdp-top {
    background: #f7f9fb;
    padding-block: 0.75rem 1.5rem;
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pdp-gallery,
    .pdp-identity,
    .product-purchase-panel,
    .quote-card {
      animation: pdp-rise 360ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .pdp-identity {
      animation-delay: 40ms;
    }
    .product-purchase-panel,
    .quote-card {
      animation-delay: 80ms;
    }
  }
  @keyframes pdp-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .pdp-top__grid {
    display: grid;
    gap: 1.5rem 2rem;
    align-items: start;
  }
  /* Mobile: stack identity → gallery → purchase/quote (no gallery-first) */
  .pdp-top__grid--commerce,
  .pdp-top__grid--quote {
    grid-template-columns: 1fr;
  }
  .pdp-buy--commerce {
    display: contents;
  }
  .pdp-buy--quote {
    display: contents;
  }
  .pdp-gallery,
  .pdp-identity {
    min-width: 0;
  }
  .pdp-top__grid--commerce .pdp-identity,
  .pdp-top__grid--quote .pdp-identity {
    order: 1;
  }
  .pdp-top__grid--commerce .pdp-gallery,
  .pdp-top__grid--quote .pdp-gallery {
    order: 2;
  }
  .pdp-top__grid--commerce .product-purchase-panel,
  .pdp-top__grid--quote .quote-card {
    order: 3;
  }

  @media (min-width: 900px) {
    .pdp-buy--commerce {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      min-width: 0;
      order: initial;
    }
    .pdp-top__grid--commerce .pdp-identity,
    .pdp-top__grid--commerce .pdp-gallery,
    .pdp-top__grid--commerce .product-purchase-panel,
    .pdp-top__grid--quote .pdp-identity,
    .pdp-top__grid--quote .pdp-gallery,
    .pdp-top__grid--quote .quote-card {
      order: initial;
    }
    .pdp-top__grid--commerce {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: 1.75rem 2.5rem;
    }
    .pdp-top__grid--quote {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
    .pdp-top__grid--quote .pdp-gallery {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .pdp-top__grid--quote .pdp-identity {
      grid-column: 2;
      grid-row: 1;
    }
    .pdp-top__grid--quote .quote-card {
      grid-column: 2;
      grid-row: 2;
    }
  }
  @media (min-width: 1200px) {
    .pdp-top__grid--quote {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.9fr) minmax(300px, 0.85fr);
    }
    .pdp-top__grid--quote .pdp-gallery {
      grid-column: 1;
      grid-row: 1;
    }
    .pdp-top__grid--quote .pdp-identity {
      grid-column: 2;
      grid-row: 1;
    }
    .pdp-top__grid--quote .quote-card {
      grid-column: 3;
      grid-row: 1;
      position: sticky;
      top: 96px;
    }
  }

  .pdp-gallery__main {
    position: relative;
    aspect-ratio: 1 / 1;
    max-height: min(560px, 70vh);
    background:
      radial-gradient(ellipse at 30% 20%, rgba(126, 217, 87, 0.06), transparent 55%),
      linear-gradient(160deg, #f0f6f8 0%, #ffffff 48%, #eef3f6 100%);
    border: 1px solid var(--border);
    border-radius: 1rem;
    overflow: hidden;
    display: grid;
    place-items: center;
    height: auto;
    min-height: 0;
    box-shadow: 0 1px 0 rgba(15, 76, 92, 0.04);
  }
  .pdp-highlights {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem 1rem;
  }
  .pdp-highlights li {
    display: flex;
    gap: 0.45rem;
    align-items: flex-start;
    font-size: 0.88rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .pdp-highlights li > span:first-child {
    color: var(--green, #2f9e44);
    font-weight: 800;
  }
  @media (max-width: 899px) {
    .pdp-highlights {
      grid-template-columns: 1fr;
    }
    .pdp-gallery__main {
      aspect-ratio: 4 / 3;
      max-height: 42vh;
    }
  }
  .pdp-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
  }
  .pdp-gallery__badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pdp-gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .pdp-gallery__thumb {
    width: 72px;
    height: 72px;
    padding: 0;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    overflow: hidden;
    cursor: pointer;
  }
  .pdp-gallery__thumb[aria-current='true'],
  .pdp-gallery__thumb.is-active {
    border-color: var(--t700);
    box-shadow: 0 0 0 2px rgba(26, 95, 110, 0.2);
  }
  .pdp-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp-gallery__thumb:focus-visible {
    outline: 2px solid var(--t700);
    outline-offset: 2px;
  }

  .pdp-identity__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-mid);
  }
  .pdp-identity h1 {
    margin: 0 0 0.75rem;
    color: var(--t900, #0f4c5c);
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.8vw, 2.45rem);
    line-height: 1.18;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .pdp-identity__desc {
    margin: 0 0 1rem;
    color: var(--text-mid);
    line-height: 1.6;
    max-width: 52ch;
  }
  .pdp-identity__trust {
    list-style: none;
    margin: 0 0 0.85rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.15rem;
  }
  .pdp-identity__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: var(--text);
    font-weight: 600;
  }
  .pdp-identity__trust-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px var(--green-pale);
    flex-shrink: 0;
  }
  .pdp-identity__trust-dot--no {
    background: var(--text-mid);
    box-shadow: none;
  }
  .pdp-identity__trust-mark {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: var(--t100);
    border: 1px solid var(--border-mid);
    flex-shrink: 0;
  }
  .producto-landing__compare {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-mid);
    font-size: 0.86rem;
    margin-top: 0.15rem;
  }

  .product-purchase-panel {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    padding: 0;
    border-radius: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    min-width: 0;
  }
  .product-purchase-panel__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }
  .product-purchase-panel__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--green-pale);
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--ink);
  }
  .product-purchase-panel__availability--no {
    background: var(--off2);
  }
  .product-purchase-panel__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--green);
  }
  .product-purchase-panel__availability--no .product-purchase-panel__dot {
    background: var(--text-mid);
  }
  .product-purchase-panel__price-label {
    margin: 0 0 0.2rem;
    font-size: 0.8rem;
    color: var(--text-mid);
  }
  .product-purchase-panel__price {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--t900, #0f4c5c);
    font-variant-numeric: tabular-nums;
  }
  .product-purchase-panel__price small {
    margin-inline-start: 0.35rem;
    font-size: 0.38em;
    font-weight: 700;
    color: var(--text-mid);
  }
  .product-purchase-panel__price-notice {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-mid);
    line-height: 1.45;
  }
  .product-purchase-panel__quantity {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .product-purchase-panel__qty-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-mid);
  }
  .commerce-stepper {
    display: inline-flex;
    align-items: stretch;
    border: 1.5px solid var(--border-mid, var(--border));
    border-radius: var(--radius);
    overflow: hidden;
    align-self: flex-start;
  }
  .commerce-stepper button {
    width: 48px;
    min-height: 48px;
    border: none;
    background: var(--off, #f3f6f8);
    font-size: 1.3rem;
    cursor: pointer;
  }
  .commerce-stepper output {
    min-width: 3ch;
    display: grid;
    place-items: center;
    font-weight: 700;
    padding-inline: 0.75rem;
  }
  .btn-pdp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    width: 100%;
    border-radius: 14px;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    cursor: pointer;
    border: none;
    font-family: inherit;
  }
  .btn-pdp--primary {
    background: #7ed957;
    color: #0f4c5c;
  }
  .btn-pdp--primary:hover {
    filter: brightness(0.97);
  }
  .btn-pdp--secondary {
    background: #0f4c5c;
    color: #fff;
    border: none;
  }
  .btn-pdp--secondary:hover {
    filter: brightness(1.06);
  }
  .btn-pdp--ghost {
    background: transparent;
    color: var(--t800);
    border: 1.5px solid var(--border-mid);
  }
  .btn-pdp--ghost:hover {
    background: var(--t50);
  }
  .btn-pdp:focus-visible {
    outline: 2px solid var(--t700);
    outline-offset: 2px;
  }
  .btn-pdp,
  .quote-btn,
  .commerce-stepper button,
  .quote-stepper__btn {
    transition:
      background 180ms var(--ease),
      filter 180ms var(--ease),
      border-color 180ms var(--ease),
      transform 150ms var(--ease);
  }
  .btn-pdp:active:not(:disabled),
  .quote-btn:active:not(:disabled) {
    transform: translateY(1px);
  }
  .product-purchase-panel__payments,
  .product-purchase-panel__trust {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-mid);
    font-size: 0.85rem;
  }
  .product-purchase-panel__trust {
    display: grid;
    gap: 0.35rem;
  }
  .product-purchase-panel__link {
    align-self: flex-start;
    background: none;
    border: none;
    padding: 0;
    color: var(--t700);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
  }
  .cta-sticky--commerce .cta-sticky__precio {
    margin: 0;
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--ink);
  }
  @media (max-width: 767px) {
    .cta-sticky {
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
    }
  }

  /* ─── Estado "precio bajo cotización" ─────────────────────────────── */
  .hero-producto__inner--quote {
    grid-template-columns: 1fr;
    align-items: start;
    row-gap: 0.9rem;
    grid-template-areas:
      'badge'
      'title'
      'media'
      'card'
      'desc'
      'stats'
      'compare';
  }
  .hero-producto__inner--quote .hero-producto__content {
    display: contents;
  }
  .hero-producto__inner--quote .hero-producto__badge {
    grid-area: badge;
  }
  .hero-producto__inner--quote h1 {
    grid-area: title;
  }
  .hero-producto__inner--quote .hero-producto__media {
    grid-area: media;
  }
  .hero-producto__inner--quote .quote-card {
    grid-area: card;
  }
  .hero-producto__inner--quote .hero-producto__desc {
    grid-area: desc;
  }
  .hero-producto__inner--quote .hero-producto__stats {
    grid-area: stats;
    margin-block-start: 0;
  }
  .hero-producto__inner--quote .producto-landing__compare {
    grid-area: compare;
  }
  @media (min-width: 900px) {
    .hero-producto__inner--quote {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-lg);
      grid-template-areas:
        'badge media'
        'title media'
        'desc media'
        'card media'
        'stats media'
        'compare media';
      grid-template-rows: repeat(5, auto) 1fr;
    }
  }
  @media (min-width: 1200px) {
    .hero-producto__inner--quote {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(300px, 340px);
      grid-template-areas:
        'badge media card'
        'title media card'
        'desc media card'
        'stats media card'
        'compare media card';
      grid-template-rows: repeat(4, auto) 1fr;
    }
    .hero-producto__inner--quote .quote-card {
      position: sticky;
      top: 96px;
    }
  }

  .hero-producto__inner--quote .quote-card,
  .hero-producto__inner--quote .hero-producto__media {
    align-self: start;
  }
  @media (max-width: 899px) {
    .hero-producto--quote {
      padding-block: var(--space-md) var(--space-lg);
    }
    .hero-producto__inner--quote .hero-producto__media {
      aspect-ratio: 16 / 9;
      max-height: 28vh;
    }
  }

  .quote-card {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    padding: 1.35rem 1.4rem;
    border-radius: 1rem;
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--border);
    box-shadow: 0 2px 12px rgba(15, 76, 92, 0.05);
    min-width: 0;
  }
  .quote-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    font-size: 0.82rem;
  }
  .quote-card__estado {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }
  .quote-card__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px var(--green-pale);
  }
  .quote-card__estado--no .quote-card__dot {
    background: var(--text-mid);
    box-shadow: none;
  }
  .quote-card__ref {
    margin: 0;
    color: var(--text-mid);
  }
  .quote-card__precio {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 800;
    line-height: 1.25;
    color: var(--t900, #0f4c5c);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .quote-card__desc {
    margin: 0;
    color: var(--text-mid);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .quote-card__qty {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .quote-card__qty-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-mid);
  }
  .quote-stepper {
    display: inline-flex;
    align-items: stretch;
    align-self: flex-start;
    border: 1.5px solid var(--border-mid);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .quote-stepper__btn {
    width: 48px;
    min-height: 48px;
    border: none;
    background: var(--off);
    color: var(--ink);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .quote-stepper__btn:hover:not(:disabled) {
    background: var(--t50);
  }
  .quote-stepper__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .quote-stepper__input {
    width: 4rem;
    border: none;
    border-inline: 1px solid var(--border-mid);
    background: var(--white);
    color: var(--ink);
    text-align: center;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 600;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .quote-stepper__input::-webkit-outer-spin-button,
  .quote-stepper__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .quote-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 48px;
    padding: 0.8rem 1.2rem;
    border-radius: 14px;
    border: 2px solid transparent;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 150ms var(--ease),
      filter 180ms var(--ease),
      background 180ms var(--ease);
  }
  .quote-btn--primary {
    background: #7ed957;
    color: #0f4c5c;
    border-color: #7ed957;
  }
  .quote-btn--primary:hover:not(:disabled) {
    filter: brightness(0.97);
  }
  .quote-btn--secondary {
    background: #0f4c5c;
    color: #fff;
    border-color: #0f4c5c;
  }
  .quote-btn--secondary:hover:not(:disabled) {
    filter: brightness(1.06);
  }
  .quote-btn:active:not(:disabled) {
    transform: translateY(1px);
  }
  .quote-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .quote-btn:focus-visible,
  .quote-stepper__btn:focus-visible,
  .quote-stepper__input:focus-visible,
  .quote-card__link:focus-visible {
    outline: 3px solid var(--t800);
    outline-offset: 2px;
  }
  .quote-btn--compact {
    width: auto;
    min-height: 48px;
    flex-shrink: 0;
  }
  .quote-card__aviso {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem 0.75rem;
    margin: 0;
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
    background: var(--green-pale);
    border: 1px solid var(--border);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .quote-card__aviso[hidden] {
    display: none;
  }
  .quote-card__link {
    padding: 0;
    border: none;
    background: none;
    color: var(--t800);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .quote-card__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
    padding: 0.85rem 0 0;
    list-style: none;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-mid);
  }
  .quote-card__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .quote-card__soporte {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  .cta-sticky--quote {
    z-index: 190;
    padding-block-end: calc(0.75rem + env(safe-area-inset-bottom, 0px));
  }
  .cta-sticky__precio {
    margin: 0;
    text-align: start;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .quote-btn {
      transition: none;
    }
  }

  /* CTA sticky */
  .cta-sticky {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--white);
    border-top: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    z-index: 40;
    padding-block: 0.75rem;
  }
  .cta-sticky[hidden] {
    display: none;
  }
  .cta-sticky__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cta-sticky__nombre {
    margin: 0;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .producto-contexto {
    max-width: 76ch;
    color: var(--text-mid);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .producto-contexto p {
    margin: 0 0 1rem;
  }
  .producto-contexto p:last-child {
    margin-bottom: 0;
  }
  .producto-faq {
    display: grid;
    gap: 0.75rem;
    max-width: 900px;
  }
  .producto-faq details {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    padding: 0.9rem 1rem;
  }
  .producto-faq summary {
    cursor: pointer;
    color: var(--ink);
    font-weight: 700;
  }
  .producto-faq p {
    margin: 0.75rem 0 0;
    color: var(--text-mid);
    line-height: 1.65;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (max-width: 700px) {
    .hero-producto__stats {
      justify-content: center;
    }
    .hero-producto__content {
      text-align: center;
      align-items: center;
    }
    .hero-producto__cta-group {
      justify-content: center;
    }
  }
</style>

<style is:global>
  @media (max-width: 767px) {
    body:has([data-quote-pdp]) .mobile-commercial-bar,
    body:has([data-purchase-mode='commerce']) .mobile-commercial-bar {
      display: none;
    }
  }
</style>

<script>
  import { toggleComparador, getComparador } from '../lib/comparador';
  import { resetTransientUiState } from '../lib/motion';

  // Estado inicial del checkbox de comparación
  const compareToggle = document.getElementById('comparador-toggle') as HTMLInputElement | null;
  if (compareToggle) {
    const slug = compareToggle.dataset['compareSlug'] ?? '';
    compareToggle.checked = getComparador().includes(slug);
    compareToggle.addEventListener('change', () => {
      const result = toggleComparador(slug);
      compareToggle.checked = result.slugs.includes(slug);
    });
  }

  // CTA sticky tras pasar el CTA principal. Se oculta también mientras el
  // footer está a la vista: fijo abajo tapaba los enlaces legales del final,
  // incluido "Personalizar" cookies (retiro del consentimiento, ADR-0012).
  const ctaPrincipal = document.getElementById('cta-principal');
  const ctaSticky = document.getElementById('cta-sticky');
  if (ctaPrincipal && ctaSticky) {
    let principalVisible = true;
    let footerVisible = false;
    const sync = () => {
      ctaSticky.hidden = principalVisible || footerVisible;
    };
    new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        principalVisible = entry.isIntersecting;
        sync();
      },
      { rootMargin: '-80px 0px 0px 0px' }
    ).observe(ctaPrincipal);
    const footer = document.querySelector('footer[role="contentinfo"]');
    if (footer) {
      new IntersectionObserver(([entry]) => {
        if (!entry) return;
        footerVisible = entry.isIntersecting;
        sync();
      }).observe(footer);
    }
  }

  // Lightbox: abrir desde imagen principal. Thumbs solo cambian preview.
  const lightbox = document.getElementById('galeria-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxContador = document.getElementById('lightbox-contador');
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-galeria-index]'));
  const mainImg = document.getElementById('producto-imagen-principal') as HTMLImageElement | null;

  if (lightbox && lightboxImg && thumbs.length > 0) {
    let indiceActual = 0;

    const actualizar = () => {
      const thumb = thumbs[indiceActual];
      const img = thumb?.querySelector('img');
      if (img) {
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = mainImg?.alt || img.alt || '';
      }
      if (lightboxContador) {
        lightboxContador.textContent = `${indiceActual + 1} / ${thumbs.length}`;
      }
      thumbs.forEach((thumbBtn, i) => {
        if (i === indiceActual) thumbBtn.setAttribute('aria-current', 'true');
        else thumbBtn.removeAttribute('aria-current');
      });
    };

    const openLightbox = (index = 0) => {
      indiceActual = index;
      actualizar();
      resetTransientUiState();
      lightbox.showModal();
    };

    mainImg?.addEventListener('click', () => {
      const current = thumbs.findIndex(t => t.getAttribute('aria-current') === 'true');
      openLightbox(current >= 0 ? current : 0);
    });
    if (mainImg) mainImg.style.cursor = 'zoom-in';

    document
      .querySelector('[data-lightbox-close]')
      ?.addEventListener('click', () => lightbox.close());
    document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => {
      indiceActual = (indiceActual - 1 + thumbs.length) % thumbs.length;
      actualizar();
    });
    document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => {
      indiceActual = (indiceActual + 1) % thumbs.length;
      actualizar();
    });
    lightbox.addEventListener('click', event => {
      if (event.target === lightbox) lightbox.close();
    });
  }

  // Añadir a carrito / comprar ahora (cantidad + checkout)
  const addCarritoBtn = document.querySelector<HTMLButtonElement>(
    '#cta-principal [data-add-carrito]'
  );
  const checkoutPath = document.documentElement.lang.startsWith('en')
    ? '/en/checkout/'
    : '/es/checkout/';

  const confirmarAdd = (btn: HTMLButtonElement) => {
    const original = btn.dataset['labelAgregar'] ?? btn.textContent ?? '';
    const agregado = btn.dataset['labelAgregado'] ?? original;
    btn.textContent = agregado;
    window.setTimeout(() => {
      btn.textContent = original;
    }, 1800);
  };

  let quantity = 1;
  const quantityOutput = document.querySelector<HTMLOutputElement>('[data-pdp-quantity]');
  const stockLimitRaw = Number(addCarritoBtn?.dataset['stock'] ?? '');
  const stockLimit = Number.isFinite(stockLimitRaw) && stockLimitRaw > 0 ? stockLimitRaw : 99;
  const renderQuantity = () => {
    if (quantityOutput) quantityOutput.value = String(quantity);
  };
  document.querySelector('[data-pdp-quantity-decrease]')?.addEventListener('click', () => {
    quantity = Math.max(1, quantity - 1);
    renderQuantity();
  });
  document.querySelector('[data-pdp-quantity-increase]')?.addEventListener('click', () => {
    quantity = Math.min(stockLimit, quantity + 1);
    renderQuantity();
  });

  const addToCart = (goCheckout = false) => {
    if (!addCarritoBtn) return;
    const slug = addCarritoBtn.dataset['addCarrito'];
    const nombre = addCarritoBtn.dataset['nombre'];
    const precio = Number(addCarritoBtn.dataset['precio']);
    const moneda = addCarritoBtn.dataset['moneda'] ?? 'COP';
    const stockRaw = addCarritoBtn.dataset['stock'];
    const stock = stockRaw ? Number(stockRaw) : null;
    if (!slug || !nombre || Number.isNaN(precio)) return;
    void import('../lib/carrito').then(({ agregarAlCarrito }) => {
      agregarAlCarrito({ slug, nombre, precio, moneda, stock }, quantity);
      confirmarAdd(addCarritoBtn);
      if (goCheckout) window.location.href = checkoutPath;
    });
  };

  addCarritoBtn?.addEventListener('click', () => addToCart(false));
  document.querySelector('[data-buy-now]')?.addEventListener('click', () => addToCart(true));
  document.querySelector('[data-sticky-add-carrito]')?.addEventListener('click', event => {
    event.preventDefault();
    addToCart(false);
  });

  // Thumbs: actualizar imagen principal + estado activo (sin abrir lightbox)
  document.querySelectorAll<HTMLButtonElement>('[data-pdp-thumb]').forEach((btn, index) => {
    btn.addEventListener('click', () => {
      const thumbImg = btn.querySelector('img');
      if (mainImg && thumbImg) {
        mainImg.src = thumbImg.currentSrc || thumbImg.src;
      }
      document.querySelectorAll<HTMLButtonElement>('[data-pdp-thumb]').forEach((other, i) => {
        if (i === index) other.setAttribute('aria-current', 'true');
        else other.removeAttribute('aria-current');
      });
    });
  });

  // Tarjeta de cotización (productos sin precio)
  const quoteCard = document.querySelector<HTMLElement>('[data-quote-card]');
  if (quoteCard) {
    const qtyInput = quoteCard.querySelector<HTMLInputElement>('[data-quote-qty]');
    const stepBtns = quoteCard.querySelectorAll<HTMLButtonElement>('[data-qty-step]');
    const addBtn = quoteCard.querySelector<HTMLButtonElement>('[data-add-cotizacion]');
    const aviso = quoteCard.querySelector<HTMLElement>('[data-quote-aviso]');
    const MAX = 99;

    const leerCantidad = (): number => {
      const n = Math.floor(Number(qtyInput?.value));
      if (!Number.isFinite(n) || n < 1) return 1;
      return Math.min(n, MAX);
    };
    const pintarCantidad = () => {
      const n = leerCantidad();
      if (qtyInput) qtyInput.value = String(n);
      stepBtns.forEach(btn => {
        const paso = Number(btn.dataset['qtyStep']);
        btn.disabled = (paso < 0 && n <= 1) || (paso > 0 && n >= MAX);
      });
    };
    pintarCantidad();
    qtyInput?.addEventListener('change', pintarCantidad);
    stepBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (qtyInput) qtyInput.value = String(leerCantidad() + Number(btn.dataset['qtyStep']));
        pintarCantidad();
      });
    });

    addBtn?.addEventListener('click', () => {
      // La lista se actualiza en la delegación global (cotizacion-clicks.ts).
      if (aviso) aviso.hidden = false;
    });
    quoteCard.querySelector('[data-quote-ver]')?.addEventListener('click', () => {
      void import('../lib/cotizacion-equipos').then(({ abrirCotizacion }) => abrirCotizacion());
    });
    document.querySelector('[data-quote-sticky-add]')?.addEventListener('click', () => {
      addBtn?.click();
    });
  }

  // Tabs PDP
  const tabRoot = document.querySelector('[data-pdp-tabs]');
  if (tabRoot) {
    const tabs = Array.from(tabRoot.querySelectorAll<HTMLButtonElement>('[data-pdp-tab]'));
    const panels = Array.from(tabRoot.querySelectorAll<HTMLElement>('[data-pdp-panel]'));
    const activate = (id: string) => {
      tabs.forEach(tab => {
        const on = tab.dataset['pdpTab'] === id;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach(panel => {
        panel.hidden = panel.dataset['pdpPanel'] !== id;
      });
    };
    tabs.forEach(tab => {
      tab.addEventListener('click', () => activate(tab.dataset['pdpTab'] ?? ''));
    });
  }
</script>
