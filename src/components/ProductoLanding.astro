          </ul>
        )}
      </section>
    )
  }

  <!-- Preguntas de compra: criterios verificables, sin comparativas no sustentadas -->
  {
    producto.preguntas_frecuentes.length > 0 && (
      <section class="section container" aria-labelledby="faq-producto-heading">
