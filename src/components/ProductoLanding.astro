---
/**
 * ProductoLanding — PDP unificada (ES/EN).
 * Variantes commerce | quote vía getProductPurchaseMode. Sin hero turquesa.
 */
import { t, type Locale } from '../i18n/utils';
import ProductoCard from './ProductoCard.astro';
import Resenas from './Resenas.astro';
import PdfDownloadGate from './PdfDownloadGate.astro';
import type { Producto, Familia } from '../lib/datos';
import { formatMoneda } from '../lib/format';
import { getAccionComercial, getProductPurchaseMode } from '../lib/comercial';
import { isPurchasable } from '../lib/commerce-policy';
import { normalizarEspecificaciones } from '../lib/especificaciones';
import { getOptimizedImageUrl, isSupabaseStorageImage } from '../lib/image';
import { familyCatalogHref } from '../lib/seo-urls';

interface Props {
  producto: Producto;
  familia: Familia;
  relacionados: Producto[];
  locale: Locale;
}

const { producto, familia, relacionados, locale } = Astro.props;

const catalogoPath = locale === 'en' ? '/en/catalog/' : '/es/catalogo/';
const carritoPath = locale === 'en' ? '/en/cart/' : '/es/carrito/';

const especificaciones = normalizarEspecificaciones(producto.especificaciones);
const grupos = new Map<string, typeof especificaciones>();
for (const espec of especificaciones) {
  const grupo = espec.grupo ?? '';
  if (!grupos.has(grupo)) grupos.set(grupo, []);
  grupos.get(grupo)!.push(espec);
}

// Sellos de certificación/normativa: se derivan de especificaciones reales
// del propio producto (grupo "Normativa"), nunca de una lista inventada.
const _certificaciones = especificaciones.filter(item => /normativ/i.test(item.grupo ?? ''));

const galeria = producto.galeria.filter(url => url && url !== producto.imagen_principal);
const imagenes = [producto.imagen_principal ?? '/assets/img-placeholder.svg', ...galeria];
const imagenProducto = producto.imagen_principal ?? '/assets/img-placeholder.svg';
const heroImageAvif = getOptimizedImageUrl(imagenes[0], 960, 'avif', 80);
const heroImageWebp = getOptimizedImageUrl(imagenes[0], 960, 'webp', 80);
const heroImageTransformable = isSupabaseStorageImage(imagenes[0]);
const monogramIniciales = (() => {
  const parts = producto.nombre
    .replace(/[^\p{L}\p{N}\s]/gu, ' ')
    .split(/\s+/)
    .filter(Boolean);
  const letters = parts
    .slice(0, 2)
    .map(p => p[0]?.toUpperCase() ?? '')
    .join('');
  return letters || 'IME';
})();
const imagenFallback =
  'data:image/svg+xml;charset=UTF-8,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" role="img" aria-label="${producto.nombre}">
      <defs>
        <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#F0F6F8"/>
          <stop offset="100%" stop-color="#E6EFF3"/>
        </linearGradient>
      </defs>
      <rect width="640" height="640" fill="url(#g)"/>
      <circle cx="320" cy="300" r="92" fill="#FFFFFF" stroke="rgba(15,76,92,0.12)" stroke-width="2"/>
      <text x="320" y="318" text-anchor="middle" font-family="Sora,Inter,system-ui,sans-serif" font-size="56" font-weight="800" fill="#0F4C5C">${monogramIniciales}</text>
      <text x="320" y="430" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="18" font-weight="600" fill="#456070">I-ME</text>
    </svg>`
  );

const purchaseMode = getProductPurchaseMode(producto);
const esCotizacion = purchaseMode === 'quote';
const esCommerce = purchaseMode === 'commerce';
const tienePrecio = esCommerce;
const precioFormateado = tienePrecio
  ? formatMoneda(producto.precio, producto.moneda, locale)
  : null;
const noDisponible = producto.disponible === false;
const accionComercial = getAccionComercial(producto, locale);
const isPurchasableProduct = isPurchasable(producto).ok;
const modalidadTexto =
  producto.tipo_comercial === 'consumible'
    ? locale === 'en'
      ? 'Consumable'
      : 'Consumible'
    : locale === 'en'
      ? 'Equipment'
      : 'Equipo';
const disponibilidadTexto = noDisponible
  ? t(locale, 'producto.ficha_no_disponible')
  : producto.stock != null && producto.stock > 0
    ? t(locale, 'carrito.stock_limitado').replace('{stock}', String(producto.stock))
    : producto.stock === 0
      ? t(locale, 'producto.ficha_no_disponible')
      : t(locale, 'producto.ficha_disponible');
const productSegment = locale === 'en' ? 'products' : 'productos';
const productUrl = `https://i-me.com.co/${locale}/${productSegment}/${producto.slug}/`;
const modelo = especificaciones.find(item => item.clave.toLowerCase() === 'modelo')?.valor;
const referencia = modelo?.trim() || producto.sku?.trim() || null;
const disponibleParaMostrar = !noDisponible && producto.stock !== 0;
const stockMax =
  typeof producto.stock === 'number' && Number.isFinite(producto.stock) && producto.stock > 0
    ? Math.min(producto.stock, 99)
    : 99;
const fichaUrl = producto.ficha_pdf
  ? producto.ficha_pdf.startsWith('http')
    ? producto.ficha_pdf
    : `https://i-me.com.co${producto.ficha_pdf}`
  : null;
const whatsappMensaje =
  locale === 'en'
    ? [
        `Hello, I would like to receive information and a quote for:`,
        `Product: ${producto.nombre}`,
        modelo ? `Model: ${modelo}` : '',
        producto.marca ? `Brand: ${producto.marca}` : '',
        `Product page: ${productUrl}`,
        fichaUrl ? `Datasheet: ${fichaUrl}` : '',
        '',
        'My name is: ____________________',
        'Institution: ____________________',
        'City/Country: ____________________',
      ]
        .filter(Boolean)
        .join('\n')
    : [
        'Hola, me gustaría recibir información y cotización de:',
        `Producto: ${producto.nombre}`,
        modelo ? `Referencia: ${modelo}` : '',
        producto.marca ? `Marca: ${producto.marca}` : '',
        `Página del producto: ${productUrl}`,
        fichaUrl ? `Ficha técnica: ${fichaUrl}` : '',
        '',
        'Mi nombre es: ____________________',
        'Institución: ____________________',
        'Ciudad/país: ____________________',
      ]
        .filter(Boolean)
        .join('\n');
const whatsappHref = `https://wa.me/573137247353?text=${encodeURIComponent(whatsappMensaje)}`;

const migas = [
  { nombre: t(locale, 'catalogo.migas_inicio'), href: `/${locale}/` },
  { nombre: t(locale, 'catalogo.migas_catalogo'), href: catalogoPath },
  { nombre: familia.nombre, href: familyCatalogHref(locale, familia.slug) },
];

const pdfGateId = `pdf-gate-${producto.slug.replace(/[^a-z0-9_-]/gi, '-')}`;
---

<article
  class="producto-landing"
  data-product-context
  data-product-name={producto.nombre}
  data-product-model={modelo ?? ''}
  data-product-brand={producto.marca ?? ''}
  data-product-url={productUrl}
  data-product-datasheet={fichaUrl ?? ''}
  data-family-slug={familia.slug}
  data-product-slug={producto.slug}
  data-product-summary={producto.descripcion_corta}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb container" aria-label={t(locale, 'catalogo.migas_inicio')}>
    <ol>
      {
        migas.map(miga => (
          <li>
            <a href={miga.href}>{miga.nombre}</a>
            <span aria-hidden="true">/</span>
          </li>
        ))
      }
      <li aria-current="page">{producto.nombre}</li>
    </ol>
  </nav>

  <!-- PDP top: commerce | quote (sin hero turquesa) -->
  <section
    class:list={['pdp-top', { 'pdp-top--commerce': esCommerce, 'pdp-top--quote': esCotizacion }]}
    data-purchase-mode={purchaseMode}
    data-quote-pdp={esCotizacion ? '' : undefined}
  >
    <div
      class:list={[
        'container',
        'pdp-top__grid',
        { 'pdp-top__grid--commerce': esCommerce, 'pdp-top__grid--quote': esCotizacion },
      ]}
    >
      <!-- Galería -->
      <div class="pdp-gallery">
        <div class="pdp-gallery__main">
          {
            heroImageTransformable ? (
              <picture>
                <source srcset={heroImageAvif} type="image/avif" />
                <source srcset={heroImageWebp} type="image/webp" />
                <img
                  src={imagenes[0]}
                  alt={producto.nombre}
                  width="640"
                  height="480"
                  decoding="async"
                  fetchpriority="high"
                  sizes="(max-width: 768px) 100vw, 50vw"
                  class="pdp-gallery__img"
                  id="producto-imagen-principal"
                  onerror={`this.onerror=null;this.src='${imagenFallback}'`}
                />
              </picture>
            ) : (
              <img
                src={imagenes[0]}
                alt={producto.nombre}
                width="640"
                height="480"
                decoding="async"
                fetchpriority="high"
                sizes="(max-width: 768px) 100vw, 50vw"
                class="pdp-gallery__img"
                id="producto-imagen-principal"
                onerror={`this.onerror=null;this.src='${imagenFallback}'`}
              />
            )
          }
          {
            (producto.destacado || producto.nuevo || noDisponible) && (
              <div class="pdp-gallery__badges" aria-hidden="true">
                {producto.nuevo && (
                  <span class="badge badge-green">{t(locale, 'producto.badge_nuevo')}</span>
                )}
                {producto.destacado && (
                  <span class="badge badge-teal">{t(locale, 'producto.badge_destacado')}</span>
                )}
                {noDisponible && (
                  <span class="badge badge-gris">{t(locale, 'producto.badge_no_disponible')}</span>
                )}
              </div>
            )
          }
        </div>
        {
          imagenes.length > 1 && (
            <ul class="pdp-gallery__thumbs" role="list">
              {imagenes.map((src, index) => (
                <li>
                  <button
                    type="button"
                    class="pdp-gallery__thumb"
                    data-galeria-index={index}
                    data-pdp-thumb
                    aria-current={index === 0 ? 'true' : undefined}
                    aria-label={`${t(locale, 'producto.galeria_abrir')}: ${producto.nombre} ${index + 1}/${imagenes.length}`}
                  >
                    <img
                      src={getOptimizedImageUrl(src, 160, 'webp')}
                      alt=""
                      width="72"
                      height="72"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
        {
          producto.beneficios.length > 0 && (
            <ul class="pdp-highlights" role="list">
              {producto.beneficios.slice(0, 4).map(beneficio => (
                <li>
                  <span aria-hidden="true">✓</span>
                  <span>{beneficio}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <!-- Columna identidad + compra/cotización -->
      <div
        class:list={[
          'pdp-buy',
          { 'pdp-buy--commerce': esCommerce, 'pdp-buy--quote': esCotizacion },
        ]}
      >
        <!-- Identidad -->
        <div class="pdp-identity">
          <div class="pdp-identity__meta">
            <span class="pdp-identity__category">{familia.nombre}</span>
            {referencia && <span class="pdp-identity__sku">SKU {referencia}</span>}
          </div>
          <h1>{producto.nombre}</h1>
          {
            producto.descripcion_corta && (
              <p class="pdp-identity__desc">{producto.descripcion_corta}</p>
            )
          }
          <ul class="pdp-identity__trust" role="list">
            <li>
              <span
                class:list={[
                  'pdp-identity__trust-dot',
                  { 'pdp-identity__trust-dot--no': !disponibleParaMostrar },
                ]}
                aria-hidden="true"></span>
              <span>{disponibilidadTexto}</span>
            </li>
            {
              producto.marca && (
                <li>
                  <span class="pdp-identity__trust-mark" aria-hidden="true" />
                  <span>
                    {locale === 'en' ? 'Brand' : 'Marca'} {producto.marca}
                  </span>
                </li>
              )
            }
            <li>
              <span class="pdp-identity__trust-mark" aria-hidden="true"></span>
              <span>{modalidadTexto}</span>
            </li>
          </ul>
          <label class="producto-landing__compare">
            <input type="checkbox" id="comparador-toggle" data-compare-slug={producto.slug} />
            <span>{t(locale, 'catalogo.comparar_anadir')}</span>
          </label>
        </div>

        <!-- Panel commerce -->
        {
          esCommerce && (
            <section
              class="product-purchase-panel"
              id="cta-principal"
              aria-label={t(locale, 'producto.commerce_precio_label')}
              data-commerce-panel
              data-price-mode="commerce"
              data-stock-max={stockMax}
            >
              <div class="product-purchase-panel__price-row">
                <div>
                  <p class="product-purchase-panel__price-label">
                    {t(locale, 'producto.commerce_precio_label')}
                  </p>
                  <p class="product-purchase-panel__price">
                    {precioFormateado}
                    <small>{producto.moneda ?? 'COP'}</small>
                  </p>
                </div>
                <p
                  class:list={[
                    'product-purchase-panel__availability',
                    { 'product-purchase-panel__availability--no': !disponibleParaMostrar },
                  ]}
                >
                  <span class="product-purchase-panel__dot" aria-hidden="true" />
                  {disponibilidadTexto}
                </p>
              </div>
              <p class="product-purchase-panel__price-notice">
                {t(locale, 'producto.iva_incluido')} · {t(locale, 'producto.envio_no_incluido')}
              </p>

              {isPurchasableProduct ? (
                <>
                  <div class="product-purchase-panel__quantity">
                    <span class="product-purchase-panel__qty-label" id="commerce-qty-label">
                      {t(locale, 'producto.commerce_cantidad')}
                    </span>
                    <div class="commerce-stepper" role="group" aria-labelledby="commerce-qty-label">
                      <button
                        type="button"
                        data-pdp-quantity-decrease
                        aria-label={t(locale, 'producto.commerce_cantidad_disminuir')}
                      >
                        −
                      </button>
                      <output data-pdp-quantity>1</output>
                      <button
                        type="button"
                        data-pdp-quantity-increase
                        aria-label={t(locale, 'producto.commerce_cantidad_aumentar')}
                      >
                        +
                      </button>
                    </div>
                  </div>
                  <button
                    type="button"
                    class="btn-pdp btn-pdp--primary"
                    aria-live="polite"
                    data-add-carrito={producto.slug}
                    data-nombre={producto.nombre}
                    data-precio={producto.precio}
                    data-moneda={producto.moneda ?? 'COP'}
                    data-stock={producto.stock ?? ''}
                    data-label-agregar={t(locale, 'producto.commerce_anadir_cesta')}
                    data-label-agregado={t(locale, 'carrito.agregado')}
                  >
                    {t(locale, 'producto.commerce_anadir_cesta')}
                  </button>
                  <button type="button" class="btn-pdp btn-pdp--secondary" data-buy-now>
                    {t(locale, 'producto.commerce_comprar_ahora')}
                  </button>
                  <p class="product-purchase-panel__payments">
                    {t(locale, 'producto.commerce_pago_wompi')}
                  </p>
                </>
              ) : (
                <a
                  href={whatsappHref}
                  class="btn-pdp btn-pdp--primary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {accionComercial.label}
                </a>
              )}

              <ul class="product-purchase-panel__trust" role="list">
                <li>{t(locale, 'producto.commerce_trust_segura')}</li>
                <li>{t(locale, 'producto.commerce_trust_factura')}</li>
              </ul>

              {producto.ficha_pdf && (
                <button
                  type="button"
                  class="product-purchase-panel__link"
                  data-pdf-download-trigger
                  data-pdf-download-target={pdfGateId}
                >
                  {t(locale, 'producto.ficha_pdf')}
                </button>
              )}
            </section>
          )
        }

        <!-- Panel quote (existente, columna comercial) -->
        {
          esCotizacion && (
            <section
              class="quote-card"
              id="cta-principal"
              aria-label={t(locale, 'producto.quote_precio_titulo')}
              data-quote-card
              data-price-mode="quote"
              data-product-slug={producto.slug}
              data-product-name={producto.nombre}
              data-product-category={familia.nombre}
            >
              <div class="quote-card__meta">
                <p
                  class:list={[
                    'quote-card__estado',
                    { 'quote-card__estado--no': !disponibleParaMostrar },
                  ]}
                >
                  <span class="quote-card__dot" aria-hidden="true" />
                  {disponibilidadTexto}
                </p>
                {referencia && (
                  <p class="quote-card__ref">
                    {t(locale, 'producto.quote_referencia').replace('{ref}', referencia)}
                  </p>
                )}
              </div>

              <p class="quote-card__precio">{t(locale, 'producto.quote_precio_titulo')}</p>
              <p class="quote-card__desc">{t(locale, 'producto.quote_precio_desc')}</p>

              <div class="quote-card__qty">
                <label for="quote-qty-input" class="quote-card__qty-label">
                  {t(locale, 'producto.quote_cantidad')}
                </label>
                <div class="quote-stepper">
                  <button
                    type="button"
                    class="quote-stepper__btn"
                    data-qty-step="-1"
                    aria-label={t(locale, 'producto.quote_cantidad_disminuir')}
                  >
                    <span aria-hidden="true">−</span>
                  </button>
                  <input
                    id="quote-qty-input"
                    class="quote-stepper__input"
                    type="number"
                    inputmode="numeric"
                    min="1"
                    max="99"
                    step="1"
                    value="1"
                    data-quote-qty
                  />
                  <button
                    type="button"
                    class="quote-stepper__btn"
                    data-qty-step="1"
                    aria-label={t(locale, 'producto.quote_cantidad_aumentar')}
                  >
                    <span aria-hidden="true">+</span>
                  </button>
                </div>
              </div>

              <button
                type="button"
                class="quote-btn quote-btn--primary"
                data-add-cotizacion={producto.slug}
                data-nombre={producto.nombre}
                data-imagen={imagenProducto}
                data-url={productUrl}
                data-modelo={modelo ?? ''}
                data-marca={producto.marca ?? ''}
                data-cantidad-desde="#quote-qty-input"
                data-no-abrir
              >
                {t(locale, 'producto.quote_agregar')}
              </button>
              <button
                type="button"
                class="quote-btn quote-btn--secondary"
                data-ensure-cotizacion={producto.slug}
                data-nombre={producto.nombre}
                data-imagen={imagenProducto}
                data-url={productUrl}
                data-modelo={modelo ?? ''}
                data-marca={producto.marca ?? ''}
                data-cantidad-desde="#quote-qty-input"
              >
                {t(locale, 'producto.quote_solicitar_ahora')}
              </button>

              <p class="quote-card__aviso" role="status" aria-live="polite" data-quote-aviso hidden>
                <span data-quote-aviso-texto>{t(locale, 'producto.quote_agregado_aviso')}</span>
                <button type="button" class="quote-card__link" data-quote-ver>
                  {t(locale, 'producto.quote_ver')}
                </button>
              </p>

              <ul class="quote-card__trust" role="list">
                <li>{t(locale, 'producto.quote_trust_factura')}</li>
                <li>{t(locale, 'producto.quote_trust_datos')}</li>
              </ul>

              <div class="quote-card__soporte">
                <a
                  href={whatsappHref}
                  class="quote-card__link"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-quote-asesor
                >
                  {t(locale, 'producto.quote_ayuda')}
                </a>
                {producto.ficha_pdf && (
                  <button
                    type="button"
                    class="quote-card__link"
                    data-pdf-download-trigger
                    data-pdf-download-target={pdfGateId}
                  >
                    {t(locale, 'producto.ficha_pdf')}
                  </button>
                )}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </section>

  <!-- Contenido tabulado + asistencia -->
  <section class="pdp-lower container" data-pdp-tabs>
    <div class="pdp-lower__main">
      <div
        class="pdp-tabs"
        role="tablist"
        aria-label={locale === 'en' ? 'Product information' : 'Información del producto'}
      >
        {
          producto.descripcion_larga && (
            <button
              type="button"
              class="pdp-tabs__tab"
              role="tab"
              id="tab-desc"
              aria-controls="panel-desc"
              aria-selected="true"
              data-pdp-tab="desc"
            >
              {locale === 'en' ? 'Description' : 'Descripción'}
            </button>
          )
        }
        <button
          type="button"
          class="pdp-tabs__tab"
          role="tab"
          id="tab-specs"
          aria-controls="panel-specs"
          aria-selected={!producto.descripcion_larga}
          data-pdp-tab="specs"
        >
          {t(locale, 'producto.specs_titulo')}
        </button>
        {
          producto.ficha_pdf && (
            <button
              type="button"
              class="pdp-tabs__tab"
              role="tab"
              id="tab-docs"
              aria-controls="panel-docs"
              aria-selected="false"
              data-pdp-tab="docs"
            >
              {locale === 'en' ? 'Documentation' : 'Documentación'}
            </button>
          )
        }
        {
          esCotizacion && producto.aplicaciones.length > 0 ? (
            <button
              type="button"
              class="pdp-tabs__tab"
              role="tab"
              id="tab-apps"
              aria-controls="panel-apps"
              aria-selected="false"
              data-pdp-tab="apps"
            >
              {t(locale, 'producto.aplicaciones_titulo')}
            </button>
          ) : producto.preguntas_frecuentes.length > 0 ? (
            <button
              type="button"
              class="pdp-tabs__tab"
              role="tab"
              id="tab-faq"
              aria-controls="panel-faq"
              aria-selected="false"
              data-pdp-tab="faq"
            >
              {locale === 'en' ? 'FAQ' : 'Preguntas frecuentes'}
            </button>
          ) : null
        }
      </div>

      {
        producto.descripcion_larga && (
          <div
            class="pdp-tabs__panel"
            role="tabpanel"
            id="panel-desc"
            aria-labelledby="tab-desc"
            data-pdp-panel="desc"
          >
            <h2 class="sr-only">
              {locale === 'en' ? 'Product description' : 'Descripción del producto'}
            </h2>
            <div class="producto-contexto">
              {producto.descripcion_larga.split('\n\n').map(parrafo => (
                <p>{parrafo}</p>
              ))}
            </div>
            {producto.beneficios.length > 0 && (
              <ul class="pdp-desc-highlights" role="list">
                {producto.beneficios.map(beneficio => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    <span>{beneficio}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }

      <div
        class="pdp-tabs__panel"
        role="tabpanel"
        id="panel-specs"
        aria-labelledby="tab-specs"
        data-pdp-panel="specs"
        hidden={producto.descripcion_larga ? true : undefined}
      >
        <h2 class="sr-only">{t(locale, 'producto.specs_titulo')}</h2>
        {
          especificaciones.length > 0 ? (
            [...grupos.entries()].map(([grupo, items]) => (
              <div class="specs-grupo">
                {grupo && <h3 class="specs-grupo__titulo">{grupo}</h3>}
                <table class="specs-table">
                  <thead>
                    <tr>
                      <th scope="col">{t(locale, 'producto.specs_columna_parametro')}</th>
                      <th scope="col">{t(locale, 'producto.specs_columna_detalle')}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {items.map(item => (
                      <tr>
                        <th scope="row">{item.clave}</th>
                        <td>{item.valor}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))
          ) : (
            <p class="specs-pendiente">{t(locale, 'producto.specs_pendiente')}</p>
          )
        }
      </div>

      {
        producto.ficha_pdf && (
          <div
            class="pdp-tabs__panel"
            role="tabpanel"
            id="panel-docs"
            aria-labelledby="tab-docs"
            data-pdp-panel="docs"
            hidden
          >
            <h2 class="sr-only">{locale === 'en' ? 'Documentation' : 'Documentación'}</h2>
            <button
              type="button"
              class="btn-pdp btn-pdp--secondary"
              style="width:auto;min-width:240px"
              data-pdf-download-trigger
              data-pdf-download-target={pdfGateId}
            >
              {t(locale, 'producto.ficha_pdf')}
            </button>
          </div>
        )
      }

      {
        esCotizacion && producto.aplicaciones.length > 0 ? (
          <div
            class="pdp-tabs__panel"
            role="tabpanel"
            id="panel-apps"
            aria-labelledby="tab-apps"
            data-pdp-panel="apps"
            hidden
          >
            <h2 class="sr-only">{t(locale, 'producto.aplicaciones_titulo')}</h2>
            <ul class="aplicaciones__grid" role="list">
              {producto.aplicaciones.map(item => (
                <li class="aplicaciones__item">
                  <span class="aplicaciones__icono" aria-hidden="true">
                    ✓
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ) : producto.preguntas_frecuentes.length > 0 ? (
          <div
            class="pdp-tabs__panel"
            role="tabpanel"
            id="panel-faq"
            aria-labelledby="tab-faq"
            data-pdp-panel="faq"
            hidden
          >
            <h2 class="sr-only">{locale === 'en' ? 'FAQ' : 'Preguntas frecuentes'}</h2>
            <div class="producto-faq">
              {producto.preguntas_frecuentes.map(item => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ) : null
      }

      {
        producto.valor && (
          <div class="valor-card" style="margin-top:1.5rem">
            <p class="valor-card__texto">{producto.valor}</p>
          </div>
        )
      }
    </div>

    <aside class="pdp-lower__aside" aria-label={locale === 'en' ? 'Assistance' : 'Asistencia'}>
      <div class="pdp-assist-card">
        <h2>{locale === 'en' ? 'Need advice?' : '¿Necesitas asesoría?'}</h2>
        <p>
          {
            locale === 'en'
              ? 'Talk with our team about this product.'
              : 'Habla con nuestro equipo sobre este producto.'
          }
        </p>
        <a
          href={whatsappHref}
          class="btn-pdp btn-pdp--ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          {locale === 'en' ? 'Chat on WhatsApp' : 'Hablar por WhatsApp'}
        </a>
      </div>
      {
        esCotizacion && (
          <div class="pdp-assist-card pdp-assist-card--muted">
            <h2>{locale === 'en' ? 'Institutional quote?' : '¿Cotización para tu institución?'}</h2>
            <p>
              {locale === 'en'
                ? 'Request a project quote with multiple items.'
                : 'Solicita una cotización de proyecto con varios ítems.'}
            </p>
            <a
              href={locale === 'en' ? '/en/contact/' : '/es/contacto/'}
              class="btn-pdp btn-pdp--ghost"
            >
              {locale === 'en' ? 'Quote project' : 'Cotizar proyecto'}
            </a>
          </div>
        )
      }
    </aside>
  </section>

  {
    galeria.length > 0 && (
      <dialog id="galeria-lightbox" aria-label={t(locale, 'producto.galeria_titulo')}>
        <div class="lightbox__header">
          <p class="lightbox__contador" aria-live="polite" id="lightbox-contador" />
          <button type="button" class="lightbox__cerrar" data-lightbox-close>
            <span aria-hidden="true">×</span>
            <span class="sr-only">{t(locale, 'producto.galeria_cerrar')}</span>
          </button>
        </div>
        <img id="lightbox-img" src={imagenes[0]} alt="" decoding="async" />
        <div class="lightbox__nav">
          <button type="button" data-lightbox-prev class="btn btn-secondary">
            {t(locale, 'producto.galeria_anterior')}
          </button>
          <button type="button" data-lightbox-next class="btn btn-secondary">
            {t(locale, 'producto.galeria_siguiente')}
          </button>
        </div>
      </dialog>
    )
  }

  <!-- Relacionados -->
  {
    relacionados.length > 0 && (
      <section class="section container" aria-labelledby="relacionados-heading">
        <div class="section-header">
          <h2 id="relacionados-heading" class="section-title">
            {t(locale, 'producto.relacionados_titulo')}
          </h2>
          <a href={familyCatalogHref(locale, familia.slug)} class="ver-familia-link">
            {t(locale, 'producto.ver_familia')} →
          </a>
        </div>
        <ul class="relacionados__grid" role="list">
          {relacionados.map(rel => (
            <ProductoCard
              producto={{
                slug: rel.slug,
                nombre: rel.nombre,
                descripcion_corta: rel.descripcion_corta,
                imagen_principal: rel.imagen_principal,
                destacado: rel.destacado,
                nuevo: rel.nuevo,
                familia: { slug: familia.slug, nombre: familia.nombre },
                tipo_comercial: rel.tipo_comercial,
                fulfillment_mode: rel.fulfillment_mode,
                precio: rel.precio,
                moneda: rel.moneda,
                stock: rel.stock,
                disponible: rel.disponible,
              }}
              locale={locale}
            />
          ))}
        </ul>
      </section>
    )
  }

  <Resenas productoId={producto.id} productoSlug={producto.slug} locale={locale} />

  <!-- CTA final -->
  <section class="cta-final">
    <div class="cta-final__bg" aria-hidden="true"></div>
    <div class="container cta-final__inner">
      <h2>{t(locale, 'producto.contacto_titulo')}</h2>
      <p>{t(locale, 'producto.contacto_desc')}</p>
      <div class="cta-final__acciones">
        {
          accionComercial.tipo === 'carrito' ? (
            <a href={carritoPath} class="btn-hero-primary">
              {t(locale, 'carrito.ir_pagar')}
            </a>
          ) : esCotizacion ? (
            <button
              type="button"
              class="btn-hero-primary"
              data-ensure-cotizacion={producto.slug}
              data-nombre={producto.nombre}
              data-imagen={imagenProducto}
              data-url={productUrl}
              data-modelo={modelo ?? ''}
              data-marca={producto.marca ?? ''}
              data-cantidad-desde="#quote-qty-input"
            >
              {t(locale, 'producto.quote_solicitar_ahora')}
            </button>
          ) : (
            <button
              type="button"
              class="btn-hero-primary"
              data-ensure-cotizacion={producto.slug}
              data-nombre={producto.nombre}
              data-imagen={imagenProducto}
              data-url={productUrl}
              data-modelo={modelo ?? ''}
              data-marca={producto.marca ?? ''}
            >
              {t(locale, 'producto.cotizar_cta')}
            </button>
          )
        }
        <a href={whatsappHref} class="btn-hero-secondary" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">↗</span> WhatsApp
        </a>
        <a href={catalogoPath} class="btn-hero-secondary">
          {t(locale, 'producto.volver_catalogo')}
        </a>
      </div>
    </div>
  </section>

  {
    fichaUrl && (
      <PdfDownloadGate
        locale={locale}
        productName={producto.nombre}
        productSlug={producto.slug}
        familySlug={familia.slug}
        pdfUrl={fichaUrl}
        modalId={pdfGateId}
      />
    )
  }

  <!-- CTA sticky -->
  {
    esCotizacion ? (
      <div class="cta-sticky cta-sticky--quote" id="cta-sticky" hidden>
        <div class="container cta-sticky__inner">
          <p class="cta-sticky__precio">{t(locale, 'producto.quote_precio_titulo')}</p>
          <button
            type="button"
            class="quote-btn quote-btn--secondary quote-btn--compact"
            data-ensure-cotizacion={producto.slug}
            data-nombre={producto.nombre}
            data-imagen={imagenProducto}
            data-url={productUrl}
            data-modelo={modelo ?? ''}
            data-marca={producto.marca ?? ''}
            data-cantidad-desde="#quote-qty-input"
          >
            {t(locale, 'producto.quote_solicitar_ahora')}
          </button>
        </div>
      </div>
    ) : (
      <div class="cta-sticky cta-sticky--commerce" id="cta-sticky" hidden>
        <div class="container cta-sticky__inner">
          <p class="cta-sticky__precio">{precioFormateado}</p>
          <button
            type="button"
            class="btn btn-primary"
            data-sticky-add-carrito
            data-label-agregar={t(locale, 'producto.commerce_anadir_cesta')}
            data-label-agregado={t(locale, 'carrito.agregado')}
          >
            {t(locale, 'producto.commerce_anadir_cesta')}
          </button>
        </div>
      </div>
    )
  }
</article>

<style>
