<style is:global>
  @media (max-width: 767px) {
    body:has([data-quote-pdp]) .mobile-commercial-bar,
    body:has([data-purchase-mode='commerce']) .mobile-commercial-bar {
      display: none;
    }
  }
</style>

<script>
  import { toggleComparador, getComparador } from '../lib/comparador';
  import { resetTransientUiState } from '../lib/motion';

  // Estado inicial del checkbox de comparación
  const compareToggle = document.getElementById('comparador-toggle') as HTMLInputElement | null;
  if (compareToggle) {
    const slug = compareToggle.dataset['compareSlug'] ?? '';
    compareToggle.checked = getComparador().includes(slug);
    compareToggle.addEventListener('change', () => {
      const result = toggleComparador(slug);
      compareToggle.checked = result.slugs.includes(slug);
    });
  }

  // CTA sticky tras pasar el CTA principal
  const ctaPrincipal = document.getElementById('cta-principal');
  const ctaSticky = document.getElementById('cta-sticky');
  if (ctaPrincipal && ctaSticky) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        ctaSticky.hidden = entry.isIntersecting;
      },
      { rootMargin: '-80px 0px 0px 0px' }
    );
    observer.observe(ctaPrincipal);
  }

  // Lightbox de galería
  const lightbox = document.getElementById('galeria-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxContador = document.getElementById('lightbox-contador');
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-galeria-index]'));

  if (lightbox && lightboxImg && thumbs.length > 0) {
    let indiceActual = 0;

    const actualizar = () => {
      const thumb = thumbs[indiceActual];
      const img = thumb?.querySelector('img');
      if (img) {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt || '';
      }
      if (lightboxContador) {
        lightboxContador.textContent = `${indiceActual + 1} / ${thumbs.length}`;
      }
    };

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => {
        indiceActual = index;
        actualizar();
        resetTransientUiState();
        lightbox.showModal();
      });
    });

    document
      .querySelector('[data-lightbox-close]')
      ?.addEventListener('click', () => lightbox.close());
    document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => {
      indiceActual = (indiceActual - 1 + thumbs.length) % thumbs.length;
      actualizar();
    });
    document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => {
      indiceActual = (indiceActual + 1) % thumbs.length;
      actualizar();
    });
    lightbox.addEventListener('click', event => {
      if (event.target === lightbox) lightbox.close();
    });
  }

  // Añadir a carrito / comprar ahora (cantidad + checkout)
  const addCarritoBtn = document.querySelector<HTMLButtonElement>(
    '#cta-principal [data-add-carrito]'
  );
  const checkoutPath = document.documentElement.lang.startsWith('en')
    ? '/en/checkout/'
    : '/es/checkout/';

  const confirmarAdd = (btn: HTMLButtonElement) => {
    const original = btn.dataset['labelAgregar'] ?? btn.textContent ?? '';
    const agregado = btn.dataset['labelAgregado'] ?? original;
    btn.textContent = agregado;
    window.setTimeout(() => {
      btn.textContent = original;
    }, 1800);
  };

  let quantity = 1;
  const quantityOutput = document.querySelector<HTMLOutputElement>('[data-pdp-quantity]');
  const stockLimitRaw = Number(addCarritoBtn?.dataset['stock'] ?? '');
  const stockLimit = Number.isFinite(stockLimitRaw) && stockLimitRaw > 0 ? stockLimitRaw : 99;
  const renderQuantity = () => {
    if (quantityOutput) quantityOutput.value = String(quantity);
  };
  document.querySelector('[data-pdp-quantity-decrease]')?.addEventListener('click', () => {
    quantity = Math.max(1, quantity - 1);
    renderQuantity();
  });
  document.querySelector('[data-pdp-quantity-increase]')?.addEventListener('click', () => {
    quantity = Math.min(stockLimit, quantity + 1);
    renderQuantity();
  });

  const addToCart = (goCheckout = false) => {
    if (!addCarritoBtn) return;
    const slug = addCarritoBtn.dataset['addCarrito'];
    const nombre = addCarritoBtn.dataset['nombre'];
    const precio = Number(addCarritoBtn.dataset['precio']);
    const moneda = addCarritoBtn.dataset['moneda'] ?? 'COP';
    const stockRaw = addCarritoBtn.dataset['stock'];
    const stock = stockRaw ? Number(stockRaw) : null;
    if (!slug || !nombre || Number.isNaN(precio)) return;
    void import('../lib/carrito').then(({ agregarAlCarrito }) => {
      agregarAlCarrito({ slug, nombre, precio, moneda, stock }, quantity);
      confirmarAdd(addCarritoBtn);
      if (goCheckout) window.location.href = checkoutPath;
    });
  };

  addCarritoBtn?.addEventListener('click', () => addToCart(false));
  document.querySelector('[data-buy-now]')?.addEventListener('click', () => addToCart(true));
  document.querySelector('[data-sticky-add-carrito]')?.addEventListener('click', event => {
    event.preventDefault();
    addToCart(false);
  });

  // Thumbs en PDP: actualizar imagen principal (lightbox sigue en data-galeria-index)
  const mainImg = document.getElementById('producto-imagen-principal') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-pdp-thumb]').forEach(btn => {
    btn.addEventListener('click', () => {
      const thumbImg = btn.querySelector('img');
      if (mainImg && thumbImg) {
        mainImg.src = thumbImg.currentSrc || thumbImg.src;
      }
    });
  });

  // Tarjeta de cotización (productos sin precio)
  const quoteCard = document.querySelector<HTMLElement>('[data-quote-card]');
  if (quoteCard) {
    const qtyInput = quoteCard.querySelector<HTMLInputElement>('[data-quote-qty]');
    const stepBtns = quoteCard.querySelectorAll<HTMLButtonElement>('[data-qty-step]');
    const addBtn = quoteCard.querySelector<HTMLButtonElement>('[data-add-cotizacion]');
    const aviso = quoteCard.querySelector<HTMLElement>('[data-quote-aviso]');
    const MAX = 99;

    const leerCantidad = (): number => {
      const n = Math.floor(Number(qtyInput?.value));
      if (!Number.isFinite(n) || n < 1) return 1;
      return Math.min(n, MAX);
    };
    const pintarCantidad = () => {
      const n = leerCantidad();
      if (qtyInput) qtyInput.value = String(n);
      stepBtns.forEach(btn => {
        const paso = Number(btn.dataset['qtyStep']);
        btn.disabled = (paso < 0 && n <= 1) || (paso > 0 && n >= MAX);
      });
    };
    pintarCantidad();
    qtyInput?.addEventListener('change', pintarCantidad);
    stepBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (qtyInput) qtyInput.value = String(leerCantidad() + Number(btn.dataset['qtyStep']));
        pintarCantidad();
      });
    });

    addBtn?.addEventListener('click', () => {
      // La lista se actualiza en la delegación global (cotizacion-clicks.ts).
      if (aviso) aviso.hidden = false;
    });
    quoteCard.querySelector('[data-quote-ver]')?.addEventListener('click', () => {
      void import('../lib/cotizacion-equipos').then(({ abrirCotizacion }) => abrirCotizacion());
    });
    document.querySelector('[data-quote-sticky-add]')?.addEventListener('click', () => {
      addBtn?.click();
    });
  }
</script>
