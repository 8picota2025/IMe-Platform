  }
  .lightbox__nav {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }

  /* Especificaciones — tabla con cabecera oscura, como el modelo */
  .specs-grupo {
