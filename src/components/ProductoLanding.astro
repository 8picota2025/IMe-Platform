  /* CTA sticky */
  .cta-sticky {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--white);
    border-top: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    z-index: 40;
    padding-block: 0.75rem;
  }
  .cta-sticky[hidden] {
    display: none;
  }
  .cta-sticky__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cta-sticky__nombre {
    margin: 0;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
