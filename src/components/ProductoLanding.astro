---
/**
 * ProductoLanding — landing estática de producto (ES/EN).
 * Estructura visual alineada al modelo de referencia (hero degradado con
 * badge y stats, tarjetas de beneficios, tabla de specs con cabecera oscura,
 * bloque de valor destacado, relacionados, CTA final): breadcrumb, hero,
 * beneficios, galería, especificaciones, aplicaciones, relacionados, CTA de
 * contacto, bloque de valor, reseñas reales, CTA sticky.
 */
import { t, type Locale } from '../i18n/utils';
import ProductoCard from './ProductoCard.astro';
import Resenas from './Resenas.astro';
import type { Producto, Familia } from '../lib/datos';
import { formatMoneda } from '../lib/format';
import { getAccionComercial } from '../lib/comercial';

interface EspecificacionItem {
  clave: string;
  valor: string;
  grupo?: string;
}

interface Props {
  producto: Producto;
  familia: Familia;
  relacionados: Producto[];
  locale: Locale;
}

const { producto, familia, relacionados, locale } = Astro.props;

const catalogoPath = locale === 'en' ? '/en/catalog/' : '/es/catalogo/';
const contactoPath = locale === 'en' ? '/en/contact' : '/es/contacto';

function normalizarEspecs(raw: unknown[]): EspecificacionItem[] {
  return raw.filter((item): item is EspecificacionItem => {
    if (!item || typeof item !== 'object') return false;
    const obj = item as Record<string, unknown>;
    return typeof obj.clave === 'string' && typeof obj.valor === 'string';
  });
}

const especificaciones = normalizarEspecs(producto.especificaciones);
const grupos = new Map<string, EspecificacionItem[]>();
for (const espec of especificaciones) {
  const grupo = espec.grupo ?? '';
  if (!grupos.has(grupo)) grupos.set(grupo, []);
  grupos.get(grupo)!.push(espec);
}

// Sellos de certificación/normativa: se derivan de especificaciones reales
// del propio producto (grupo "Normativa"), nunca de una lista inventada.
const certificaciones = especificaciones.filter(item => /normativ/i.test(item.grupo ?? ''));

const galeria = producto.galeria.filter(url => url && url !== producto.imagen_principal);
const imagenes = [producto.imagen_principal ?? '/assets/img-placeholder.svg', ...galeria];
const imagenProducto = producto.imagen_principal ?? '/assets/img-placeholder.svg';
const imagenFallback =
  'data:image/svg+xml;charset=UTF-8,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 480" role="img" aria-label="${producto.nombre}">
      <rect width="640" height="480" fill="#f3f6f8"/>
      <rect x="32" y="32" width="576" height="416" rx="24" fill="#ffffff" stroke="#d6e0e8"/>
      <path d="M220 286h200" stroke="#c0ccd6" stroke-width="12" stroke-linecap="round"/>
      <path d="M260 254l52 52 70-88 70 88" fill="none" stroke="#90a4b3" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`
  );

const precioFormateado = formatMoneda(producto.precio, producto.moneda, locale);
const noDisponible = producto.disponible === false;
const accionComercial = getAccionComercial(producto, locale);
const modalidadTexto =
  producto.tipo_comercial === 'consumible'
    ? locale === 'en'
      ? 'Consumable'
      : 'Consumible'
    : locale === 'en'
      ? 'Equipment'
      : 'Equipo';
const disponibilidadTexto = noDisponible
  ? t(locale, 'producto.ficha_no_disponible')
  : producto.stock != null && producto.stock > 0
    ? t(locale, 'carrito.stock_limitado').replace('{stock}', String(producto.stock))
    : producto.stock === 0
      ? t(locale, 'producto.ficha_no_disponible')
      : t(locale, 'producto.ficha_disponible');
const whatsappHref = `https://wa.me/573138674059?text=${encodeURIComponent(
  `${t(locale, 'producto.cta_consultar_disponibilidad')}: ${producto.nombre}`
)}`;

const migas = [
  { nombre: t(locale, 'catalogo.migas_inicio'), href: `/${locale}/` },
  { nombre: t(locale, 'catalogo.migas_catalogo'), href: catalogoPath },
  { nombre: familia.nombre, href: `${catalogoPath}?familia=${familia.slug}` },
];

const ctaCotizarHref = `${contactoPath}?producto=${encodeURIComponent(producto.nombre)}`;

// Stats de la cabecera del hero: reutiliza datos ya verificados (modalidad,
// disponibilidad, familia, precio) en vez de intentar extraer valores cortos
// de las especificaciones en prosa, que no son fiables para un resumen.
const heroStats: Array<{ valor: string; etiqueta: string }> = [
  { valor: modalidadTexto, etiqueta: t(locale, 'producto.ficha_modalidad') },
  { valor: disponibilidadTexto, etiqueta: t(locale, 'producto.ficha_stock') },
  { valor: familia.nombre, etiqueta: t(locale, 'catalogo.migas_catalogo') },
];
if (precioFormateado) {
  heroStats.push({ valor: precioFormateado, etiqueta: t(locale, 'producto.ficha_precio') });
}
---

<article class="producto-landing">
  <!-- Breadcrumb -->
  <nav class="breadcrumb container" aria-label={t(locale, 'catalogo.migas_inicio')}>
    <ol>
      {
        migas.map(miga => (
          <li>
            <a href={miga.href}>{miga.nombre}</a>
            <span aria-hidden="true">/</span>
          </li>
        ))
      }
      <li aria-current="page">{producto.nombre}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="hero-producto">
    <div class="hero-producto__bg" aria-hidden="true"></div>
    <div class="container hero-producto__inner">
      <div class="hero-producto__content">
        <span class="hero-producto__badge">{producto.marca || familia.nombre}</span>
        <h1>{producto.nombre}</h1>
        <p class="hero-producto__desc">{producto.descripcion_corta}</p>

        <div class="hero-producto__cta-group" id="cta-principal">
          {
            accionComercial.tipo === 'consultar' ? (
              <a
                href={whatsappHref}
                class="btn-hero-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                {accionComercial.label}
              </a>
            ) : accionComercial.tipo === 'carrito' ? (
              <button
                type="button"
                class="btn-hero-primary"
                aria-live="polite"
                data-add-carrito={producto.slug}
                data-nombre={producto.nombre}
                data-precio={producto.precio}
                data-moneda={producto.moneda ?? 'COP'}
                data-stock={producto.stock ?? ''}
                data-label-agregar={t(locale, 'carrito.agregar')}
                data-label-agregado={t(locale, 'carrito.agregado')}
              >
                {accionComercial.label}
              </button>
            ) : (
              <button
                type="button"
                class="btn-hero-primary"
                aria-live="polite"
                data-add-cotizacion={producto.slug}
                data-nombre={producto.nombre}
                data-imagen={imagenProducto}
                data-label-agregar={t(locale, 'cotizacion_equipos.agregar')}
                data-label-agregado={t(locale, 'cotizacion_equipos.agregado')}
              >
                {accionComercial.label}
              </button>
            )
          }
          <a href={ctaCotizarHref} class="btn-hero-secondary">
            {t(locale, 'producto.cotizar_cta')}
          </a>
          {
            producto.ficha_pdf && (
              <a
                href={producto.ficha_pdf}
                class="btn-hero-secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t(locale, 'producto.ficha_pdf')}
              </a>
            )
          }
        </div>

        <div class="hero-producto__stats">
          {
            heroStats.map(stat => (
              <div class="hero-producto__stat">
                <span class="hero-producto__stat-valor">{stat.valor}</span>
                <span class="hero-producto__stat-etiqueta">{stat.etiqueta}</span>
              </div>
            ))
          }
        </div>

        <label class="producto-landing__compare">
          <input type="checkbox" id="comparador-toggle" data-compare-slug={producto.slug} />
          <span>{t(locale, 'catalogo.comparar_anadir')}</span>
        </label>
      </div>

      <div class="hero-producto__media">
        <img
          src={imagenes[0]}
          alt={producto.nombre}
          width="640"
          height="480"
          decoding="async"
          fetchpriority="high"
          class="hero-producto__img"
          id="producto-imagen-principal"
          onerror={`this.onerror=null;this.src='${imagenFallback}'`}
        />
        {
          (producto.destacado || producto.nuevo || noDisponible) && (
            <div class="hero-producto__badges" aria-hidden="true">
              {producto.nuevo && (
                <span class="badge badge-green">{t(locale, 'producto.badge_nuevo')}</span>
              )}
              {producto.destacado && (
                <span class="badge badge-teal">{t(locale, 'producto.badge_destacado')}</span>
              )}
              {noDisponible && (
                <span class="badge badge-gris">{t(locale, 'producto.badge_no_disponible')}</span>
              )}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Beneficios clave -->
  {
    producto.beneficios.length > 0 && (
      <section class="section container" aria-labelledby="beneficios-heading">
        <h2 id="beneficios-heading" class="section-title">
          {t(locale, 'producto.beneficios_titulo')}
        </h2>
        <ul class="beneficios__grid" role="list">
          {producto.beneficios.map(beneficio => (
            <li class="beneficios__card">
              <span class="beneficios__icono" aria-hidden="true">
                ✓
              </span>
              <p>{beneficio}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Galería -->
  {
    galeria.length > 0 && (
      <section class="section container" aria-labelledby="galeria-heading">
        <h2 id="galeria-heading" class="section-title">
          {t(locale, 'producto.galeria_titulo')}
        </h2>
        <ul class="galeria__grid" role="list">
          {imagenes.map((src, index) => (
            <li>
              <button
                type="button"
                class="galeria__thumb"
                data-galeria-index={index}
                aria-label={`${t(locale, 'producto.galeria_abrir')}: ${producto.nombre} ${index + 1}/${imagenes.length}`}
              >
                <img src={src} alt="" width="200" height="150" loading="lazy" decoding="async" />
              </button>
            </li>
          ))}
        </ul>

        <dialog id="galeria-lightbox" aria-label={t(locale, 'producto.galeria_titulo')}>
          <div class="lightbox__header">
            <p class="lightbox__contador" aria-live="polite" id="lightbox-contador" />
            <button type="button" class="lightbox__cerrar" data-lightbox-close>
              <span aria-hidden="true">×</span>
              <span class="sr-only">{t(locale, 'producto.galeria_cerrar')}</span>
            </button>
          </div>
          <img id="lightbox-img" src={imagenes[0]} alt="" decoding="async" />
          <div class="lightbox__nav">
            <button type="button" data-lightbox-prev class="btn btn-secondary">
              {t(locale, 'producto.galeria_anterior')}
            </button>
            <button type="button" data-lightbox-next class="btn btn-secondary">
              {t(locale, 'producto.galeria_siguiente')}
            </button>
          </div>
        </dialog>
      </section>
    )
  }

  <!-- Especificaciones -->
  <section class="section section-off container" aria-labelledby="specs-heading">
    <h2 id="specs-heading" class="section-title">{t(locale, 'producto.specs_titulo')}</h2>
    {
      especificaciones.length > 0 ? (
        [...grupos.entries()].map(([grupo, items]) => (
          <div class="specs-grupo">
            {grupo && <h3 class="specs-grupo__titulo">{grupo}</h3>}
            <table class="specs-table">
              <thead>
                <tr>
                  <th scope="col">{t(locale, 'producto.specs_columna_parametro')}</th>
                  <th scope="col">{t(locale, 'producto.specs_columna_detalle')}</th>
                </tr>
              </thead>
              <tbody>
                {items.map(item => (
                  <tr>
                    <th scope="row">{item.clave}</th>
                    <td>{item.valor}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))
      ) : (
        <p class="specs-pendiente">{t(locale, 'producto.specs_pendiente')}</p>
      )
    }
  </section>

  <!-- Aplicaciones clínicas -->
  {
    producto.aplicaciones.length > 0 && (
      <section class="section container" aria-labelledby="aplicaciones-heading">
        <h2 id="aplicaciones-heading" class="section-title">
          {t(locale, 'producto.aplicaciones_titulo')}
        </h2>
        <ul class="aplicaciones__grid" role="list">
          {producto.aplicaciones.map(item => (
            <li class="aplicaciones__item">
              <span class="aplicaciones__icono" aria-hidden="true">
                ✓
              </span>
              {item}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Bloque de valor (no es un testimonio atribuido a una persona) -->
  {
    producto.valor && (
      <section class="section section-off container" aria-labelledby="valor-heading">
        <h2 id="valor-heading" class="section-title">
          {t(locale, 'producto.valor_titulo')}
        </h2>
        <div class="valor-card">
          <p class="valor-card__texto">{producto.valor}</p>
        </div>
        {certificaciones.length > 0 && (
          <ul class="cert-badges" role="list">
            {certificaciones.map(item => (
              <li class="cert-badge">{item.valor}</li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  <!-- Relacionados -->
  {
    relacionados.length > 0 && (
      <section class="section container" aria-labelledby="relacionados-heading">
        <div class="section-header">
          <h2 id="relacionados-heading" class="section-title">
            {t(locale, 'producto.relacionados_titulo')}
          </h2>
          <a href={`${catalogoPath}?familia=${familia.slug}`} class="ver-familia-link">
            {t(locale, 'producto.ver_familia')} →
          </a>
        </div>
        <ul class="relacionados__grid" role="list">
          {relacionados.map(rel => (
            <ProductoCard
              producto={{
                slug: rel.slug,
                nombre: rel.nombre,
                descripcion_corta: rel.descripcion_corta,
                imagen_principal: rel.imagen_principal,
                destacado: rel.destacado,
                nuevo: rel.nuevo,
                familia: { slug: familia.slug, nombre: familia.nombre },
                tipo_comercial: rel.tipo_comercial,
                fulfillment_mode: rel.fulfillment_mode,
                precio: rel.precio,
                moneda: rel.moneda,
                stock: rel.stock,
                disponible: rel.disponible,
              }}
              locale={locale}
            />
          ))}
        </ul>
      </section>
    )
  }

  <Resenas productoId={producto.id} productoSlug={producto.slug} locale={locale} />

  <!-- CTA final -->
  <section class="cta-final">
    <div class="cta-final__bg" aria-hidden="true"></div>
    <div class="container cta-final__inner">
      <h2>{t(locale, 'producto.contacto_titulo')}</h2>
      <p>{t(locale, 'producto.contacto_desc')}</p>
      <div class="cta-final__acciones">
        <a href={ctaCotizarHref} class="btn-hero-primary">
          {t(locale, 'producto.cotizar_cta')}
        </a>
        <a href={whatsappHref} class="btn-hero-secondary" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">↗</span> WhatsApp
        </a>
        <a href={catalogoPath} class="btn-hero-secondary">
          {t(locale, 'producto.volver_catalogo')}
        </a>
      </div>
    </div>
  </section>

  <!-- CTA sticky -->
  <div class="cta-sticky" id="cta-sticky" hidden>
    <div class="container cta-sticky__inner">
      <p class="cta-sticky__nombre">{producto.nombre}</p>
      <a href={ctaCotizarHref} class="btn btn-primary">
        {t(locale, 'producto.cotizar_cta')}
      </a>
    </div>
  </div>
</article>

<style>
  .breadcrumb {
    padding-block-start: 110px;
    padding-block-end: var(--space-sm);
  }
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    color: var(--text-mid);
  }
  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .breadcrumb a {
    color: var(--text-mid);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--t900);
    text-decoration: underline;
  }
  .breadcrumb li[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  /* Hero: degradado oscuro de ancho completo, como el modelo de referencia */
  .hero-producto {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl) var(--space-xl);
    color: var(--white);
  }
  .hero-producto__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--t900) 0%, var(--t700) 100%);
    z-index: -1;
  }
  .hero-producto__bg::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -15%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
  }
  .hero-producto__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-producto__inner {
      grid-template-columns: 1.15fr 1fr;
    }
  }
  .hero-producto__content {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .hero-producto__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero-producto__content h1 {
    margin: 0;
    color: var(--white);
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    line-height: 1.15;
  }
  .hero-producto__desc {
    margin: 0;
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.6;
  }
  .hero-producto__cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.4rem;
  }
  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--green);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(126, 217, 87, 0.35);
  }
  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    color: var(--white);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-hero-secondary:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .hero-producto__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-block-start: 0.75rem;
  }
  .hero-producto__stat {
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 0.6rem 1.1rem;
    min-width: 110px;
    text-align: center;
  }
  .hero-producto__stat-valor {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }
  .hero-producto__stat-etiqueta {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.75;
    margin-block-start: 0.15rem;
  }
  .producto-landing__compare {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    margin-block-start: 0.5rem;
  }
  .producto-landing__compare input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--green);
  }

  .hero-producto__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--off2);
    aspect-ratio: 4/3;
    box-shadow: var(--shadow-lg);
  }
  .hero-producto__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-producto__badges {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .section {
    padding-block: var(--space-xl);
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-md);
  }
  .section-off {
    background: var(--off);
  }
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-md);
  }
  .section-header .section-title {
    margin: 0;
  }
  .ver-familia-link {
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-display);
    color: var(--t800);
    text-decoration: none;
    white-space: nowrap;
  }
  .ver-familia-link:hover {
    text-decoration: underline;
  }

  /* Beneficios clave */
  .beneficios__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-md);
    list-style: none;
