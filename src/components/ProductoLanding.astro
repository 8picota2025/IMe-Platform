  }

  /* CTA final — degradado oscuro de ancho completo, como el modelo */
  .cta-final {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl);
    color: var(--white);
    text-align: center;
  }
  .cta-final__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--t900) 0%, var(--t700) 100%);
    z-index: -1;
  }
  .cta-final__inner h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 800;
    margin: 0 0 0.75rem;
    color: var(--white);
  }
  .cta-final__inner p {
    max-width: 520px;
    margin: 0 auto 1.75rem;
    opacity: 0.88;
  }
  .cta-final__acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
