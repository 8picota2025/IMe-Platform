---
/**
 * Presentación de /familias/robots: el catálogo visual va primero
 * y el texto técnico conserva su medida de lectura.
 */
import ProductoCard from './ProductoCard.astro';
import PaginacionNumeros from './PaginacionNumeros.astro';
import NotaPromoPadbot from './NotaPromoPadbot.astro';
import type { Locale } from '../i18n/utils';
import type { CatalogoIndexItem } from '../lib/catalogo';
import { IME_WHATSAPP_DISPLAY } from '../lib/contacto-oficial';

interface Props {
  locale: Locale;
  name: string;
  intro: string;
  paragraphs: string[];
  faq: Array<{ q: string; a: string }>;
  criterios: string[];
  hubLinks: Array<{ href: string; label: string }>;
  items: CatalogoIndexItem[];
  pageCount: number;
  total: number;
}

const { locale, name, intro, paragraphs, faq, criterios, hubLinks, items, pageCount, total } =
  Astro.props;
const isEn = locale === 'en';
const homeHref = isEn ? '/en/' : '/es/';
const catalogHref = isEn ? '/en/catalog/' : '/es/catalogo/';
const contactHref = isEn ? '/en/contact/' : '/es/contacto/';
const familyBase = isEn ? '/en/families/robots/' : '/es/familias/robots/';
const productBase = isEn ? '/en/products/' : '/es/productos/';
const equiposId = isEn ? 'equipment' : 'equipos';
---

<div class="robots-family">
  <header class="robots-hero">
    <div class="robots-wrap robots-hero__grid">
      <div>
        <nav class="robots-crumbs" aria-label={isEn ? 'Breadcrumb' : 'Ruta'}>
          <a href={homeHref}>{isEn ? 'Home' : 'Inicio'}</a>
          <span aria-hidden="true">/</span>
          <a href={catalogHref}>{isEn ? 'Catalog' : 'Catálogo'}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{name}</span>
        </nav>
        <h1>{name}</h1>
        <p class="robots-intro">{intro}</p>
        <div class="robots-actions">
          <a class="btn btn-primary" href={`#${equiposId}`}>
            {isEn ? `Browse ${total} robots` : `Ver ${total} robots`}
          </a>
          <a class="btn btn-secondary" href={contactHref}>
            {isEn ? 'Request a quote' : 'Solicitar cotización'}
          </a>
        </div>
        <p class="robots-phone">
          <a href="tel:+573137247353">{IME_WHATSAPP_DISPLAY}</a>
        </p>
      </div>
      <div class="robots-mosaic">
        {
          items.map((producto, index) => (
            <a href={`${productBase}${producto.slug}/`}>
              <img
                src={producto.imagen_principal ?? '/assets/img-placeholder.svg'}
                alt={producto.nombre}
                width="1200"
                height="1200"
                loading={index < 2 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                decoding="async"
              />
              <span>{producto.nombre}</span>
            </a>
          ))
        }
      </div>
    </div>
  </header>

  <section class="robots-copy" aria-label={isEn ? 'Engineering notes' : 'Notas de ingeniería'}>
    <div class="robots-wrap">
      <div class="robots-prose">
        {paragraphs.map(paragraph => <p>{paragraph}</p>)}
        <div class="robots-promo">
          <NotaPromoPadbot locale={locale} />
        </div>
        {
          hubLinks.length > 0 && (
            <nav class="robots-hub" aria-label={isEn ? 'Related guides' : 'Guías relacionadas'}>
              {hubLinks.map(link => (
                <a class="btn btn-secondary" href={link.href}>
                  {link.label}
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </div>
  </section>

  {
    items.length > 0 && (
      <section id={equiposId} class="robots-catalog" aria-labelledby="robots-catalogo">
        <div class="robots-wrap">
          <h2 id="robots-catalogo">{isEn ? `Robots in this family` : `Robots de esta familia`}</h2>
          <ul class="robots-grid">
            {items.map(producto => (
              <ProductoCard
                producto={{
                  ...producto,
                  familia: { slug: 'robots', nombre: name },
                }}
                locale={locale}
              />
            ))}
          </ul>
          {pageCount > 1 && (
            <nav
              class="robots-pages"
              aria-label={isEn ? 'Family pagination' : 'Paginación de la familia'}
            >
              <span>{isEn ? `Page 1 of ${pageCount}` : `Página 1 de ${pageCount}`}</span>
              <PaginacionNumeros
                page={1}
                pageCount={pageCount}
                pagePath={(n: number) => (n === 1 ? familyBase : `${familyBase}pagina/${n}/`)}
                irALabel={isEn ? 'Go to page' : 'Ir a la página'}
              />
              <a class="btn btn-secondary" href={`${familyBase}pagina/2/`}>
                {isEn ? 'Next' : 'Siguiente'}
              </a>
            </nav>
          )}
        </div>
      </section>
    )
  }

  <section class="robots-lower">
    <div class="robots-wrap robots-lower__grid">
      <div>
        <h2>
          {
            isEn
              ? 'How to structure an institutional purchase'
              : 'Cómo estructurar la compra institucional'
          }
        </h2>
        <p>
          {
            isEn
              ? 'Use this guide to prepare a comparable request. It does not replace clinical or technical assessment, nor manufacturer documentation.'
              : 'Use esta guía para preparar una solicitud comparable. No reemplaza la evaluación clínica, técnica ni la documentación del fabricante.'
          }
        </p>
        <ol>
          {criterios.map(criterio => <li>{criterio}</li>)}
        </ol>
        <p>
          {
            isEn
              ? 'For each reference, I-ME confirms applicable documentation, commercial scope and support conditions.'
              : 'Para cada referencia, I-ME confirma documentación aplicable, alcance comercial y condiciones de soporte.'
          }
        </p>
      </div>
      <div>
        <h2>{isEn ? 'Questions' : 'Preguntas frecuentes'}</h2>
        {
          faq.map(item => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</div>

<style>
  .robots-family {
    color: var(--text);
    background: var(--white);
  }
  .robots-family ::selection {
    background: var(--t100);
    color: var(--ink);
  }
  .robots-wrap {
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
  }
  .robots-prose {
    max-width: 72ch;
  }
  .robots-hero {
    background: var(--off);
    padding: calc(6.25rem + env(safe-area-inset-top)) 0 var(--space-xl);
  }
  .robots-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }
  .robots-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    font-size: var(--step--1);
  }
  .robots-crumbs a,
  .robots-phone a {
    color: var(--t800);
  }
  .robots-hero h1,
  .robots-catalog h2,
  .robots-lower h2 {
    font-family: var(--font-display);
    color: var(--ink);
    text-wrap: balance;
    margin: 0 0 0.85rem;
    line-height: 1.15;
  }
  .robots-hero h1 {
    font-size: var(--step-3);
    max-width: 16ch;
  }
  .robots-intro,
  .robots-copy p,
  .robots-lower p {
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .robots-actions,
  .robots-hub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .robots-actions .btn,
  .robots-hub .btn {
    min-height: 44px;
    white-space: normal;
    text-align: center;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .robots-phone {
    margin: 1rem 0 0;
    font-size: var(--step--1);
  }
  .robots-mosaic {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .robots-mosaic:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
  .robots-mosaic a {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 0.45rem 0.45rem 0.6rem;
  }
  .robots-mosaic a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  .robots-mosaic img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    background: var(--off2);
    border-radius: calc(var(--radius) - 4px);
  }
  .robots-mosaic span {
    font-size: 0.75rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .robots-copy {
    padding: var(--space-xl) 0;
  }
  .robots-promo {
    margin: 0.5rem 0 1.25rem;
    padding: 1rem 1.1rem;
    background: var(--t50);
    border-radius: var(--radius);
  }
  .robots-promo :global(p) {
    margin: 0;
  }
  .robots-catalog {
    padding: 0 0 var(--space-xl);
  }
  .robots-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .robots-grid :global(.producto-card) {
    height: 100%;
  }
  .robots-grid :global(.producto-card__img) {
    object-fit: contain;
    background: var(--off);
  }
  .robots-pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .robots-lower {
    background: var(--off);
    padding: var(--space-xl) 0 var(--space-2xl);
  }
  .robots-lower__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .robots-lower ol {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    line-height: 1.6;
  }
  .robots-lower li + li {
    margin-top: 0.65rem;
  }
  .robots-lower details {
    border-bottom: 1px solid var(--border);
  }
  .robots-lower summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--ink);
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0.35rem 0;
  }
  .robots-lower summary:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  @media (max-width: 900px) {
    .robots-hero__grid,
    .robots-lower__grid {
      grid-template-columns: 1fr;
    }
    .robots-hero h1 {
      max-width: none;
    }
    .robots-mosaic {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 0.25rem;
      padding-bottom: 0.35rem;
      scrollbar-color: var(--t800) transparent;
    }
    .robots-mosaic a {
      flex: 0 0 min(68vw, 220px);
      scroll-snap-align: start;
    }
  }
  @media (min-width: 700px) {
    .robots-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .robots-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .robots-actions .btn,
    .robots-hub .btn {
      flex: 1 1 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .robots-mosaic {
      scroll-behavior: auto;
    }
  }
</style>
