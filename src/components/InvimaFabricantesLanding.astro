<script>
  import { emitAnalyticsEvent } from '../lib/analytics';

  const root = document.querySelector<HTMLElement>('[data-ifl-root]');
  if (root) {
    root.querySelectorAll<HTMLAnchorElement>('[data-cta^="invima-"]').forEach(a => {
      a.addEventListener('click', () => {
        emitAnalyticsEvent('cta_clicked', {
          cta: a.dataset.cta ?? 'invima',
          origin: 'invima_fabricantes',
        });
      });
    });

    const floatBar = root.querySelector<HTMLElement>('[data-ifl-float]');
    const formSection = root.querySelector<HTMLElement>('[data-ifl-form]');
    if (floatBar && formSection) {
      const floatLinks = floatBar.querySelectorAll<HTMLAnchorElement>('a');
      const syncFloat = () => {
        const scrolled = window.scrollY > Math.min(window.innerHeight * 0.55, 420);
        const formRect = formSection.getBoundingClientRect();
        const formInView = formRect.top < window.innerHeight * 0.72 && formRect.bottom > 80;
        const show = scrolled && !formInView;
        floatBar.classList.toggle('is-visible', show);
        floatBar.setAttribute('aria-hidden', show ? 'false' : 'true');
        floatLinks.forEach(link => {
          if (show) link.removeAttribute('tabindex');
          else link.setAttribute('tabindex', '-1');
        });
      };
      syncFloat();
      window.addEventListener('scroll', syncFloat, { passive: true });
      window.addEventListener('resize', syncFloat);
    }
  }
</script>
