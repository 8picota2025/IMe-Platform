---
// ADR-0012: GTM/GA4/Clarity ya no se inyectan de forma incondicional. Se
// cargan sólo si hay consentimiento de analítica guardado (ver
// src/lib/consent.ts) — la política de cookies (src/lib/legal.ts, kind
// 'cookies') exige consentimiento previo para "Analítica no esencial".
import { resolveAnalyticsDomain, resolveGaId } from '../lib/analytics-config';

const gaId = resolveGaId();
const gtmId = (import.meta.env['PUBLIC_GTM_ID'] as string | undefined)?.trim() ?? '';
const clarityId = (import.meta.env['PUBLIC_CLARITY_ID'] as string | undefined)?.trim() ?? '';
const analyticsDomain = resolveAnalyticsDomain();
---

{
  gaId && <link rel="preconnect" href="https://www.googletagmanager.com" />
}

<meta
  name="ime-analytics"
  content={analyticsDomain}
  data-ga={gaId}
  data-gtm={gtmId}
  data-clarity={clarityId}
/>

<script>
  import { installAnalytics, trackPageView } from '../lib/analytics';
  import {
    applyDefaultConsentMode,
    hasAnalyticsConsent,
    loadAnalyticsScripts,
  } from '../lib/consent';

  // Señal Consent Mode v2 "default" — antes de cualquier tag, exista o no
  // consentimiento guardado todavía.
  applyDefaultConsentMode();

  const meta = document.querySelector<HTMLMetaElement>('meta[name="ime-analytics"]');
  const ids = {
    gtmId: meta?.dataset.gtm || '',
    gaId: meta?.dataset.ga || '',
    clarityId: meta?.dataset.clarity || '',
    analyticsDomain: meta?.content || 'i-me.com.co',
  };

  if (hasAnalyticsConsent()) {
    loadAnalyticsScripts(ids);
  }

  installAnalytics({
    dataDomain: ids.analyticsDomain,
    gaEnabled: !!ids.gaId,
    gtmEnabled: !!ids.gtmId,
    clarityEnabled: !!ids.clarityId,
  });

  trackPageView();
  document.addEventListener('astro:page-load', trackPageView);
</script>
