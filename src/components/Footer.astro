---
/**
 * Footer — datos reales de contenido_ime.json: contacto, links, familias, slogan, copyright.
 */
import type { Locale } from '../i18n/utils';
import { t, getLocalizedPath } from '../i18n/utils';
import { getLegalSlug, type LegalKind } from '../lib/legal';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const familias = [
  { slug: 'monitores', label_es: 'Monitores de Signos Vitales', label_en: 'Patient Monitors' },
  { slug: 'cardiologia', label_es: 'Cardiología', label_en: 'Cardiology' },
  { slug: 'sala-cirugia', label_es: 'Sala de Cirugía', label_en: 'Operating Room' },
  { slug: 'neonatologia', label_es: 'Neonatología', label_en: 'Neonatology' },
  { slug: 'ultrasonido', label_es: 'Ultrasonido', label_en: 'Ultrasound' },
  { slug: 'soluciones-iv', label_es: 'Soluciones IV', label_en: 'IV Solutions' },
  { slug: 'mobiliario', label_es: 'Mobiliario Hospitalario', label_en: 'Hospital Furniture' },
  { slug: 'anestesia', label_es: 'Anestesia y Ventilación', label_en: 'Anesthesia & Ventilation' },
];

const year = new Date().getFullYear();
const legalLinks: Array<{ kind: LegalKind; label: string }> = [
  { kind: 'privacidad', label: t(locale, 'footer.privacidad') },
  { kind: 'habeas-data', label: t(locale, 'footer.habeas_data') },
  { kind: 'cookies', label: t(locale, 'footer.cookies') },
  { kind: 'terminos', label: t(locale, 'footer.terminos') },
  { kind: 'envios', label: locale === 'en' ? 'Shipping' : 'Envíos' },
  { kind: 'devoluciones', label: locale === 'en' ? 'Returns' : 'Devoluciones' },
  { kind: 'garantias', label: locale === 'en' ? 'Warranty' : 'Garantías' },
  { kind: 'copyright', label: t(locale, 'footer.copyright') },
];
---

<footer class="footer" role="contentinfo">
  <!-- Main footer content -->
  <div class="footer__main container">
    <!-- Columna 1: Marca + Descripción -->
    <div class="footer__section footer__brand-section">
      <a
        href={getLocalizedPath('/', locale)}
        aria-label={t(locale, 'accesibilidad.logo')}
        class="footer__logo"
        onclick={`window.location.assign('${getLocalizedPath('/', locale)}'); return false;`}
      >
        <img
          src="/assets/img/logo-ime-site.webp"
          alt="I-ME International Medical Enterprise"
          width="75"
          height="37"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="footer__desc">{t(locale, 'footer.descripcion')}</p>
      <p class="footer__slogan">"Equipamos tu misión de salvar vidas."</p>
    </div>

    <!-- Columna 2: Navegación principal -->
    <nav class="footer__section" aria-label={t(locale, 'footer.navegacion')}>
      <h3 class="footer__heading">
        <span class="footer__heading-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </span>
        {t(locale, 'footer.navegacion')}
      </h3>
      <ul class="footer__list" role="list">
        <li><a href={getLocalizedPath('/', locale)}>{t(locale, 'nav.inicio')}</a></li>
        <li><a href={getLocalizedPath('/nosotros', locale)}>{t(locale, 'nav.nosotros')}</a></li>
        <li><a href={getLocalizedPath('/catalogo', locale)}>{t(locale, 'nav.catalogo')}</a></li>
        <li><a href={getLocalizedPath('/servicios', locale)}>{t(locale, 'nav.servicios')}</a></li>
        <li>
          <a href={getLocalizedPath('/financiacion', locale)}>{t(locale, 'nav.financiacion')}</a>
        </li>
        <li>
          <a href={locale === 'en' ? '/en/cities/bogota/' : '/es/ciudades/bogota/'}>
            {locale === 'en' ? 'Bogotá' : 'Bogotá'}
          </a>
        </li>
        <li>
          <a href={locale === 'en' ? '/en/cities/medellin/' : '/es/ciudades/medellin/'}>
            {locale === 'en' ? 'Medellín' : 'Medellín'}
          </a>
        </li>
        <li>
          <a href={locale === 'en' ? '/en/cities/cali/' : '/es/ciudades/cali/'}>Cali</a>
        </li>
        <li>
          <a href={locale === 'en' ? '/en/resources/' : '/es/recursos/'}>
            {locale === 'en' ? 'Resources' : 'Recursos'}
          </a>
        </li>
        <li>
          <a href={getLocalizedPath('/proyectos', locale)}>
            {locale === 'en' ? 'Projects' : 'Proyectos'}
          </a>
        </li>
        <li>
          <a href={getLocalizedPath('/caminadores-para-adultos', locale)}>
            {locale === 'en' ? 'Adult walkers' : 'Caminadores para adultos'}
          </a>
        </li>
        <li>
          <a href={getLocalizedPath('/sillas-de-ruedas', locale)}>
            {locale === 'en' ? 'Wheelchairs' : 'Sillas de ruedas'}
          </a>
        </li>
        <li>
          <a href={getLocalizedPath('/monitores-biolight-uci', locale)}>
            {locale === 'en' ? 'Biolight ICU monitors' : 'Monitores Biolight UCI'}
          </a>
        </li>
        <li>
          <a href={getLocalizedPath('/alto-flujo-fisher-paykel', locale)}>
            {locale === 'en' ? 'Fisher Paykel high flow' : 'Alto flujo Fisher Paykel'}
          </a>
        </li>
        <li>
          <a href={getLocalizedPath('/camillas-medicas', locale)}>
            {locale === 'en' ? 'Medical stretchers' : 'Camillas médicas'}
          </a>
        </li>
        <li><a href={getLocalizedPath('/contacto', locale)}>{t(locale, 'nav.contacto')}</a></li>
        <li>
          <a href={getLocalizedPath('/conocimiento', locale)}>{t(locale, 'nav.conocimiento')}</a>
        </li>
        <li>
          <a href={getLocalizedPath('/seguimiento', locale)}>
            {locale === 'en' ? 'Order status' : 'Seguimiento'}
          </a>
        </li>
      </ul>
    </nav>

    <!-- Columna 3: Categorías de productos -->
    <nav class="footer__section" aria-label={t(locale, 'catalogo.familias_titulo')}>
      <h3 class="footer__heading">
        <span class="footer__heading-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </span>
        {t(locale, 'footer.categorias')}
      </h3>
      <ul class="footer__list" role="list">
        {
          familias.map(f => (
            <li>
              <a
                href={
                  f.slug === 'mobiliario'
                    ? `${getLocalizedPath('/catalogo', locale)}?familia=${f.slug}`
                    : `${locale === 'en' ? '/en/families' : '/es/familias'}/${f.slug}/`
                }
              >
                {locale === 'en' ? f.label_en : f.label_es}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Columna 4: Contacto directo -->
    <div class="footer__section footer__contact-section">
      <h3 class="footer__heading">
        <span class="footer__heading-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
        </span>
        {locale === 'es' ? 'Contacto' : 'Contact'}
      </h3>
      <div class="footer__contact-items">
        <a href="tel:+573137247353" class="footer__contact-item">
          <span class="contact-icon phone-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
              ></path>
            </svg>
          </span>
          <span>+57 313 724 7353</span>
        </a>
        <a
          href="https://wa.me/573137247353"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__contact-item"
        >
          <span class="contact-icon whatsapp-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-9.746 9.748c0 2.718.738 5.33 2.14 7.617l-2.271 6.77c-.256.767.155 1.61.934 1.859l.06.02c.505.168 1.009-.338 1.225-.668l6.924-11.176a9.87 9.87 0 009.669-4.61c.556-1.016.902-2.189.902-3.427a9.865 9.865 0 00-9.833-9.873z"
              ></path>
            </svg>
          </span>
          <span>WhatsApp</span>
        </a>
        <a href="mailto:info@i-me.com.co" class="footer__contact-item">
          <span class="contact-icon email-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </span>
          <span>info@i-me.com.co</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar: copyright + legal -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <div class="footer__bottom-left">
        <p class="footer__copy">
          &copy; {year} I-ME International Medical Enterprise. {t(locale, 'footer.derechos')}.
        </p>
        <p class="footer__certif">
          {t(locale, 'footer.pais')} &middot; {t(locale, 'footer.certif')}
        </p>
      </div>
      <nav class="footer__legal" aria-label={t(locale, 'footer.legal')}>
        {
          legalLinks.map(link => (
            <a href={`/${locale}/legal/${getLegalSlug(link.kind, locale)}`}>{link.label}</a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    color: rgba(255, 255, 255, 0.8);
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* ===== MAIN FOOTER CONTENT ===== */
  .footer__main {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .footer__main {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  @media (min-width: 1024px) {
    .footer__main {
      grid-template-columns: 1.5fr 1fr 1.2fr 1.3fr;
      gap: var(--space-2xl);
    }
  }

  /* ===== FOOTER SECTIONS ===== */
  .footer__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer__brand-section {
    gap: var(--space-lg);
  }

  .footer__logo {
    display: inline-block;
    transition: opacity 200ms var(--ease);
  }

  .footer__logo:hover {
    opacity: 0.8;
  }

  .footer__logo img {
    width: auto;
    height: auto;
    display: block;
  }

  .footer__desc {
    font-size: var(--step--1);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .footer__slogan {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    font-style: italic;
    color: var(--green);
    margin: 0;
  }

  /* ===== FOOTER HEADINGS ===== */
  .footer__heading {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__heading-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: var(--green);
  }

  .footer__heading-icon svg {
    width: 100%;
    height: 100%;
  }

  /* ===== FOOTER LISTS ===== */
  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__list a {
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: all 200ms var(--ease);
    position: relative;
    padding-left: 0.5rem;
  }

  .footer__list a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 3px;
    background: var(--green);
    border-radius: 50%;
    opacity: 0;
    transition: opacity 200ms var(--ease);
  }

  .footer__list a:hover {
    color: var(--white);
    padding-left: 1rem;
  }

  .footer__list a:hover::before {
    opacity: 1;
  }

  /* ===== CONTACT SECTION ===== */
  .footer__contact-section {
    gap: var(--space-md);
  }

  .footer__contact-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: all 200ms var(--ease);
    padding: 0.75rem;
    border-radius: var(--radius);
  }

  .footer__contact-item:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .contact-icon svg {
    width: 100%;
    height: 100%;
  }

  .phone-icon {
    color: rgba(126, 217, 87, 0.8);
  }

  .whatsapp-icon {
    color: rgba(37, 211, 102, 0.8);
  }

  .email-icon {
    color: rgba(74, 144, 226, 0.8);
  }

  /* ===== FOOTER BOTTOM ===== */
  .footer__bottom {
    background: rgba(0, 0, 0, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: var(--space-lg);
  }

  .footer__bottom-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .footer__bottom-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-lg);
    }
  }

  .footer__bottom-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__copy,
  .footer__certif {
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .footer__certif {
    color: rgba(255, 255, 255, 0.55);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .footer__legal {
      width: auto;
      gap: 1rem;
    }
  }

  .footer__legal a {
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }

  .footer__legal a:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  /* ===== ACCESSIBILITY ===== */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
