---
/**
 * CTA comercial persistente para móvil. Mantiene WhatsApp y cotización formal
 * accesibles durante todo el recorrido sin interferir con checkout o pagos.
 */
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const whatsappText = isEn
  ? "Hello, I'd like advice on biomedical equipment for my institution."
  : 'Hola, necesito asesoría para cotizar equipos biomédicos para mi institución.';
const whatsappHref = `https://wa.me/573137247353?text=${encodeURIComponent(whatsappText)}`;
const whatsappLabel = isEn ? 'Chat on WhatsApp' : 'Hablar por WhatsApp';
const quoteLabel = isEn ? 'Quote' : 'Cotización';
---

<nav
  class="mobile-commercial-bar"
  data-mobile-commercial-bar
  data-locale={locale}
  aria-label={isEn ? 'Quick sales contact' : 'Contacto comercial rápido'}
>
  <a
    class="mobile-commercial-bar__action mobile-commercial-bar__action--whatsapp"
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    data-commercial-origin="mobile_sticky_whatsapp"
    data-mobile-whatsapp
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path
        fill="currentColor"
        d="M12 2a9.84 9.84 0 0 0-8.5 14.77L2.05 22l5.37-1.41A9.97 9.97 0 1 0 12 2Zm0 17.98a8 8 0 0 1-4.08-1.12l-.29-.17-3.18.84.85-3.1-.19-.31A7.98 7.98 0 1 1 12 19.98Zm4.38-5.98c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.93-1.19-.71-.64-1.19-1.42-1.33-1.66-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
      ></path>
    </svg>
    <span>{whatsappLabel}</span>
  </a>

  <button
    class="mobile-commercial-bar__action mobile-commercial-bar__action--quote"
    type="button"
    data-mobile-quote-trigger
    data-label={quoteLabel}
    aria-haspopup="dialog"
    aria-controls="cotizacion-drawer"
    aria-expanded="false"
  >
    <svg
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="9" y1="13" x2="15" y2="13"></line>
      <line x1="9" y1="17" x2="15" y2="17"></line>
    </svg>
    <span>{quoteLabel}</span>
  </button>
</nav>

<style>
  .mobile-commercial-bar {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-commercial-bar {
      position: fixed;
      z-index: 190;
      inset: auto 0 0;
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 0.5rem;
      padding: 0.55rem max(0.75rem, env(safe-area-inset-right))
        calc(0.55rem + env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
      background: color-mix(in srgb, var(--white) 96%, transparent);
      border-top: 1px solid var(--border);
      box-shadow: 0 -8px 24px rgba(11, 27, 34, 0.14);
      backdrop-filter: blur(14px);
    }

    .mobile-commercial-bar__action {
      min-height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      border-radius: var(--radius);
      border: 1px solid transparent;
      font-family: var(--font-display);
      font-size: 0.82rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
    }

    .mobile-commercial-bar__action--whatsapp {
      color: #fff;
      background: #168b54;
    }

    .mobile-commercial-bar__action--quote {
      color: var(--white);
      background: var(--t900);
    }

    .mobile-commercial-bar__action:focus-visible {
      outline: 3px solid var(--green);
      outline-offset: 2px;
    }
  }
</style>

<script>
  let mobileCommercialAbort: AbortController | null = null;

  function initMobileCommercialBar() {
    mobileCommercialAbort?.abort();
    mobileCommercialAbort = null;

    const bar = document.querySelector<HTMLElement>('[data-mobile-commercial-bar]');
    if (!bar) return;

    // En fichas de producto, sticky CTA debe conservar contexto de producto.
    // Contexto vive en landing para que funcione también con View Transitions.
    const mobileWhatsapp = bar.querySelector<HTMLAnchorElement>('[data-mobile-whatsapp]');
    const productContext = document.querySelector<HTMLElement>('[data-product-context]');
    if (mobileWhatsapp && productContext) {
      const name = productContext.dataset.productName?.trim();
      const model = productContext.dataset.productModel?.trim();
      const brand = productContext.dataset.productBrand?.trim();
      const productUrl = productContext.dataset.productUrl?.trim();
      const datasheet = productContext.dataset.productDatasheet?.trim();
      if (name && productUrl) {
        const message =
          bar.dataset.locale === 'en'
            ? [
                'Hello, I would like to receive information and a quote for:',
                `Product: ${name}`,
                model ? `Model: ${model}` : '',
                brand ? `Brand: ${brand}` : '',
                `Product page: ${productUrl}`,
                datasheet ? `Datasheet: ${datasheet}` : '',
                '',
                'My name is: ____________________',
                'Institution: ____________________',
                'City/Country: ____________________',
              ]
            : [
                'Hola, me gustaría recibir información y cotización de:',
                `Producto: ${name}`,
                model ? `Referencia: ${model}` : '',
                brand ? `Marca: ${brand}` : '',
                `Página del producto: ${productUrl}`,
                datasheet ? `Ficha técnica: ${datasheet}` : '',
                '',
                'Mi nombre es: ____________________',
                'Institución: ____________________',
                'Ciudad/país: ____________________',
              ];
        mobileWhatsapp.href = `https://wa.me/573137247353?text=${encodeURIComponent(message.filter(Boolean).join('\n'))}`;
      }
    }

    mobileCommercialAbort = new AbortController();
    const trigger = bar.querySelector<HTMLButtonElement>('[data-mobile-quote-trigger]');
    const label = trigger?.dataset.label ?? '';
    trigger?.setAttribute('aria-label', label);
    trigger?.addEventListener(
      'click',
      () => {
        void import('../lib/cotizacion-equipos').then(({ abrirCotizacion }) => {
          abrirCotizacion();
        });
      },
      { signal: mobileCommercialAbort.signal }
    );
  }

  document.addEventListener('astro:page-load', initMobileCommercialBar);
  initMobileCommercialBar();
</script>
