---
/**
 * Formulario progresivo B2B para landings consultivas.
 * Persiste el lead, clasifica P1/P2/P3 y luego abre WhatsApp contextual.
 */
import type { Locale } from '../i18n/utils';
import type { CampaignLandingId } from '../lib/comercial-leads';
import type { CampaignOption } from '../data/comercial-landings';

interface Props {
  locale: Locale;
  campaign: CampaignLandingId;
  familiaSlug: string;
  tipoSlug?: string;
  primaryCta: string;
  projectOptions: CampaignOption[];
  formId?: string;
}

const {
  locale,
  campaign,
  familiaSlug,
  tipoSlug = '',
  primaryCta,
  projectOptions,
  formId = 'lead-qualification-form',
} = Astro.props;

const isEn = locale === 'en';
const privacyHref = isEn ? '/en/legal/privacy/' : '/es/legal/privacidad/';
const habeasHref = isEn ? '/en/legal/data-authorization/' : '/es/legal/habeas-data/';
const turnstileSiteKey = (
  (import.meta.env['PUBLIC_TURNSTILE_SITE_KEY'] as string | undefined) ?? ''
).trim();
---

<form
  id={formId}
  class="lqf"
  novalidate
  data-locale={locale}
  data-campaign={campaign}
  data-familia={familiaSlug}
  data-tipo={tipoSlug}
  data-turnstile-site-key={turnstileSiteKey}
  aria-label={isEn ? 'Project evaluation form' : 'Formulario de evaluación de proyecto'}
>
  <input type="hidden" name="familia_slug" value={familiaSlug} />
  <input type="hidden" name="tipo_slug" value={tipoSlug} />
  <input type="hidden" name="campaign" value={campaign} />
  <label class="lqf-honeypot" aria-hidden="true">
    Website
    <input name="website" type="text" tabindex="-1" autocomplete="off" />
  </label>

  <fieldset class="lqf-step" data-step="1">
    <legend class="lqf-legend"
      >{isEn ? '1 · Who is writing to us?' : '1 · ¿Quién nos escribe?'}</legend
    >

    <div class="lqf-grid">
      <div class="lqf-field">
        <label for={`${formId}-nombre`}
          >{isEn ? 'Name' : 'Nombre'} <span class="req" aria-hidden="true">*</span></label
        >
        <input id={`${formId}-nombre`} name="nombre" type="text" autocomplete="name" required />
      </div>
      <div class="lqf-field">
        <label for={`${formId}-cargo`}>{isEn ? 'Role' : 'Cargo'}</label>
        <input
          id={`${formId}-cargo`}
          name="cargo"
          type="text"
          autocomplete="organization-title"
          placeholder={isEn ? 'Procurement, biomedical…' : 'Compras, biomédica…'}
        />
      </div>
      <div class="lqf-field">
        <label for={`${formId}-institucion`}
          >{isEn ? 'Institution' : 'Institución'}
          <span class="req" aria-hidden="true">*</span></label
        >
        <input
          id={`${formId}-institucion`}
          name="institucion"
          type="text"
          autocomplete="organization"
          required
        />
      </div>
      <div class="lqf-field">
        <label for={`${formId}-ciudad`}
          >{isEn ? 'City' : 'Ciudad'} <span class="req" aria-hidden="true">*</span></label
        >
        <input
          id={`${formId}-ciudad`}
          name="ciudad"
          type="text"
          autocomplete="address-level2"
          required
        />
      </div>
      <div class="lqf-field">
        <label for={`${formId}-telefono`}>{isEn ? 'Phone' : 'Teléfono'}</label>
        <input
          id={`${formId}-telefono`}
          name="telefono"
          type="tel"
          autocomplete="tel"
          placeholder="+57 …"
        />
      </div>
      <div class="lqf-field">
        <label for={`${formId}-email`}>{isEn ? 'Email' : 'Correo'}</label>
        <input id={`${formId}-email`} name="email" type="email" autocomplete="email" />
      </div>
    </div>
    <p class="lqf-hint">
      {isEn ? 'Provide at least phone or email.' : 'Indica al menos teléfono o correo.'}
    </p>
    <button type="button" class="btn btn-primary lqf-next" data-next>
      {isEn ? 'Continue' : 'Continuar'}
    </button>
  </fieldset>

  <fieldset class="lqf-step is-hidden" data-step="2" hidden>
    <legend class="lqf-legend"
      >{isEn ? '2 · Tell us about the project' : '2 · Cuéntenos del proyecto'}</legend
    >

    <div class="lqf-grid">
      <div class="lqf-field lqf-field--full">
        <label for={`${formId}-tipo_proyecto`}
          >{isEn ? 'Project type' : 'Tipo de proyecto'}
          <span class="req" aria-hidden="true">*</span></label
        >
        <select id={`${formId}-tipo_proyecto`} name="tipo_proyecto" required class="lqf-select">
          <option value="">{isEn ? 'Select…' : 'Selecciona…'}</option>
          {projectOptions.map(opt => <option value={opt.value}>{opt.label}</option>)}
        </select>
      </div>
      <div class="lqf-field">
        <label for={`${formId}-horizonte`}
          >{isEn ? 'Purchase horizon' : 'Horizonte de compra'}
          <span class="req" aria-hidden="true">*</span></label
        >
        <select id={`${formId}-horizonte`} name="horizonte" required class="lqf-select">
          <option value="">{isEn ? 'Select…' : 'Selecciona…'}</option>
          <option value="0-3">{isEn ? '0–3 months' : '0–3 meses'}</option>
          <option value="4-12">{isEn ? '4–12 months' : '4–12 meses'}</option>
          <option value="exploracion">{isEn ? 'Early exploration' : 'Exploración temprana'}</option>
        </select>
      </div>
      <div class="lqf-field">
        <label for={`${formId}-presupuesto`}
          >{isEn ? 'Budget / financing' : 'Presupuesto / financiación'}</label
        >
        <select id={`${formId}-presupuesto`} name="presupuesto_estado" class="lqf-select">
          <option value="">{isEn ? 'Select…' : 'Selecciona…'}</option>
          <option value="definido">{isEn ? 'Budget defined' : 'Presupuesto definido'}</option>
          <option value="financiacion"
            >{isEn ? 'Exploring financing' : 'Buscando financiación'}</option
          >
          <option value="no_definido">{isEn ? 'Not defined yet' : 'Aún no definido'}</option>
        </select>
      </div>
      <div class="lqf-field lqf-field--full">
        <label for={`${formId}-necesidad`}
          >{isEn ? 'Concrete need' : 'Necesidad concreta'}
          <span class="req" aria-hidden="true">*</span></label
        >
        <textarea
          id={`${formId}-necesidad`}
          name="necesidad"
          rows="3"
          required
          placeholder={isEn
            ? 'E.g. second OR tower upgrade to 4K…'
            : 'Ej. segunda sala, upgrade a 4K, autoclave 400 L…'}></textarea>
      </div>
    </div>

    <div class="lqf-consent">
      <label>
        <input type="checkbox" name="consentimiento" value="1" required />
        <span>
          {
            isEn ? (
              <>
                I authorize contact regarding this project, per the{' '}
                <a href={privacyHref} target="_blank" rel="noopener noreferrer">
                  privacy policy
                </a>{' '}
                and{' '}
                <a href={habeasHref} target="_blank" rel="noopener noreferrer">
                  habeas data authorization
                </a>
                .
              </>
            ) : (
              <>
                Autorizo el contacto sobre este proyecto, conforme a la{' '}
                <a href={privacyHref} target="_blank" rel="noopener noreferrer">
                  política de privacidad
                </a>{' '}
                y la{' '}
                <a href={habeasHref} target="_blank" rel="noopener noreferrer">
                  autorización de habeas data
                </a>
                .
              </>
            )
          }
        </span>
      </label>
    </div>

    <div class="lqf-actions">
      <button type="button" class="btn btn-secondary lqf-back" data-back>
        {isEn ? 'Back' : 'Volver'}
      </button>
      <button type="submit" class="btn btn-primary" data-submit>
        {primaryCta}
      </button>
    </div>
    <div class="lqf-turnstile" data-turnstile></div>
  </fieldset>

  <div class="lqf-status" role="status" aria-live="polite" data-status></div>
  <a
    class="lqf-whatsapp-fallback"
    data-whatsapp-fallback
    hidden
    target="_blank"
    rel="noopener noreferrer"
  >
    {isEn ? 'Open WhatsApp' : 'Abrir WhatsApp'}
  </a>
</form>

<style>
  .lqf {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .lqf-step {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.6rem 1.85rem;
    background: var(--white);
    margin: 0;
  }
  .lqf-step.is-hidden {
    display: none;
  }
  .lqf-legend {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--t900);
    padding: 0 0.35rem;
  }
  .lqf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
    margin-block: 1.35rem;
  }
  @media (min-width: 720px) {
    .lqf-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.25rem;
      row-gap: 1.15rem;
    }
    .lqf-field--full {
      grid-column: 1 / -1;
    }
  }
  .lqf-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .lqf-field label {
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-display);
    color: var(--ink);
  }
  .req {
    color: #c0392b;
  }
  .lqf-field input,
  .lqf-field textarea,
  .lqf-select {
    border: 1px solid var(--border-mid);
    border-radius: var(--radius);
    padding: 0.8rem 1rem;
    font: inherit;
    color: var(--text);
    background: var(--white);
    width: 100%;
    min-height: 48px;
  }
  .lqf-field textarea {
    min-height: 6.5rem;
  }
  .lqf-field input:focus,
  .lqf-field textarea:focus,
  .lqf-select:focus {
    outline: 2px solid var(--t800);
    outline-offset: 2px;
  }
  .lqf-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }
  .lqf-consent {
    margin: 0.25rem 0 1.25rem;
  }
  .lqf-consent label {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.82rem;
    color: var(--text-mid);
    line-height: 1.5;
    cursor: pointer;
  }
  .lqf-consent input {
    margin-top: 0.2rem;
    accent-color: var(--t900);
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .lqf-consent a {
    color: var(--t900);
    text-decoration: underline;
  }
  .lqf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .lqf-actions .btn {
    min-height: 48px;
  }
  .lqf-status {
    min-height: 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .lqf-status.is-ok {
    color: #2a7d1e;
  }
  .lqf-status.is-err {
    color: #c0392b;
  }
  .lqf-field.is-invalid input,
  .lqf-field.is-invalid textarea,
  .lqf-field.is-invalid select {
    border-color: #c0392b;
  }
  .lqf-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .lqf-turnstile {
    margin-top: 1rem;
  }
  .lqf-turnstile:empty {
    display: none;
  }
  .lqf-whatsapp-fallback {
    align-self: flex-start;
    color: var(--t900);
    font-weight: 700;
    text-decoration: underline;
  }
</style>

<script>
  import {
    captureCommercialAttribution,
    rememberCommercialLead,
  } from '../lib/commercial-attribution';
  import {
    buildWhatsAppUrl,
    classifyLead,
    slaForPriority,
    validateCommercialLead,
    type CommercialLeadInput,
    type HorizonteCompra,
  } from '../lib/comercial-leads';
  import { interpretarErrorEdgeFunction } from '../lib/cotizacion-submit';
  import { getSupabaseClient } from '../lib/supabase';

  interface TurnstileApi {
    render: (container: HTMLElement, options: Record<string, unknown>) => string;
    reset: (id?: string) => void;
  }

  interface LeadResponse {
    ok?: boolean;
    leadId?: string;
    priority?: 'P1' | 'P2' | 'P3';
    crmSyncStatus?: string;
    error?: string;
    emails?: { interno?: boolean; cliente?: boolean };
  }

  let turnstileLoaded: Promise<void> | null = null;
  const turnstileTokens = new WeakMap<HTMLFormElement, string>();
  const turnstileWidgets = new WeakMap<HTMLFormElement, string>();

  function loadTurnstile(): Promise<void> {
    if ((window as Window & { turnstile?: TurnstileApi }).turnstile) return Promise.resolve();
    if (turnstileLoaded) return turnstileLoaded;
    turnstileLoaded = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('turnstile load error'));
      document.head.appendChild(script);
    });
    return turnstileLoaded;
  }

  async function ensureTurnstile(form: HTMLFormElement): Promise<string | undefined> {
    const sitekey = form.dataset.turnstileSiteKey?.trim();
    if (!sitekey) return undefined;
    const container = form.querySelector<HTMLElement>('[data-turnstile]');
    if (!container) return undefined;
    await loadTurnstile();
    const api = (window as Window & { turnstile?: TurnstileApi }).turnstile;
    if (!api) return undefined;
    if (!turnstileWidgets.has(form)) {
      const widget = api.render(container, {
        sitekey,
        size: 'flexible',
        callback: (token: string) => turnstileTokens.set(form, token),
        'expired-callback': () => turnstileTokens.delete(form),
        'error-callback': () => turnstileTokens.delete(form),
      });
      turnstileWidgets.set(form, widget);
    }
    return turnstileTokens.get(form);
  }

  function newIdempotencyKey(): string {
    if (typeof window.crypto?.randomUUID === 'function') return window.crypto.randomUUID();
    return `${Date.now()}_${Math.random().toString(36).slice(2)}_${Math.random().toString(36).slice(2)}`;
  }

  function initForm(form: HTMLFormElement) {
    if (form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const locale = (form.dataset.locale === 'en' ? 'en' : 'es') as 'es' | 'en';
    const step1 = form.querySelector<HTMLElement>('[data-step="1"]');
    const step2 = form.querySelector<HTMLElement>('[data-step="2"]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]');
    const backBtn = form.querySelector<HTMLButtonElement>('[data-back]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const whatsappFallback = form.querySelector<HTMLAnchorElement>('[data-whatsapp-fallback]');
    let enviando = false;

    function showStatus(message: string, kind: 'ok' | 'err' | null) {
      if (!status) return;
      status.className = kind ? `lqf-status is-${kind}` : 'lqf-status';
      status.textContent = message;
      if (message) status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function showStep(n: 1 | 2) {
      if (!step1 || !step2) return;
      const first = n === 1;
      step1.hidden = !first;
      step2.hidden = first;
      step1.classList.toggle('is-hidden', !first);
      step2.classList.toggle('is-hidden', first);
      if (n === 2) {
        void ensureTurnstile(form).catch(() => undefined);
      }
    }

    function read(): Partial<CommercialLeadInput> {
      const fd = new FormData(form);
      return {
        nombre: String(fd.get('nombre') ?? ''),
        cargo: String(fd.get('cargo') ?? ''),
        institucion: String(fd.get('institucion') ?? ''),
        ciudad: String(fd.get('ciudad') ?? ''),
        telefono: String(fd.get('telefono') ?? ''),
        email: String(fd.get('email') ?? ''),
        familia_slug: String(fd.get('familia_slug') ?? form.dataset.familia ?? ''),
        tipo_slug: String(fd.get('tipo_slug') ?? form.dataset.tipo ?? ''),
        tipo_proyecto: String(fd.get('tipo_proyecto') ?? ''),
        horizonte: String(fd.get('horizonte') ?? '') as HorizonteCompra,
        presupuesto_estado: String(fd.get('presupuesto_estado') ?? ''),
        necesidad: String(fd.get('necesidad') ?? ''),
        consentimiento: fd.get('consentimiento') === '1',
        campaign: (form.dataset.campaign ?? 'proyectos') as CommercialLeadInput['campaign'],
        locale,
      };
    }

    nextBtn?.addEventListener('click', () => {
      const data = read();
      const step1Check = validateCommercialLead({
        ...data,
        tipo_proyecto: 'pending',
        horizonte: 'exploracion',
        necesidad: 'pending',
        consentimiento: true,
      });
      const keys = ['nombre', 'institucion', 'ciudad', 'contacto', 'email'] as const;
      const blocked = keys.some(k => step1Check.errors[k]);
      if (status) {
        status.className = 'lqf-status';
        status.textContent = '';
      }
      if (blocked) {
        showStatus(
          step1Check.errors.contacto ||
            step1Check.errors.email ||
            step1Check.errors.institucion ||
            step1Check.errors.nombre ||
            step1Check.errors.ciudad ||
            (locale === 'en' ? 'Complete step 1.' : 'Completa el paso 1.'),
          'err'
        );
        return;
      }
      showStep(2);
    });

    backBtn?.addEventListener('click', () => showStep(1));

    form.addEventListener('submit', async e => {
      e.preventDefault();
      if (enviando) return;
      const data = read();
      const result = validateCommercialLead(data);
      if (!result.valid || !data.horizonte || !data.nombre || !data.institucion) {
        showStatus(Object.values(result.errors)[0] ?? 'Error', 'err');
        return;
      }

      const lead = data as CommercialLeadInput;
      const url = buildWhatsAppUrl(lead);
      const supabase = getSupabaseClient();
      if (!supabase) {
        showStatus(
          locale === 'en'
            ? 'The request service is unavailable. Please try again.'
            : 'El servicio de solicitudes no está disponible. Intenta de nuevo.',
          'err'
        );
        return;
      }

      const sitekey = form.dataset.turnstileSiteKey?.trim();
      const turnstileToken = await ensureTurnstile(form).catch(() => undefined);
      if (sitekey && !turnstileToken) {
        showStatus(
          locale === 'en'
            ? 'Complete the security verification.'
            : 'Completa la verificación de seguridad.',
          'err'
        );
        return;
      }

      form.dataset.idempotencyKey ||= newIdempotencyKey();
      const attribution = captureCommercialAttribution(lead.campaign);
      const originalSubmitText = submitBtn?.textContent ?? '';
      enviando = true;
      showStatus(locale === 'en' ? 'Saving request…' : 'Registrando solicitud…', null);
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = locale === 'en' ? 'Saving…' : 'Registrando…';
      }
      if (whatsappFallback) whatsappFallback.hidden = true;

      try {
        const { data: response, error } = await supabase.functions.invoke(
          'registrar-lead-comercial',
          {
            body: {
              ...lead,
              ...attribution,
              website: String(new FormData(form).get('website') ?? ''),
              idempotencyKey: form.dataset.idempotencyKey,
              turnstileToken,
            },
          }
        );
        const saved = response as LeadResponse | null;
        if (error || !saved?.ok || !saved.leadId) {
          const edgeError = saved?.error?.trim()
            ? saved.error
            : await interpretarErrorEdgeFunction(error, response);
          showStatus(
            edgeError ||
              (locale === 'en'
                ? 'We could not register the request. Nothing was marked as received; please try again.'
                : 'No pudimos registrar la solicitud. No quedó marcada como recibida; intenta de nuevo.'),
            'err'
          );
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalSubmitText;
          }
          const widget = turnstileWidgets.get(form);
          if (widget) {
            (window as Window & { turnstile?: TurnstileApi }).turnstile?.reset(widget);
            turnstileTokens.delete(form);
          }
          return;
        }

        rememberCommercialLead(saved.leadId, lead.campaign);
        const priority = saved.priority ?? classifyLead(lead.horizonte);
        let successMessage = slaForPriority(priority, locale);
        if (saved.emails?.cliente) {
          successMessage +=
            locale === 'en'
              ? ' We sent a confirmation to your email.'
              : ' Enviamos confirmación a tu correo.';
        } else if (saved.emails?.interno) {
          successMessage +=
            locale === 'en'
              ? ' Our commercial team was notified by email.'
              : ' Nuestro equipo comercial recibió aviso por correo.';
        }
        showStatus(successMessage, 'ok');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = locale === 'en' ? 'Request saved' : 'Solicitud registrada';
        }
        const popup = window.open(url, '_blank', 'noopener,noreferrer');
        if (whatsappFallback) {
          whatsappFallback.href = url;
          whatsappFallback.hidden = popup !== null;
        }
      } finally {
        enviando = false;
      }
    });
  }

  function boot() {
    document.querySelectorAll<HTMLFormElement>('form.lqf').forEach(initForm);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
