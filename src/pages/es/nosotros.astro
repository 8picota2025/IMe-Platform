---
import Layout from '../../layouts/Layout.astro';
import {
  buildCanonical,
  buildPageTitle,
  buildOrganizationJsonLd,
  combineJsonLd,
  getInstitutionalOgImage,
} from '../../lib/seo';
import '../../styles/site-faithful.css';

const locale = 'es';
const title = buildPageTitle('Nosotros');
const description =
  'Conoce la historia de I-ME International Medical Enterprise: más de 15 años en el sector salud, 24+ marcas internacionales y un portafolio de más de 427 productos.';
const canonical = buildCanonical('/es/nosotros');

const jsonLd = combineJsonLd(buildOrganizationJsonLd(), {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: canonical,
  name: 'Nosotros | I-ME',
  about: { '@id': 'https://i-me.com.co/#organization' },
  inLanguage: 'es-CO',
});
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath="/es/nosotros"
  ogImage={getInstitutionalOgImage()}
  jsonLd={jsonLd}
>
  <div class="site-faithful">
    <header class="page-hero" aria-labelledby="about-h1">
      <div class="container">
        <nav class="breadcrumb" aria-label="Ruta">
          <a href="/es/">Inicio</a><span class="sep">/</span><span aria-current="page"
            >Nosotros</span
          >
        </nav>
        <h1 id="about-h1">Nuestra historia</h1>
        <p class="ph-sub">
          De los grandes proyectos de construcción en Centroamérica a convertirnos en un aliado
          confiable del sector salud, con más de 15 años representando fabricantes internacionales
          de equipos médicos.
        </p>
      </div>
    </header>

    <!-- Historia: origen -->
    <section class="section" aria-labelledby="historia-h2">
      <div class="container">
        <div class="about-grid">
          <div class="about-imgs fade-in">
            <div class="about-img-main">
              <img
                src="/assets/img/proyectos-inicio-a-fin-biomedicos.webp"
                alt="Proyectos biomédicos de inicio a fin - I-ME construcción healthcare"
                width="1400"
                height="787"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
          <div class="about-text fade-in d2">
            <div class="s-label">El origen</div>
            <h2 id="historia-h2" class="s-title">Una historia que comenzó dentro de un hospital</h2>
            <p>
              I-ME nació de la visión y experiencia de un grupo de empresarios con una sólida
              trayectoria en negocios internacionales, que durante más de 20 años lideraron
              importantes empresas constructoras en Centroamérica, participando en proyectos de gran
              impacto para la región.
            </p>
            <p>
              Nuestro vínculo con el sector salud comenzó precisamente con la remodelación de un
              hospital. Gracias a la excelencia en la ejecución del proyecto, el fondo de inversión
              propietario confió a nuestros fundadores la administración de la institución: una
              experiencia que nos permitió desarrollar un profundo conocimiento del entorno
              hospitalario y construir relaciones de confianza con reconocidos fabricantes
              internacionales de equipos médicos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Historia: crecimiento -->
    <section class="section section-off" aria-labelledby="crecimiento-h2">
      <div class="container">
        <div class="about-grid" style="direction:rtl">
          <div class="about-imgs fade-in">
            <div class="about-img-main">
              <img
                src="/assets/img/atendemos-cadena-valor-distribucion.webp"
                alt="Atendemos cadena valor - Distribución equipos biomédicos Colombia"
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <div class="about-text fade-in d2" style="direction:ltr">
            <div class="s-label">El crecimiento</div>
            <h2 id="crecimiento-h2" class="s-title">
              De la confianza de las casas matrices a un portafolio global
            </h2>
            <p>
              Derivado de ese compromiso, profesionalismo y ética empresarial, diversas casas
              matrices nos otorgaron la representación y distribución de sus marcas, dando origen al
              crecimiento de nuestra compañía.
            </p>
            <p>
              Hoy contamos con más de 15 años de experiencia en el sector salud, representando más
              de 24 marcas internacionales provenientes de Europa, Estados Unidos y Asia —de países
              como Alemania, Italia, Reino Unido, Japón, Corea del Sur, China, Hong Kong y Hungría,
              entre otros— con un portafolio que supera los 427 productos, respaldados por altos
              estándares de calidad y servicio.
            </p>
            <p>
              Creemos que el verdadero éxito se construye mediante relaciones sólidas y duraderas
              con nuestros socios estratégicos. Esa confianza, unida a nuestro compromiso con la
              innovación, la capacitación continua y la excelencia, nos ha permitido consolidarnos
              como un aliado confiable para el sector salud y seguir creciendo con una visión de
              largo plazo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cifras -->
    <section class="section section-teal" aria-labelledby="cifras-h2">
      <div class="container">
        <div class="s-header s-header-center fade-in">
          <div class="s-label s-label-white">I-ME en cifras</div>
          <h2 id="cifras-h2" class="s-title s-title-white">
            Un aliado consolidado para el sector salud
          </h2>
        </div>
        <div class="cobertura-stats fade-in d2">
          <div class="cobertura-stat">
            <div class="stat-n">15+</div>
            <div class="stat-l">Años en el sector salud</div>
          </div>
          <div class="cobertura-stat">
            <div class="stat-n">24+</div>
            <div class="stat-l">Marcas internacionales</div>
          </div>
          <div class="cobertura-stat">
            <div class="stat-n">427+</div>
            <div class="stat-l">Productos en portafolio</div>
          </div>
          <div class="cobertura-stat">
            <div class="stat-n">32</div>
            <div class="stat-l">Departamentos cubiertos</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Visión, misión y valores -->
    <section class="section" aria-labelledby="valores-h2">
      <div class="container">
        <div class="s-header s-header-center fade-in">
          <div class="s-label">Lo que nos guía</div>
          <h2 id="valores-h2" class="s-title">Visión, misión y compromiso</h2>
        </div>
        <div class="values-grid">
          <div class="val-card fade-in">
            <div class="val-icon"><i class="fas fa-eye" aria-hidden="true"></i></div>
            <h3>Visión</h3>
            <p>
              Ser la empresa líder en Colombia en distribución de tecnología biomédica de
              vanguardia.
            </p>
          </div>
          <div class="val-card fade-in d1">
            <div class="val-icon"><i class="fas fa-bullseye" aria-hidden="true"></i></div>
            <h3>Misión</h3>
            <p>
              Equipar las instituciones de salud con tecnología certificada que mejore la atención
              al paciente.
            </p>
          </div>
          <div class="val-card fade-in d2">
            <div class="val-icon"><i class="fas fa-award" aria-hidden="true"></i></div>
            <h3>Calidad</h3>
            <p>Todos nuestros equipos cuentan con certificaciones CE, FDA e INVIMA vigentes.</p>
          </div>
          <div class="val-card fade-in d3">
            <div class="val-icon"><i class="fas fa-handshake" aria-hidden="true"></i></div>
            <h3>Compromiso</h3>
            <p>Soporte técnico especializado durante toda la vida útil de cada equipo.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA contacto -->
    <section class="section section-off" aria-label="Contacto directo">
      <div class="container">
        <div class="cta-block fade-in">
          <div class="s-label s-label-white">Hablemos</div>
          <h2 class="cta-title">¿Listo para trabajar con nosotros?</h2>
          <p class="cta-sub">
            Escríbanos y reciba respuesta comercial directa: <a
              href="tel:+573138674059"
              style="color:inherit">+57 313 867 4059</a
            > · <a href="mailto:info@i-me.com.co" style="color:inherit">info@i-me.com.co</a>
          </p>
          <div class="cta-btns">
            <a
              href="https://wa.me/573138674059?text=Hola%2C%20me%20interesa%20conocer%20m%C3%A1s%20sobre%20I-ME"
              target="_blank"
              rel="noopener"
              class="btn btn-green"
            >
              <i class="fab fa-whatsapp"></i> Escribir por WhatsApp
            </a>
            <a href="/es/contacto" class="btn btn-outline-white">Formulario de contacto</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .site-faithful .cobertura-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
    max-width: 900px;
    margin: 48px auto 0;
    text-align: center;
  }
  .site-faithful .cobertura-stat .stat-n {
    font-size: 2.6rem;
  }
</style>

<script>
  function initNosotros() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const faders = document.querySelectorAll<HTMLElement>(
      '.site-faithful .fade-in:not([data-ime-bound])'
    );
    faders.forEach(el => (el.dataset.imeBound = '1'));
    if (reduce || !('IntersectionObserver' in window)) {
      faders.forEach(el => el.classList.add('visible'));
      return;
    }
    const io = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    faders.forEach(el => io.observe(el));
  }

  initNosotros();
  document.addEventListener('astro:page-load', initNosotros);
</script>
