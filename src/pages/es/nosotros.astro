---
import Layout from '../../layouts/Layout.astro';
import {
  buildCanonical,
  buildPageTitle,
  buildOrganizationJsonLd,
  combineJsonLd,
  getInstitutionalOgImage,
} from '../../lib/seo';
import '../../styles/site-faithful.css';

const locale = 'es';
const title = buildPageTitle('I-ME International Medical Enterprise | Quiénes somos');
const description =
  'I-ME International Medical Enterprise (IME): distribuidor biomédico en Colombia con INVIMA, soporte técnico, importación y financiamiento para hospitales y clínicas.';
const canonical = buildCanonical('/es/nosotros');

const jsonLd = combineJsonLd(buildOrganizationJsonLd(), {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: canonical,
  name: 'Quiénes somos | I-ME',
  about: { '@id': 'https://i-me.com.co/#organization' },
  inLanguage: 'es-CO',
});

const perspectivas = [
  'la necesidad clínica y hospitalaria',
  'la tecnología disponible',
  'la viabilidad técnica',
  'la infraestructura necesaria',
  'las alternativas de adquisición e importación',
  'la logística y distribución',
  'la viabilidad económica y financiera',
  'el marco contractual y regulatorio',
  'las personas necesarias para hacerlo realidad',
];

const propuesta = [
  'Selección y distribución de tecnología biomédica.',
  'Identificación de fabricantes y soluciones internacionales.',
  'Asesoría técnica especializada antes de la adquisición.',
  'Acompañamiento en proyectos hospitalarios y tecnológicos.',
  'Importación, logística y distribución.',
  'Instalación y puesta en marcha.',
  'Capacitación y acompañamiento al usuario.',
  'Soporte técnico y mantenimiento durante la vida útil del equipamiento.',
  'Evaluación de alternativas económicas y comerciales.',
  'Utilización de tecnología e inteligencia artificial para mejorar progresivamente nuestros procesos de asesoramiento y atención.',
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath="/es/nosotros"
  ogImage={getInstitutionalOgImage()}
  jsonLd={jsonLd}
>
  <div class="site-faithful">
    <header class="hero-nosotros" aria-labelledby="about-h1">
      <div class="container">
        <nav class="breadcrumb" aria-label="Ruta">
          <a href="/es/">Inicio</a><span class="sep">/</span><span aria-current="page"
            >Quiénes somos</span
          >
        </nav>
        <div class="hero-content">
          <h1 id="about-h1" class="hero-title">Quiénes somos</h1>
          <p class="hero-subtitle">
            Tecnología, experiencia y capacidad de ejecución al servicio de la salud
          </p>
        </div>
      </div>
    </header>

    <section class="section section-origin" aria-labelledby="intro-h2">
      <div class="container">
        <div class="story-layout">
          <div class="story-text">
            <div class="story-badge">I-ME</div>
            <h2 id="intro-h2" class="story-title">
              Tecnología biomédica y soluciones para instituciones de salud
            </h2>
            <div class="story-image">
              <div class="image-wrapper">
                <img
                  src="/assets/img/proyectos-inicio-a-fin-biomedicos.webp"
                  alt="Proyectos biomédicos de inicio a fin — I-ME"
                  width="1400"
                  height="787"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
            <div class="story-body">
              <p>
                I-ME International Medical Enterprise es una empresa colombiana especializada en
                tecnología biomédica y soluciones para instituciones de salud.
              </p>
              <p>
                Nuestra actividad va más allá de la distribución de equipos. Trabajamos para ayudar
                a hospitales, clínicas, centros médicos y profesionales de la salud a identificar,
                evaluar e implementar soluciones tecnológicas adecuadas a sus necesidades clínicas,
                técnicas, operativas y financieras.
              </p>
              <p>
                Distribución, importación, ingeniería, tecnología, gestión hospitalaria y desarrollo
                empresarial convergen en un mismo proyecto: hacer más accesible la tecnología médica
                de calidad y acompañar a nuestros clientes durante todo su ciclo de vida.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-growth" aria-labelledby="mas-h2">
      <div class="container">
        <div class="story-layout story-layout-reverse">
          <div class="story-text">
            <div class="story-badge story-badge-green">Enfoque</div>
            <h2 id="mas-h2" class="story-title">Más que equipamiento biomédico</h2>
            <div class="story-image">
              <div class="image-wrapper">
                <img
                  src="/assets/img/atendemos-cadena-valor-distribucion.webp"
                  alt="Cadena de valor en distribución de equipos biomédicos — I-ME"
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="story-body">
              <p>
                Entendemos que una decisión tecnológica en salud nunca consiste únicamente en elegir
                un equipo.
              </p>
              <p>
                Detrás de cada proyecto existen necesidades clínicas, infraestructura, financiación,
                regulación, logística, instalación, capacitación, mantenimiento y soporte. Por ello,
                I-ME aborda cada oportunidad desde una perspectiva integral.
              </p>
              <p>
                Nuestro objetivo es convertirnos en un socio tecnológico de largo plazo para las
                instituciones de salud, combinando conocimiento del mercado, capacidad técnica,
                experiencia empresarial y una creciente infraestructura digital.
              </p>
              <p>
                Esta visión se sustenta especialmente en la experiencia multidisciplinar de nuestro
                equipo de dirección y gestión.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-team" aria-labelledby="equipo-h2">
      <div class="container">
        <div class="team-header">
          <div class="story-badge">Liderazgo</div>
          <h2 id="equipo-h2" class="story-title">
            Un equipo directivo con experiencia para ejecutar proyectos complejos
          </h2>
          <p class="team-lead">
            Una de las principales fortalezas de I-ME es reunir perfiles profesionales procedentes
            de disciplinas diferentes pero profundamente complementarias. La dirección de la
            compañía integra experiencia en construcción y gestión hospitalaria, ingeniería
            informática y telecomunicaciones, importación y distribución, desarrollo comercial,
            psicología y gestión del talento, finanzas, contabilidad y derecho.
          </p>
          <p class="team-lead">
            Esta combinación permite analizar cada proyecto desde múltiples perspectivas antes de
            convertirlo en una solución.
          </p>
        </div>

        <div class="team-grid">
          <article class="team-card">
            <h3>Dirección General</h3>
            <p class="team-role">Experiencia empresarial, construcción y gestión hospitalaria</p>
            <p>
              La Dirección General de I-ME está liderada por un empresario con más de 25 años de
              trayectoria profesional, particularmente vinculada a la construcción, el desarrollo de
              proyectos y la gestión hospitalaria.
            </p>
            <p>
              Esta experiencia proporciona a la compañía una comprensión que trasciende el propio
              equipamiento médico: permite entender cómo interactúan infraestructura, tecnología,
              operación, recursos económicos y necesidades asistenciales dentro de una institución
              de salud.
            </p>
            <p>
              Esa visión global resulta especialmente relevante en proyectos hospitalarios donde una
              solución técnicamente excelente solo genera valor cuando puede integrarse
              correctamente en la realidad operativa de la institución.
            </p>
          </article>

          <article class="team-card">
            <h3>Dirección de Tecnología</h3>
            <p class="team-role">Ingeniería aplicada a problemas reales de negocio</p>
            <p>
              La Dirección de Tecnología está encabezada por un ingeniero informático con una
              extensa trayectoria profesional en telecomunicaciones, sistemas, innovación y
              consultoría tecnológica.
            </p>
            <p>
              A lo largo de su carrera ha participado en la puesta en marcha de cientos de
              iniciativas y en la resolución de miles de retos empresariales mediante la aplicación
              práctica de tecnologías avanzadas.
            </p>
            <p>
              Su incorporación al proyecto I-ME permite trasladar esa experiencia al sector
              biomédico y desarrollar una compañía en la que la tecnología no constituye únicamente
              una herramienta interna, sino una capacidad estratégica.
            </p>
            <p>
              Automatización, inteligencia artificial, integración de sistemas, gestión del
              conocimiento, análisis de información y desarrollo de plataformas digitales forman
              parte de una estrategia destinada a conseguir que I-ME pueda responder de manera más
              rápida, precisa y eficiente a las necesidades de sus clientes.
            </p>
          </article>

          <article class="team-card">
            <h3>Dirección Comercial</h3>
            <p class="team-role">Experiencia nacional en importación, distribución y ejecución</p>
            <p>
              La Dirección Comercial aporta una amplia trayectoria como importador y distribuidor de
              equipamiento industrial y tecnológico, así como experiencia en el desarrollo y
              ejecución de proyectos de considerable envergadura en diferentes regiones de Colombia.
            </p>
            <p>
              Este conocimiento resulta fundamental para comprender la realidad del mercado
              colombiano: proveedores, negociación internacional, importación, logística,
              distribución territorial, estructuración comercial y ejecución efectiva de proyectos.
            </p>
            <p>
              Nuestra capacidad comercial no se limita, por tanto, a vender tecnología. Está
              orientada a conseguir que las soluciones puedan llegar efectivamente hasta las
              instituciones que las necesitan.
            </p>
          </article>

          <article class="team-card">
            <h3>Dirección de Recursos Humanos</h3>
            <p class="team-role">Las personas como parte de la estrategia</p>
            <p>
              Nuestra Dirección de Recursos Humanos está liderada por una psicóloga con una extensa
              trayectoria en gestión del talento humano, desarrollo personal y acompañamiento
              psicológico.
            </p>
            <p>
              Su experiencia profesional combina la construcción y consolidación de equipos con una
              profunda vocación por el desarrollo de las personas, actividad que mantiene
              paralelamente mediante su práctica profesional en psicología y el acompañamiento de
              situaciones personales de especial complejidad.
            </p>
            <p>
              Esta perspectiva aporta a I-ME una dimensión especialmente importante: detrás de
              cualquier organización, tecnología o proyecto siempre existen personas. Construir una
              empresa capaz de crecer de manera sostenible requiere seleccionar talento, desarrollar
              capacidades, consolidar equipos y crear una cultura basada en responsabilidad,
              aprendizaje y compromiso.
            </p>
          </article>

          <article class="team-card team-card-wide">
            <h3>Dirección Financiera y Legal</h3>
            <p class="team-role">Rigor para proyectos de alta complejidad</p>
            <p>
              La responsabilidad financiera y legal está dirigida por un profesional con formación
              como abogado y contador público, y una dilatada experiencia en la gestión financiera,
              contable, jurídica y empresarial de organizaciones y operaciones de elevado volumen y
              complejidad.
            </p>
            <p>
              Esta doble formación proporciona a I-ME una visión particularmente valiosa para
              estructurar operaciones comerciales, gestionar riesgos, mantener el rigor financiero y
              abordar adecuadamente las obligaciones jurídicas, contractuales, tributarias y
              empresariales inherentes al crecimiento de la compañía.
            </p>
            <p>
              En un sector regulado y en proyectos que pueden involucrar importaciones,
              financiación, contratación, garantías y múltiples actores, esta capacidad constituye
              un componente esencial de nuestra estructura empresarial.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-vision-combo" aria-labelledby="vision-combo-h2">
      <div class="container">
        <div class="story-badge story-badge-on-dark">Perspectiva</div>
        <h2 id="vision-combo-h2" class="story-title story-title-white">
          Experiencias diferentes. Una misma visión.
        </h2>
        <p class="combo-lead">
          La fortaleza de I-ME no reside únicamente en la experiencia individual de cada
          responsable, sino en la combinación de todas estas capacidades dentro de una misma
          organización. Cuando estudiamos un proyecto podemos analizar simultáneamente:
        </p>
        <ul class="combo-list">
          {perspectivas.map(item => <li>{item}</li>)}
        </ul>
        <p class="combo-lead">
          Esta perspectiva multidisciplinar nos permite abordar proyectos que requieren mucho más
          que encontrar un producto en un catálogo.
        </p>
      </div>
    </section>

    <section class="section section-values" aria-labelledby="valores-h2">
      <div class="container">
        <div class="values-header">
          <div class="values-badge">Lo que nos guía</div>
          <h2 id="valores-h2" class="values-title">Misión, visión y propuesta de valor</h2>
        </div>
        <div class="values-grid">
          <div class="value-item">
            <h3>Nuestra misión</h3>
            <p>
              Facilitar a las instituciones de salud el acceso a tecnología biomédica de calidad
              mediante soluciones técnicamente adecuadas, económicamente viables y acompañadas
              durante todo su ciclo de vida.
            </p>
          </div>
          <div class="value-item">
            <h3>Nuestra visión</h3>
            <p>
              Construir una compañía colombiana de referencia en tecnología biomédica, capaz de
              conectar a las instituciones de salud con fabricantes y soluciones tecnológicas de
              todo el mundo mediante una combinación de experiencia humana, conocimiento técnico,
              innovación y excelencia operativa.
            </p>
          </div>
        </div>

        <div class="propuesta-block">
          <h3 class="propuesta-title">Nuestra propuesta de valor</h3>
          <p class="propuesta-intro">
            I-ME trabaja para ofrecer una relación integral con cada institución:
          </p>
          <ul class="propuesta-list">
            {propuesta.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section section-closing" aria-labelledby="largo-h2">
      <div class="container closing-inner">
        <h2 id="largo-h2" class="story-title">Una empresa construida para el largo plazo</h2>
        <div class="story-body">
          <p>
            Queremos que nuestros clientes encuentren en I-ME algo más valioso que un proveedor.
          </p>
          <p>
            Aspiramos a ser un aliado tecnológico capaz de comprender el proyecto completo,
            anticipar dificultades y acompañar a cada institución desde la identificación de una
            necesidad hasta la puesta en funcionamiento y posterior soporte de la solución.
          </p>
          <p>
            Porque incorporar tecnología a una institución de salud no consiste simplemente en
            comprar un equipo. Consiste en tomar una decisión que afectará durante años a
            profesionales, pacientes, operaciones y recursos.
          </p>
          <p>Y esas decisiones merecen experiencia, conocimiento y acompañamiento.</p>
        </div>
        <p class="closing-brand">I-ME International Medical Enterprise</p>
        <p class="closing-tagline">
          Tecnología y experiencia al servicio de quienes cuidan la vida.
        </p>
        <div class="closing-cta">
          <a href="/es/contacto/" class="btn btn-primary">Contáctanos</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero-nosotros {
    background: linear-gradient(135deg, var(--t900) 0%, var(--t800) 100%);
    color: var(--white);
    padding: var(--space-lg) 0 var(--space-3xl);
  }

  .hero-nosotros .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: var(--space-lg);
    opacity: 0.85;
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 700;
    margin: 0 0 var(--space-md) 0;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: var(--step-1);
    line-height: 1.7;
    opacity: 0.95;
    margin: 0;
  }

  .story-layout {
    display: block;
  }

  .story-text {
    display: flow-root;
  }

  .story-image {
    float: right;
    width: 100%;
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 768px) {
    .story-image {
      width: 380px;
      margin-left: var(--space-lg);
      margin-bottom: var(--space-md);
    }
  }

  .story-layout-reverse .story-image {
    float: left;
    margin-left: 0;
    margin-right: var(--space-lg);
  }

  @media (max-width: 767px) {
    .story-layout-reverse .story-image {
      margin-right: 0;
    }
  }

  .image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 767px) {
    .image-wrapper {
      aspect-ratio: 4 / 3;
    }
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--t900);
    margin-bottom: var(--space-md);
    padding: 0.5rem 1rem;
    background: var(--t50);
    border-radius: 24px;
  }

  .story-badge-green {
    background: rgba(126, 217, 87, 0.15);
    color: var(--t900);
  }

  .story-badge-on-dark {
    background: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.95);
  }

  .story-title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    margin: 0 0 var(--space-lg) 0;
    line-height: 1.2;
    color: var(--ink);
  }

  .story-title-white {
    color: var(--white);
  }

  .story-body p {
    font-size: var(--step-0);
    line-height: 1.8;
    color: var(--text-mid);
    margin-bottom: var(--space-md);
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .story-body p:last-child {
    margin-bottom: 0;
  }

  .section-team {
    background: var(--off);
    padding: var(--space-2xl) 0;
  }

  .team-header {
    max-width: 820px;
    margin-bottom: var(--space-2xl);
  }

  .team-lead {
    font-size: var(--step-0);
    line-height: 1.8;
    color: var(--text-mid);
    margin: 0 0 var(--space-md) 0;
    text-align: justify;
    hyphens: auto;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .team-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .team-card-wide {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .team-card-wide {
      grid-column: span 2;
    }
  }

  .team-card h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    margin: 0 0 var(--space-xs) 0;
    color: var(--ink);
  }

  .team-role {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--t800);
    margin: 0 0 var(--space-md) 0;
  }

  .team-card p {
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--text-mid);
    margin: 0 0 var(--space-sm) 0;
    text-align: justify;
    hyphens: auto;
  }

  .team-card p:last-child {
    margin-bottom: 0;
  }

  .section-vision-combo {
    background: linear-gradient(135deg, var(--t900) 0%, var(--t800) 100%);
    color: var(--white);
    padding: var(--space-2xl) 0;
  }

  .combo-lead {
    font-size: var(--step-0);
    line-height: 1.8;
    opacity: 0.95;
    max-width: 820px;
    margin: 0 0 var(--space-md) 0;
  }

  .combo-list {
    margin: 0 0 var(--space-lg) 0;
    padding-left: 1.25rem;
    max-width: 820px;
    columns: 1;
  }

  @media (min-width: 700px) {
    .combo-list {
      columns: 2;
      column-gap: var(--space-xl);
    }
  }

  .combo-list li {
    break-inside: avoid;
    margin-bottom: 0.55rem;
    line-height: 1.5;
  }

  .section-values {
    background: var(--off);
    padding: var(--space-2xl) 0;
  }

  .values-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .values-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--t900);
    background: var(--t50);
    padding: 0.5rem 1rem;
    border-radius: 24px;
    margin-bottom: var(--space-md);
  }

  .values-title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    color: var(--ink);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .value-item {
    background: var(--white);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .value-item h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    margin: 0 0 var(--space-sm) 0;
    color: var(--ink);
  }

  .value-item p {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--text-mid);
    margin: 0;
  }

  .propuesta-block {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .propuesta-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    margin: 0 0 var(--space-sm) 0;
    color: var(--ink);
  }

  .propuesta-intro {
    color: var(--text-mid);
    margin: 0 0 var(--space-md) 0;
    line-height: 1.7;
  }

