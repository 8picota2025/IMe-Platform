---
/**
 * Landing SEO por familia — copy único + FAQ + productos relacionados.
 */
import Layout from '../../../layouts/Layout.astro';
import ProductoCard from '../../../components/ProductoCard.astro';
import {
  buildFamiliaSeo,
  buildCanonical,
  buildOrganizationJsonLd,
  buildBreadcrumbJsonLd,
  buildFaqJsonLd,
  combineJsonLd,
} from '../../../lib/seo';
import {
  getFamiliaSeo,
  listFamiliaSeoSlugs,
  familiaDisplayName,
  getFamiliaGuide,
  getFamiliaHubLinks,
} from '../../../data/familia-seo';
import { buildCatalogoIndex, paginateCatalogItems } from '../../../lib/catalogo';
import { t } from '../../../i18n/utils';

export function getStaticPaths() {
  return listFamiliaSeoSlugs().map(slug => ({ params: { slug } }));
}

const locale = 'es' as const;
const slug = Astro.params.slug!;
const content = getFamiliaSeo(slug);
if (!content) {
  return Astro.redirect('/es/catalogo/');
}

const name = familiaDisplayName(content, locale);
const seo = buildFamiliaSeo(locale, {
  slug,
  name: content.title_es,
  description: content.description_es,
});
// Una landing canónica muestra solo su familia editorial real. `familias_filtro`
// contiene asociaciones amplias para búsqueda y no debe definir pertenencia.
const productos = (await buildCatalogoIndex(locale)).filter(
  item => item.familia.slug === content.slug
);
const familyPage = paginateCatalogItems(productos, 1);
const faq = content.faq.map(f => ({ q: f.q_es, a: f.a_es }));
const criterios = getFamiliaGuide(slug, locale);
const catalogoFamilia = '#equipos';
const hubLinks = getFamiliaHubLinks(slug, locale);

const jsonLd = combineJsonLd(
  buildOrganizationJsonLd(),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/es/') },
    { name: t(locale, 'catalogo.migas_catalogo'), url: buildCanonical('/es/catalogo') },
    { name: name, url: seo.canonical },
  ]),
  buildFaqJsonLd(faq),
  {
    '@type': 'CollectionPage',
    name: content.title_es,
    description: content.description_es,
    url: seo.canonical,
  }
);
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  locale={locale}
  currentPath={`/es/familias/${slug}`}
  jsonLd={jsonLd}
>
  <div
    class="page-hero"
    style="padding-top:130px;padding-bottom:var(--space-lg);background:var(--off)"
  >
    <div class="container" style="max-width:760px">
      <nav class="breadcrumb" aria-label="Ruta" style="margin-bottom:1rem;font-size:0.875rem">
        <a href="/es/">Inicio</a><span aria-hidden="true"> / </span>
        <a href="/es/catalogo/">Catálogo</a><span aria-hidden="true"> / </span>
        <span aria-current="page">{name}</span>
      </nav>
      <span class="section-tag">Familia</span>
      <h1>{name}</h1>
      <p style="color:var(--text-mid);margin:0.75rem 0 0;line-height:1.55">{content.intro_es}</p>
      <p style="margin-top:1.25rem">
        <a class="btn btn-primary" href={catalogoFamilia}
          >Ver {productos.length} equipos de esta familia</a
        >
        <a class="btn btn-ghost" href="/es/contacto/" style="margin-left:0.5rem"
          >Solicitar cotización</a
        >
      </p>
    </div>
  </div>

  <section class="container" style="padding:var(--space-xl) 0;max-width:760px">
    {
      content.body_es.map(p => (
        <p style="margin:0 0 1rem;line-height:1.6;color:var(--text-mid)">{p}</p>
      ))
    }
    {
      hubLinks.length > 0 && (
        <p style="margin:1.25rem 0 0">
          {hubLinks.map((link, index) => (
            <a
              class="btn btn-secondary"
              href={link.href}
              style={
                index < hubLinks.length - 1
                  ? 'margin-right:0.5rem;margin-bottom:0.5rem'
                  : 'margin-bottom:0.5rem'
              }
            >
              {link.label}
            </a>
          ))}
        </p>
      )
    }
  </section>

  <section class="container" style="padding:0 0 var(--space-xl);max-width:760px">
    <h2>Cómo estructurar la compra institucional</h2>
    <p style="color:var(--text-mid);line-height:1.6">
      Use esta guía para preparar una solicitud comparable. No reemplaza la evaluación clínica,
      técnica ni la documentación del fabricante.
    </p>
    <ol class="family-guide">
      {criterios.map(criterio => <li>{criterio}</li>)}
    </ol>
    <p style="color:var(--text-mid);line-height:1.6">
      Para cada referencia, I-ME confirma documentación aplicable, alcance comercial y condiciones
      de soporte. INVIMA organiza los requisitos de dispositivos y equipos biomédicos durante su
      ciclo de vida; la OMS recomienda integrar inspección, mantenimiento preventivo y correctivo en
      la gestión de equipos.
    </p>
    <p>
      <a
        href="https://www.invima.gov.co/productos-vigilados/dispositivos-medicos"
        rel="noopener noreferrer"
        target="_blank">Consultar lineamientos INVIMA</a
      > · <a
        href="https://www.who.int/es/publications/i/item/9789241501538"
        rel="noopener noreferrer"
        target="_blank">Guía OMS de mantenimiento</a
      >
    </p>
  </section>

  {
    productos.length > 0 && (
      <section id="equipos" class="container" style="padding-bottom:var(--space-xl)">
        <h2 style="margin-bottom:1rem">Equipos de {name}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1rem">
          {familyPage.items.map(p => (
            <ProductoCard
              producto={{
                ...p,
                familia: { slug: content.slug, nombre: name },
              }}
              locale={locale}
            />
          ))}
        </div>
        {familyPage.pageCount > 1 && (
          <nav class="family-pagination" aria-label="Paginación de la familia">
            <span>Página 1 de {familyPage.pageCount}</span>
            <a class="btn btn-secondary" href={`/es/familias/${slug}/pagina/2/`}>
              Siguiente
            </a>
          </nav>
        )}
      </section>
    )
  }

  <section class="container" style="padding-bottom:var(--space-2xl);max-width:760px">
    <h2>Preguntas frecuentes</h2>
    {
      faq.map(item => (
        <details style="margin:0.75rem 0;padding:0.75rem 0;border-bottom:1px solid var(--border, #e2e8ed)">
          <summary style="cursor:pointer;font-weight:600">{item.q}</summary>
          <p style="margin:0.5rem 0 0;color:var(--text-mid);line-height:1.55">{item.a}</p>
        </details>
      ))
    }
  </section>
</Layout>

<style>
  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--teal, #0f4c5c);
  }
  .breadcrumb a {
    color: var(--teal, #0f4c5c);
  }
  .family-guide {
    margin: 1rem 0;
    padding-left: 1.25rem;
    color: var(--text-mid);
    line-height: 1.6;
  }
  .family-guide li + li {
    margin-top: 0.6rem;
  }
  .family-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
