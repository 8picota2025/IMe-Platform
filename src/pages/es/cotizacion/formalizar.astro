---
import Layout from '../../../layouts/Layout.astro';
import { buildCanonical, buildPageTitle } from '../../../lib/seo';

const currentPath = '/es/cotizacion/formalizar';
---

<Layout
  title={buildPageTitle('Formalizar cotización')}
  description="Revisa tu cotización I-ME y formaliza el pedido para ir al pago."
  canonical={buildCanonical(currentPath)}
  locale="es"
  currentPath={currentPath}
  noindex={true}
>
  <main class="formalizar container">
    <section class="formalizar__panel" data-formalizar-root>
      <h1>Formalizar cotización</h1>
      <p class="formalizar__status" data-formalizar-status>Validando enlace…</p>
      <div data-formalizar-content hidden></div>
      <div class="formalizar__actions" data-formalizar-actions hidden>
        <button type="button" class="btn btn-primary" data-formalizar-cta>Formalizar pedido</button>
        <a class="formalizar__secondary" href="/es/carrito/">Ir al carrito</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .formalizar {
    min-height: 60vh;
    padding: 3rem 0 4rem;
  }
  .formalizar__panel h1 {
    margin: 0 0 0.75rem;
  }
  .formalizar__status {
    margin: 0 0 1.5rem;
  }
  .formalizar__error {
    color: #8b1e1e;
  }
  .formalizar__table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.25rem;
  }
  .formalizar__table th,
  .formalizar__table td {
    text-align: left;
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--border-color, #c9d6db);
  }
  .formalizar__condiciones {
    white-space: pre-wrap;
    padding: 1rem;
    margin: 0 0 1.5rem;
    border: 1px solid var(--border-color, #c9d6db);
  }
  .formalizar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .formalizar__secondary {
    text-decoration: underline;
  }
  .formalizar__total {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }
</style>

<script>
  import { cargarCarritoDesdeCotizacion, abrirCarrito } from '../../../lib/carrito';
  import { getSupabaseClient } from '../../../lib/supabase';

  type Linea = {
    slug: string;
    nombre: string;
    cantidad: number;
    precio_unitario: number;
    subtotal: number;
    moneda: string;
  };

  type Preview = {
    id: string;
    nombre?: string;
    empresa?: string;
    condiciones?: string;
    validez_hasta?: string;
    moneda: string;
    total: number;
    lineas: Linea[];
  };

  const params = new URLSearchParams(location.search);
  const id = (params.get('id') ?? '').trim();
  const token = (params.get('t') ?? '').trim();
  const statusEl = document.querySelector<HTMLElement>('[data-formalizar-status]');
  const contentEl = document.querySelector<HTMLElement>('[data-formalizar-content]');
  const actionsEl = document.querySelector<HTMLElement>('[data-formalizar-actions]');
  const cta = document.querySelector<HTMLButtonElement>('[data-formalizar-cta]');

  function money(value: number, moneda: string): string {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: moneda || 'COP',
      maximumFractionDigits: moneda === 'COP' ? 0 : 2,
    }).format(value);
  }

  function escape(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function showError(msg: string) {
    if (statusEl) {
      statusEl.textContent = msg;
      statusEl.classList.add('formalizar__error');
    }
  }

  async function load() {
    if (!statusEl || !contentEl || !actionsEl || !cta) return;
    if (!id || !token) {
      showError('Enlace incompleto. Usa el enlace del correo de cotización.');
      return;
    }
    const supabase = getSupabaseClient();
    if (!supabase) {
      showError('No se pudo conectar. Intenta de nuevo más tarde.');
      return;
    }
    const { data, error } = await supabase.functions.invoke('formalizar-cotizacion', {
      body: { cotizacion_id: id, token },
    });
    if (error) {
      showError(error.message || 'No se pudo validar la cotización.');
      return;
    }
    const json = data as {
      ok?: boolean;
      error?: { message?: string };
      cotizacion?: Preview;
    };
    if (!json?.ok || !json.cotizacion) {
      showError(json?.error?.message || 'Cotización no disponible para formalizar.');
      return;
    }

    const cotizacion = json.cotizacion;
    statusEl.textContent = `Hola ${cotizacion.nombre ?? 'cliente'}. Revisa tu oferta y formaliza el pedido.`;
    statusEl.classList.remove('formalizar__error');
    contentEl.hidden = false;
    contentEl.innerHTML = `
      ${cotizacion.empresa ? `<p><strong>Empresa:</strong> ${escape(cotizacion.empresa)}</p>` : ''}
      ${cotizacion.validez_hasta ? `<p><strong>Validez:</strong> ${escape(cotizacion.validez_hasta)}</p>` : ''}
      <table class="formalizar__table">
        <thead><tr><th>Producto</th><th>Cant.</th><th>Unitario</th><th>Subtotal</th></tr></thead>
        <tbody>
          ${cotizacion.lineas
            .map(
              l => `<tr>
                <td>${escape(l.nombre)}</td>
                <td>${l.cantidad}</td>
                <td>${money(l.precio_unitario, l.moneda)}</td>
                <td>${money(l.subtotal, l.moneda)}</td>
              </tr>`
            )
            .join('')}
        </tbody>
      </table>
      <p class="formalizar__total">Total: ${money(cotizacion.total, cotizacion.moneda)}</p>
      <h2>Condiciones</h2>
      <pre class="formalizar__condiciones">${escape(cotizacion.condiciones ?? '')}</pre>
    `;
    actionsEl.hidden = false;

    cta.addEventListener('click', () => {
      cargarCarritoDesdeCotizacion(cotizacion.lineas, { cotizacionId: id, token });
      abrirCarrito();
      location.href = '/es/carrito/';
    });
  }

  void load();
</script>
