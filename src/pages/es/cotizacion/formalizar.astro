---
import Layout from '../../../layouts/Layout.astro';
import { buildCanonical, buildPageTitle } from '../../../lib/seo';

const currentPath = '/es/cotizacion/formalizar';
---

<Layout
  title={buildPageTitle('Pagar cotización por transferencia')}
  description="Revisa tu cotización I-ME, realiza la transferencia y carga el comprobante."
  canonical={buildCanonical(currentPath)}
  locale="es"
  currentPath={currentPath}
  noindex={true}
>
  <main class="formalizar container">
    <section class="formalizar__panel" data-formalizar-root>
      <h1>Pagar por transferencia</h1>
      <p class="formalizar__status" data-formalizar-status>Validando enlace…</p>
      <div data-formalizar-content hidden></div>
      <form class="formalizar__form" data-formalizar-form hidden>
        <h2>Datos bancarios</h2>
        <pre class="formalizar__bank" data-formalizar-bank></pre>
        <label class="formalizar__field">
          <span>Referencia / concepto de transferencia (opcional)</span>
          <input name="referencia_transferencia" type="text" maxlength="120" autocomplete="off" />
        </label>
        <label class="formalizar__field">
          <span>Comprobante de pago (PDF, JPG, PNG — máx. 5 MB)</span>
          <input
            name="comprobante"
            type="file"
            accept=".pdf,image/jpeg,image/png,image/webp"
            required
          />
        </label>
        <label class="formalizar__check">
          <input name="consentimiento" type="checkbox" required />
          <span
            >Autorizo el tratamiento de mis datos para validar el pago y gestionar el pedido.</span
          >
        </label>
        <button type="submit" class="btn btn-primary" data-formalizar-submit>
          Enviar comprobante y formalizar pedido
        </button>
        <p class="formalizar__help" data-formalizar-form-status></p>
      </form>
    </section>
  </main>
</Layout>

<style>
  .formalizar {
    min-height: 60vh;
    padding: 3rem 0 4rem;
  }
  .formalizar__panel h1 {
    margin: 0 0 0.75rem;
  }
  .formalizar__status {
    margin: 0 0 1.5rem;
  }
  .formalizar__error {
    color: #8b1e1e;
  }
  .formalizar__ok {
    color: #0b5c3b;
  }
  .formalizar__table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.25rem;
  }
  .formalizar__table th,
  .formalizar__table td {
    text-align: left;
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--border-color, #c9d6db);
  }
  .formalizar__condiciones,
  .formalizar__bank {
    white-space: pre-wrap;
    padding: 1rem;
    margin: 0 0 1.5rem;
    border: 1px solid var(--border-color, #c9d6db);
    background: rgba(255, 255, 255, 0.65);
  }
  .formalizar__total {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .formalizar__form {
    display: grid;
    gap: 1rem;
    max-width: 560px;
  }
  .formalizar__field {
    display: grid;
    gap: 0.35rem;
  }
  .formalizar__check {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .formalizar__help {
    margin: 0;
    color: #3d5a63;
  }
</style>

<script>
  import { getSupabaseClient } from '../../../lib/supabase';

  type Linea = {
    slug: string;
    nombre: string;
    cantidad: number;
    precio_unitario: number;
    subtotal: number;
    moneda: string;
  };

  type Preview = {
    id: string;
    nombre?: string;
    empresa?: string;
    condiciones?: string;
    validez_hasta?: string;
    moneda: string;
    total: number;
    lineas: Linea[];
  };

  const params = new URLSearchParams(location.search);
  const id = (params.get('id') ?? '').trim();
  const token = (params.get('t') ?? '').trim();
  const statusEl = document.querySelector<HTMLElement>('[data-formalizar-status]');
  const contentEl = document.querySelector<HTMLElement>('[data-formalizar-content]');
  const form = document.querySelector<HTMLFormElement>('[data-formalizar-form]');
  const bankEl = document.querySelector<HTMLElement>('[data-formalizar-bank]');
  const formStatus = document.querySelector<HTMLElement>('[data-formalizar-form-status]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-formalizar-submit]');

  function money(value: number, moneda: string): string {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: moneda || 'COP',
      maximumFractionDigits: moneda === 'COP' ? 0 : 2,
    }).format(value);
  }

  function escape(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function showError(msg: string) {
    if (statusEl) {
      statusEl.textContent = msg;
      statusEl.classList.add('formalizar__error');
    }
  }

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result ?? ''));
      reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
      reader.readAsDataURL(file);
    });
  }

  async function load() {
    if (!statusEl || !contentEl || !form || !bankEl) return;
    if (!id || !token) {
      showError('Enlace incompleto. Usa el enlace del correo de cotización.');
      return;
    }
    const supabase = getSupabaseClient();
    if (!supabase) {
      showError('No se pudo conectar. Intenta de nuevo más tarde.');
      return;
    }
    const { data, error } = await supabase.functions.invoke('formalizar-cotizacion', {
      body: { action: 'preview', cotizacion_id: id, token },
    });
    if (error) {
      showError(error.message || 'No se pudo validar la cotización.');
      return;
    }
    const json = data as {
      ok?: boolean;
      error?: { message?: string };
      cotizacion?: Preview;
      transferencia?: { texto?: string };
    };
    if (!json?.ok || !json.cotizacion) {
      showError(json?.error?.message || 'Cotización no disponible para formalizar.');
      return;
    }

    const cotizacion = json.cotizacion;
    statusEl.textContent = `Hola ${cotizacion.nombre ?? 'cliente'}. Revisa la oferta, transfiere el total y carga el comprobante.`;
    statusEl.classList.remove('formalizar__error');
    contentEl.hidden = false;
    contentEl.innerHTML = `
      ${cotizacion.empresa ? `<p><strong>Empresa:</strong> ${escape(cotizacion.empresa)}</p>` : ''}
      ${cotizacion.validez_hasta ? `<p><strong>Validez:</strong> ${escape(cotizacion.validez_hasta)}</p>` : ''}
      <table class="formalizar__table">
        <thead><tr><th>Producto</th><th>Cant.</th><th>Unitario</th><th>Subtotal</th></tr></thead>
        <tbody>
          ${cotizacion.lineas
            .map(
              l => `<tr>
                <td>${escape(l.nombre)}</td>
                <td>${l.cantidad}</td>
                <td>${money(l.precio_unitario, l.moneda)}</td>
                <td>${money(l.subtotal, l.moneda)}</td>
              </tr>`
            )
            .join('')}
        </tbody>
      </table>
      <p class="formalizar__total">Total a transferir: ${money(cotizacion.total, cotizacion.moneda)}</p>
      <h2>Observaciones / configuración</h2>
      <pre class="formalizar__condiciones">${escape(cotizacion.condiciones ?? '')}</pre>
    `;
    bankEl.textContent = json.transferencia?.texto ?? '';
    form.hidden = false;

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!submitBtn || !formStatus) return;
      const fd = new FormData(form);
      const file = fd.get('comprobante');
      if (!(file instanceof File) || file.size === 0) {
        formStatus.textContent = 'Adjunta el comprobante de transferencia.';
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        formStatus.textContent = 'El archivo supera 5 MB.';
        return;
      }
      submitBtn.disabled = true;
      formStatus.textContent = 'Enviando comprobante…';
      try {
        const dataUrl = await fileToBase64(file);
        const { data: result, error: submitError } = await supabase.functions.invoke(
          'formalizar-cotizacion',
          {
            body: {
              action: 'registrar_transferencia',
              cotizacion_id: id,
              token,
              referencia_transferencia: String(fd.get('referencia_transferencia') ?? ''),
              comprobante_base64: dataUrl,
              comprobante_nombre: file.name,
              comprobante_mime: file.type || 'application/pdf',
              consentimiento_datos: true,
            },
          }
        );
        if (submitError) {
          formStatus.textContent = submitError.message || 'No se pudo registrar el pago.';
          submitBtn.disabled = false;
          return;
        }
        const jsonResult = result as {
          ok?: boolean;
          error?: { message?: string };
          referencia?: string;
        };
        if (!jsonResult?.ok) {
          formStatus.textContent = jsonResult?.error?.message || 'No se pudo registrar el pago.';
          submitBtn.disabled = false;
          return;
        }
        form.hidden = true;
        statusEl.classList.remove('formalizar__error');
        statusEl.classList.add('formalizar__ok');
        statusEl.textContent = `Comprobante recibido. Pedido ${jsonResult.referencia ?? ''} pendiente de validación. Te confirmaremos por correo.`;
        contentEl.insertAdjacentHTML(
          'beforeend',
          '<p class="formalizar__ok">Gracias. Nuestro equipo validará la transferencia.</p>'
        );
      } catch {
        formStatus.textContent = 'Error de red al enviar el comprobante.';
        submitBtn.disabled = false;
      }
    });
  }

  void load();
</script>
