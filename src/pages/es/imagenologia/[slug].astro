---
import ModalidadLanding from '../../../components/ModalidadLanding.astro';
import { getProductosBySlugs } from '../../../lib/datos';
import { MODALIDADES_IMAGEN, getModalidad, slugsDeModalidad } from '../../../data/modalidades';

export function getStaticPaths() {
  return MODALIDADES_IMAGEN.map(pagina => ({ params: { slug: pagina.slug } }));
}

const locale = 'es' as const;
const pagina = getModalidad(MODALIDADES_IMAGEN, Astro.params.slug ?? '');
if (!pagina) throw new Error('Modalidad de imagen no publicada');
const productos = await getProductosBySlugs(slugsDeModalidad(pagina), locale);
---

<ModalidadLanding
  locale={locale}
  pagina={pagina}
  productos={productos}
  currentPath={`/es/imagenologia/${pagina.slug}`}
  parentHref="/es/imagenologia/"
  parentLabel="Imagenología"
/>
