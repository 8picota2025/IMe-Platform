---
import CampaignLandingPage from '../../components/CampaignLandingPage.astro';
import { getCampaignLandingCms } from '../../lib/landings-cms';

const locale = 'es' as const;
const cms = await getCampaignLandingCms('ventiladores_mecanicos', locale);
// arreglos011126 ítem 6: fichas retiradas del catálogo; la guía no muestra menciones de marca.
const content = {
  ...cms,
  title: 'Ventiladores mecánicos para UCI | I-ME',
  description:
    'Criterios para evaluar ventiladores mecánicos de UCI adulto y pediátrico. Cotice por WhatsApp o en línea.',
  h1: 'Ventiladores mecánicos para UCI',
  lead: 'Cotice el ventilador mecánico de UCI según el servicio y el perfil de paciente. La configuración y el precio se cotizan.',
  productSlugs: [],
};
const productos: never[] = [];
---

<CampaignLandingPage locale={locale} content={content} productos={productos} />
