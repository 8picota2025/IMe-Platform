---
/**
 * Landing estática de producto ES — getStaticPaths desde la capa de datos.
 */
import Layout from '../../../layouts/Layout.astro';
import ProductoLanding from '../../../components/ProductoLanding.astro';
import { t } from '../../../i18n/utils';
import {
  buildProductoSeo,
  truncateMetaDescription,
  buildCanonical,
  buildProductJsonLd,
  buildBreadcrumbJsonLd,
  buildFaqJsonLd,
  combineJsonLd,
} from '../../../lib/seo';
import {
  CATALOG_INDEX_FETCH,
  getProductos,
  getFamilias,
  type Familia,
  type Producto,
} from '../../../lib/datos';
import { seleccionarRelacionados } from '../../../lib/relacion-accesorios';
import { normalizarEspecificaciones } from '../../../lib/especificaciones';
import { getProductoSeoCopy } from '../../../data/producto-seo-copy';
import { enlacesZuowei } from '../../../data/zuowei-catalogo';

const locale = 'es';

export async function getStaticPaths() {
  const [productos, familias] = await Promise.all([
    getProductos({ pageSize: CATALOG_INDEX_FETCH }, 'es'),
    getFamilias('es'),
  ]);
  const familiasPorSlug = new Map(familias.map(familia => [familia.slug, familia] as const));
  const productosPorFamilia = new Map<string, Producto[]>();

  for (const producto of productos) {
    const familiaProductos = productosPorFamilia.get(producto.familia_slug) ?? [];
    familiaProductos.push(producto);
    productosPorFamilia.set(producto.familia_slug, familiaProductos);
  }

  return productos.map(producto => ({
    params: { slug: producto.slug },
    props: {
      producto,
      familia: familiasPorSlug.get(producto.familia_slug) ?? {
        id: producto.familia_slug,
        slug: producto.familia_slug,
        nombre: producto.familia_slug,
        descripcion: '',
        orden: 0,
        activo: true,
      },
      relacionados: seleccionarRelacionados(
        producto,
        productosPorFamilia.get(producto.familia_slug) ?? [],
        productos
      ),
    },
  }));
}

interface Props {
  producto: Producto;
  familia: Familia;
  relacionados: Producto[];
}

const { producto } = Astro.props as Props;
const { familia, relacionados } = Astro.props as Props;

const seoBase = buildProductoSeo(producto, locale, familia.nombre, producto.marca);
const seoCopy = getProductoSeoCopy(producto.slug, locale);
const enlaces = enlacesZuowei(producto.slug, locale);
const seo = seoCopy
  ? {
      ...seoBase,
      title: seoCopy.title,
      description: truncateMetaDescription(seoCopy.description),
    }
  : seoBase;
const noindex = producto.slug === 'test';
const especificaciones = normalizarEspecificaciones(producto.especificaciones);
const certificaciones = especificaciones
  .filter(item => /normativ/i.test(item.grupo ?? ''))
  .map(item => [item.clave, item.valor].filter(Boolean).join(': '))
  .filter(Boolean);
const modelo = especificaciones.find(item => /^modelo$/i.test(item.clave))?.valor;

const jsonLd = combineJsonLd(
  buildProductJsonLd(producto, locale, familia.nombre, producto.marca, {
    certificaciones,
    familiaSlug: familia.slug,
    ...(modelo ? { model: modelo } : {}),
  }),
  ...(producto.preguntas_frecuentes.length > 0
    ? [buildFaqJsonLd(producto.preguntas_frecuentes)]
    : []),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/es/') },
    { name: t(locale, 'catalogo.migas_catalogo'), url: buildCanonical('/es/catalogo') },
    { name: familia.nombre, url: buildCanonical(`/es/familias/${familia.slug}`) },
    { name: producto.nombre, url: seo.canonical },
  ])
);
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  locale={locale}
  currentPath={`/es/productos/${producto.slug}`}
  ogImage={seo.ogImage}
  jsonLd={jsonLd}
  noindex={noindex}
>
  <ProductoLanding
    producto={producto}
    familia={familia}
    relacionados={relacionados}
    locale={locale}
    {...seoCopy ? { seoH1: seoCopy.h1, seoIntro: seoCopy.intro } : {}}
    {...enlaces.length > 0 ? { enlaces } : {}}
  />
</Layout>
