---
/**
 * Landing estática de producto ES — getStaticPaths desde la capa de datos.
 */
import Layout from '../../../layouts/Layout.astro';
import ProductoLanding from '../../../components/ProductoLanding.astro';
import { t } from '../../../i18n/utils';
import {
  buildProductoSeo,
  buildCanonical,
  buildProductJsonLd,
  buildBreadcrumbJsonLd,
  combineJsonLd,
} from '../../../lib/seo';
import { getProductos, getFamilias, type Familia, type Producto } from '../../../lib/datos';

const locale = 'es';

export async function getStaticPaths() {
  const [productos, familias] = await Promise.all([
    getProductos({ pageSize: 1000 }, 'es'),
    getFamilias('es'),
  ]);
  const familiasPorSlug = new Map(familias.map(familia => [familia.slug, familia] as const));
  const productosPorFamilia = new Map<string, Producto[]>();

  for (const producto of productos) {
    const familiaProductos = productosPorFamilia.get(producto.familia_slug) ?? [];
    familiaProductos.push(producto);
    productosPorFamilia.set(producto.familia_slug, familiaProductos);
  }

  return productos.map(producto => ({
    params: { slug: producto.slug },
    props: {
      producto,
      familia: familiasPorSlug.get(producto.familia_slug) ?? {
        id: producto.familia_slug,
        slug: producto.familia_slug,
        nombre: producto.familia_slug,
        descripcion: '',
        orden: 0,
        activo: true,
      },
      relacionados: (productosPorFamilia.get(producto.familia_slug) ?? [])
        .filter(item => item.slug !== producto.slug)
        .slice(0, 4),
    },
  }));
}

interface Props {
  producto: Producto;
  familia: Familia;
  relacionados: Producto[];
}

const { producto } = Astro.props as Props;
const { familia, relacionados } = Astro.props as Props;

const seo = buildProductoSeo(producto, locale, familia.nombre, producto.marca);

const jsonLd = combineJsonLd(
  buildProductJsonLd(producto, locale, familia.nombre, producto.marca),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/es/') },
    { name: t(locale, 'catalogo.migas_catalogo'), url: buildCanonical('/es/catalogo') },
    { name: familia.nombre, url: buildCanonical(`/es/catalogo/?familia=${familia.slug}`) },
    { name: producto.nombre, url: seo.canonical },
  ])
);
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  locale={locale}
  currentPath={`/es/productos/${producto.slug}`}
  ogImage={seo.ogImage}
  jsonLd={jsonLd}
>
  <ProductoLanding
    producto={producto}
    familia={familia}
    relacionados={relacionados}
    locale={locale}
  />
</Layout>
