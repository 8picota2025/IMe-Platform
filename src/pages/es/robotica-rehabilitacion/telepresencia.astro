---
import Layout from '../../../layouts/Layout.astro';
import { getProductosBySlugs } from '../../../lib/datos';
import { TELEPRESENCIA_SLUG } from '../../../data/modalidades';
import NotaPromoPadbot from '../../../components/NotaPromoPadbot.astro';
import {
  buildBreadcrumbJsonLd,
  buildCanonical,
  buildOrganizationJsonLd,
  buildPageTitle,
  combineJsonLd,
} from '../../../lib/seo';

const locale = 'es' as const;
const productos = await getProductosBySlugs([TELEPRESENCIA_SLUG], locale);
const producto = productos[0];
const title = buildPageTitle('Telepresencia y comunicación en instalaciones con PadBot P2 | I-ME');
const description =
  'Telepresencia y comunicación en instalaciones en Colombia: PadBot P2, con video llamada, control remoto, WiFi/4G y autocarga según su ficha. I-ME lo cotiza por referencia.';
const canonical = buildCanonical('/es/robotica-rehabilitacion/telepresencia');
const jsonLd = combineJsonLd(
  buildOrganizationJsonLd(),
  buildBreadcrumbJsonLd([
    { name: 'Inicio', url: buildCanonical('/es/') },
    {
      name: 'Robótica',
      url: buildCanonical(
        '/es/distribuidores-de-robots-e-ingenieria-robotica-en-colombia-y-latinoamerica'
      ),
    },
    { name: 'Telepresencia', url: canonical },
  ])
);
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath="/es/robotica-rehabilitacion/telepresencia"
  jsonLd={jsonLd}
>
  <div
    class="page-hero"
    style="padding-top:130px;padding-bottom:var(--space-lg);background:var(--off)"
  >
    <div class="container" style="max-width:760px">
      <nav class="breadcrumb" aria-label="Ruta">
        <a href="/es/">Inicio</a> /{' '}
        <a href="/es/distribuidores-de-robots-e-ingenieria-robotica-en-colombia-y-latinoamerica/"
          >Robótica</a
        >{' '}
        /
        <span aria-current="page">Telepresencia</span>
      </nav>
      <h1>Telepresencia y comunicación en instalaciones con PadBot P2</h1>
      <p style="color:var(--text-mid);line-height:1.6">
        El catálogo publica el PadBot P2 como robot de telepresencia plegable, con pantalla HD de 10
        pulgadas, WiFi/4G, video llamada, control remoto y autocarga. El precio se cotiza. No
        sustituye una valoración clínica.
      </p>
      <p>
        <a class="btn btn-primary" href="/es/contacto/">Solicitar cotización</a>
        <a class="btn btn-ghost" href="tel:+573137247353">+57 313 724 7353</a>
      </p>
    </div>
  </div>
  <section class="container" style="max-width:760px;padding:var(--space-xl) 0">
    <h2>Casos de uso que salen de la ficha</h2>
    <ul>
      <li>Presencia por video llamada dentro de la institución, con control remoto.</li>
      <li>Conexión WiFi o 4G, según lo que describe la ficha del PadBot P2.</li>
      <li>Equipo plegable con autocarga, para guardarlo y recargarlo en la sede.</li>
    </ul>
    <p style="color:var(--text-mid);line-height:1.6">
      Esos usos describen la función publicada del robot. No prometen resultado clínico, reducción
      de estancia ni reemplazo de personal.
    </p>
    <NotaPromoPadbot locale={locale} />
    {
      producto && (
        <p>
          <a href={`/es/productos/${producto.slug}/`}>{producto.nombre}</a>
          {producto.sku ? ` · SKU ${producto.sku}` : ''}
          {producto.descripcion_corta ? ` — ${producto.descripcion_corta}` : ''}
        </p>
      )
    }
    <p>
      <a href="/es/distribuidores-de-robots-e-ingenieria-robotica-en-colombia-y-latinoamerica/"
        >Volver a distribuidores de robots en Colombia y Latinoamérica</a
      >
      {' · '}
      <a href="/es/compras-publicas/">Compras públicas</a>
    </p>
    <p class="modalidad-todo" role="note">
      TODO_CLIENTE: el INVIMA del PadBot P2 no está en la ficha revisada. No se publica un registro
      hasta que Shoky lo entregue.
    </p>
  </section>
</Layout>

<style>
  .modalidad-todo {
    padding: 0.9rem 1rem;
    background: var(--off);
    color: var(--text-mid);
  }
  a:focus-visible,
  .btn:focus-visible {
    outline: 2px solid var(--t900);
    outline-offset: 2px;
  }
</style>
