---
import Layout from '../../../../layouts/Layout.astro';
import CatalogoExplorer from '../../../../components/CatalogoExplorer.astro';
import { t } from '../../../../i18n/utils';
import {
  buildCanonical,
  buildOrganizationJsonLd,
  buildBreadcrumbJsonLd,
  combineJsonLd,
} from '../../../../lib/seo';
import { buildCatalogoIndex, paginateCatalogItems } from '../../../../lib/catalogo';

export async function getStaticPaths() {
  const items = await buildCatalogoIndex('es');
  const { pageCount } = paginateCatalogItems(items, 1);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const locale = 'es' as const;
const page = Number(Astro.params.page);
const items = await buildCatalogoIndex(locale);
const catalogPage = paginateCatalogItems(items, page);
if (catalogPage.items.length === 0) return Astro.redirect('/es/catalogo/');
const canonical = buildCanonical(`/es/catalogo/pagina/${catalogPage.page}`);
const title = `Catálogo de equipos biomédicos — página ${catalogPage.page} | I-ME`;
const description = `Página ${catalogPage.page} del catálogo de equipos biomédicos I-ME para instituciones de salud en Colombia.`;
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  itemListElement: catalogPage.items.map((item, index) => ({
    '@type': 'ListItem',
    position: (catalogPage.page - 1) * 48 + index + 1,
    url: buildCanonical(`/es/productos/${item.slug}/`),
    name: item.nombre,
  })),
};
const jsonLd = combineJsonLd(
  buildOrganizationJsonLd(items.length),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/es/') },
    { name: t(locale, 'catalogo.migas_catalogo'), url: buildCanonical('/es/catalogo/') },
    { name: `Página ${catalogPage.page}`, url: canonical },
  ]),
  itemListJsonLd
);
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath={`/es/catalogo/pagina/${catalogPage.page}`}
  jsonLd={jsonLd}
>
  <div
    class="page-hero"
    style="padding-top:130px;padding-bottom:var(--space-md);background:var(--off)"
  >
    <div class="container">
      <span class="section-tag">{t(locale, 'catalogo.familias_titulo')}</span><h1>
        {t(locale, 'catalogo.titulo')}
      </h1><p style="color:var(--text-mid);max-width:560px;margin:0.75rem 0 0">
        Página {catalogPage.page} de {catalogPage.pageCount} · {items.length} equipos biomédicos.
      </p>
    </div>
  </div>
  <div class="container">
    <CatalogoExplorer
      locale={locale}
      items={catalogPage.items}
      page={catalogPage.page}
      pageCount={catalogPage.pageCount}
    />
  </div>
</Layout>

<style>
  .section-tag {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--t900);
    background: var(--t100);
    padding: 0.3rem 0.875rem;
    border-radius: 999px;
    margin-block-end: 0.75rem;
  }
</style>
