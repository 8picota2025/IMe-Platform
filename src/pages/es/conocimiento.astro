---
import Layout from '../../layouts/Layout.astro';
import {
  buildPageTitle,
  buildCanonical,
  buildOrganizationJsonLd,
  buildBreadcrumbJsonLd,
  combineJsonLd,
} from '../../lib/seo';
import { getArticulos } from '../../lib/datos';
import { stripMarkdown } from '../../lib/markdown';
import { imagenParaArticulo } from '../../lib/conocimiento-imagenes';
import { t } from '../../i18n/utils';
import '../../styles/site-faithful.css';

const locale = 'es';
const title = buildPageTitle(t(locale, 'conocimiento.titulo'));
const description = t(locale, 'conocimiento.descripcion');
const canonical = buildCanonical('/es/conocimiento');
const articulos = await getArticulos(locale);
const articulosVista = articulos.map(articulo => ({
  ...articulo,
  resumen: stripMarkdown(articulo.cuerpo),
  imagen: imagenParaArticulo(articulo.slug),
}));

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t(locale, 'conocimiento.listado_titulo'),
  itemListElement: articulos.map((articulo, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: buildCanonical(`/es/conocimiento/${articulo.slug}`),
    name: articulo.titulo,
  })),
};

const jsonLd = combineJsonLd(
  buildOrganizationJsonLd(),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/es/') },
    { name: t(locale, 'conocimiento.titulo'), url: canonical },
  ]),
  itemListJsonLd
);
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath="/es/conocimiento"
  jsonLd={jsonLd}
>
  <div class="site-faithful">
    <header class="page-hero" aria-labelledby="conocimiento-h1">
      <div class="container">
        <nav class="breadcrumb" aria-label="Ruta">
          <a href="/es/">Inicio</a><span class="sep">/</span><span aria-current="page"
            >{t(locale, 'conocimiento.titulo')}</span
          >
        </nav>
        <h1 id="conocimiento-h1">{t(locale, 'conocimiento.titulo')}</h1>
        <p class="ph-sub">{t(locale, 'conocimiento.descripcion')}</p>
      </div>
    </header>

    <section class="section" aria-label={t(locale, 'conocimiento.listado_titulo')}>
      <div class="container">
        <div class="s-header fade-in">
          <div class="s-label">
            {
              articulos.length
                ? `${articulos.length} artículos publicados`
                : t(locale, 'conocimiento.proximamente')
            }
          </div>
          <h2 class="s-title">{t(locale, 'conocimiento.listado_titulo')}</h2>
        </div>

        {
          articulos.length ? (
            <div class="knowledge-grid">
              {articulosVista.map((articulo, index) => (
                <article
                  class={`knowledge-card fade-in ${index % 3 === 1 ? 'd1' : index % 3 === 2 ? 'd2' : ''}`}
                >
                  <a
                    class="knowledge-card-img"
                    href={`/es/conocimiento/${articulo.slug}`}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img
                      src={articulo.imagen.src}
                      alt=""
                      width={articulo.imagen.width}
                      height={articulo.imagen.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <div class="knowledge-card-body">
                    <p class="knowledge-meta">
                      {t(locale, 'conocimiento.actualizado')}{' '}
                      {new Date(articulo.updated_at || articulo.created_at).toLocaleDateString(
                        'es-CO',
                        { year: 'numeric', month: 'long', day: 'numeric' }
                      )}
                    </p>
                    <h3>
                      <a href={`/es/conocimiento/${articulo.slug}`}>{articulo.titulo}</a>
                    </h3>
                    <p class="knowledge-excerpt">
                      {articulo.resumen.slice(0, 160)}
                      {articulo.resumen.length > 160 ? '…' : ''}
                    </p>
                    <a class="knowledge-more" href={`/es/conocimiento/${articulo.slug}`}>
                      {t(locale, 'conocimiento.leer_mas')}{' '}
                      <i class="fas fa-arrow-right" aria-hidden="true" />
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="knowledge-empty fade-in">
              <h3>{t(locale, 'conocimiento.ninguno')}</h3>
              <p>{t(locale, 'conocimiento.vacio')}</p>
            </div>
          )
        }
      </div>
    </section>

    <section class="section section-off" aria-label="Proponer artículo">
      <div class="container">
        <div class="cta-block fade-in">
          <div class="s-label s-label-white">Participa</div>
          <h2 class="cta-title">¿Tiene un tema biomédico que aportar?</h2>
          <p class="cta-sub">
            Proponga un artículo para el centro de conocimiento o contáctenos para resolver dudas
            técnicas sobre equipamiento biomédico.
          </p>
          <div class="cta-btns">
            <a href="/es/conocimiento/publicar" class="btn btn-green">
              <i class="fas fa-pen" aria-hidden="true"></i> Proponer artículo
            </a>
            <a href="/es/contacto" class="btn btn-outline-white"
              >{t(locale, 'conocimiento.cta_contacto')}</a
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .site-faithful .knowledge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 28px;
  }
  .site-faithful .knowledge-card {
    display: flex;
    flex-direction: column;
    background: var(--white, #fff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 16px;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .site-faithful .knowledge-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(15, 76, 92, 0.14);
  }
  .site-faithful .knowledge-card-img {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .site-faithful .knowledge-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .site-faithful .knowledge-card:hover .knowledge-card-img img {
    transform: scale(1.04);
  }
  .site-faithful .knowledge-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 24px 24px;
  }
  .site-faithful .knowledge-meta {
    margin: 0 0 8px;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--teal, #0f4c5c);
    font-weight: 600;
  }
  .site-faithful .knowledge-card h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    line-height: 1.35;
  }
  .site-faithful .knowledge-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .site-faithful .knowledge-card h3 a:hover {
    color: var(--teal, #0f4c5c);
  }
  .site-faithful .knowledge-excerpt {
    margin: 0 0 18px;
    color: var(--text-mid, #4a5a66);
    line-height: 1.65;
    flex: 1;
  }
  .site-faithful .knowledge-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--teal, #0f4c5c);
    text-decoration: none;
  }
  .site-faithful .knowledge-more:hover {
    text-decoration: underline;
  }
  .site-faithful .knowledge-empty {
    padding: 40px;
    border: 1px dashed var(--border, #e2e8f0);
    border-radius: 16px;
    text-align: center;
    color: var(--text-mid, #4a5a66);
  }
</style>

<script>
  function initConocimiento() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const faders = document.querySelectorAll<HTMLElement>(
      '.site-faithful .fade-in:not([data-ime-bound])'
    );
    faders.forEach(el => (el.dataset.imeBound = '1'));
    if (reduce || !('IntersectionObserver' in window)) {
      faders.forEach(el => el.classList.add('visible'));
      return;
    }
    const io = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    faders.forEach(el => io.observe(el));
  }

  initConocimiento();
  document.addEventListener('astro:page-load', initConocimiento);
</script>
