---
import Layout from '../../../layouts/Layout.astro';
import {
  buildPageTitle,
  buildCanonical,
  buildOrganizationJsonLd,
  buildBreadcrumbJsonLd,
  combineJsonLd,
} from '../../../lib/seo';
import { getArticulos, type Articulo } from '../../../lib/datos';
import { stripMarkdown } from '../../../lib/markdown';
import { renderArticleBody } from '../../../lib/conocimiento-articulo';
import {
  resolverImagenArticulo,
  resolverOgImagenArticulo,
  absoluteImagenUrl,
} from '../../../lib/conocimiento-imagenes';
import { t } from '../../../i18n/utils';
import '../../../styles/site-faithful.css';

const locale = 'es';

export async function getStaticPaths() {
  const articulos = await getArticulos('es');
  return articulos.map(articulo => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

interface Props {
  articulo: Articulo;
}

const { articulo } = Astro.props as Props;
const canonical = buildCanonical(`/es/conocimiento/${articulo.slug}`);
const title = buildPageTitle(articulo.titulo);
const description = stripMarkdown(articulo.cuerpo || articulo.titulo).slice(0, 155);
const imagen = resolverImagenArticulo(articulo, locale);
const ogImagen = resolverOgImagenArticulo(articulo, locale);
const ogImage = absoluteImagenUrl(ogImagen.src);

const jsonLd = combineJsonLd(
  buildOrganizationJsonLd(),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/es/') },
    { name: t(locale, 'conocimiento.titulo'), url: buildCanonical('/es/conocimiento') },
    { name: articulo.titulo, url: canonical },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articulo.titulo,
    description,
    image: absoluteImagenUrl(imagen.src),
    datePublished: articulo.created_at,
    dateModified: articulo.updated_at,
    author: {
      '@type': 'Organization',
      name: 'I-ME International Medical Enterprise',
    },
    mainEntityOfPage: canonical,
  }
);
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath={`/es/conocimiento/${articulo.slug}`}
  ogImage={ogImage}
  ogImageWidth={ogImagen.width}
  ogImageHeight={ogImagen.height}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="site-faithful">
    <header class="page-hero" aria-labelledby="article-h1">
      <div class="container">
        <nav class="breadcrumb" aria-label="Ruta">
          <a href="/es/">Inicio</a><span class="sep">/</span>
          <a href="/es/conocimiento">{t(locale, 'conocimiento.titulo')}</a><span class="sep">/</span
          ><span aria-current="page">{articulo.titulo}</span>
        </nav>
        <h1 id="article-h1">{articulo.titulo}</h1>
        <p class="ph-sub article-meta">
          {t(locale, 'conocimiento.publicado')}
          {
            new Date(articulo.created_at).toLocaleDateString('es-CO', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
          {' · '}
          {t(locale, 'conocimiento.actualizado')}
          {
            new Date(articulo.updated_at).toLocaleDateString('es-CO', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </p>
      </div>
    </header>

    <article class="section article-page">
      <div class="container article-shell">
        <div class="story-text">
          <div class="story-image">
            <div class="image-wrapper">
              <img
                src={imagen.src}
                alt={articulo.titulo}
                width={imagen.width}
                height={imagen.height}
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
          <div
            class="article-body"
            set:html={renderArticleBody(articulo.cuerpo, t(locale, 'conocimiento.vacio'))}
          />
        </div>
        <div class="article-footer">
          <a href="/es/conocimiento" class="btn btn-outline">← {t(locale, 'conocimiento.volver')}</a
          >
          <a href="/es/contacto" class="btn btn-primary">{t(locale, 'conocimiento.cta_contacto')}</a
          >
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .site-faithful .article-shell {
    max-width: 860px;
  }
  .site-faithful .article-meta {
    font-size: 0.95rem;
  }

  /* Mismo patron tipo prensa que src/pages/es/nosotros.astro: la imagen
     flota dentro del bloque de texto (flow-root) en vez de quedar como
     banner separado. */
  .site-faithful .story-text {
    display: flow-root;
  }

  .site-faithful .story-image {
    float: right;
    width: 100%;
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 768px) {
    .site-faithful .story-image {
      width: 380px;
      margin-left: var(--space-lg);
      margin-bottom: var(--space-md);
    }
  }

  .site-faithful .image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 767px) {
    .site-faithful .image-wrapper {
      aspect-ratio: 4 / 3;
    }
  }

  .site-faithful .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-faithful .article-body {
    color: var(--text-mid, #3c4a55);
    line-height: 1.75;
    font-size: 1.02rem;
  }
  .site-faithful .article-body :global(p),
  .site-faithful .article-body :global(li) {
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
    overflow-wrap: break-word;
  }
  .site-faithful .article-body :global(h2),
  .site-faithful .article-body :global(h3),
  .site-faithful .article-body :global(h4) {
    color: var(--ink, #131b22);
    margin-top: 1.8em;
    text-align: start;
    hyphens: none;
  }
  .site-faithful .article-body :global(a) {
    color: var(--teal, #0f4c5c);
  }
  .site-faithful .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .site-faithful .article-footer {
    clear: both;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border, #e2e8f0);
  }
</style>
