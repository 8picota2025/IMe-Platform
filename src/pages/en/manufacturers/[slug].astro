---
import CampaignLandingPage from '../../../components/CampaignLandingPage.astro';
import {
  getFabricanteLandingIdBySlug,
  listFabricanteSlugs,
} from '../../../data/fabricante-landings';
import { getFabricanteLandingCms } from '../../../lib/landings-cms';

export function getStaticPaths() {
  return listFabricanteSlugs().map(slug => ({ params: { slug } }));
}

const locale = 'en' as const;
const slug = Astro.params.slug!;
const id = getFabricanteLandingIdBySlug(slug);
if (!id) {
  return Astro.redirect('/en/manufacturers/');
}
const content = await getFabricanteLandingCms(id, locale);
---

<CampaignLandingPage locale={locale} content={content} productos={[]} />
