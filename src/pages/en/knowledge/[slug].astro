---
import Layout from '../../../layouts/Layout.astro';
import {
  buildPageTitle,
  buildCanonical,
  buildOrganizationJsonLd,
  buildBreadcrumbJsonLd,
  combineJsonLd,
} from '../../../lib/seo';
import { getArticulos, type Articulo } from '../../../lib/datos';
import { renderMarkdown, stripMarkdown } from '../../../lib/markdown';
import { imagenParaArticulo } from '../../../lib/conocimiento-imagenes';
import { t } from '../../../i18n/utils';
import '../../../styles/site-faithful.css';

const locale = 'en';

export async function getStaticPaths() {
  const articulos = await getArticulos('en');
  return articulos.map(articulo => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

interface Props {
  articulo: Articulo;
}

const { articulo } = Astro.props as Props;
const canonical = buildCanonical(`/en/knowledge/${articulo.slug}`);
const title = buildPageTitle(articulo.titulo);
const description = stripMarkdown(articulo.cuerpo || articulo.titulo).slice(0, 155);
const imagen = imagenParaArticulo(articulo.slug);

const jsonLd = combineJsonLd(
  buildOrganizationJsonLd(),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/en/') },
    { name: t(locale, 'conocimiento.titulo'), url: buildCanonical('/en/knowledge') },
    { name: articulo.titulo, url: canonical },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articulo.titulo,
    description,
    image: `https://i-me.com.co${imagen.src}`,
    datePublished: articulo.created_at,
    dateModified: articulo.updated_at,
    author: {
      '@type': 'Organization',
      name: 'I-ME International Medical Enterprise',
    },
    mainEntityOfPage: canonical,
  }
);
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath={`/en/knowledge/${articulo.slug}`}
  jsonLd={jsonLd}
>
  <div class="site-faithful">
    <header class="page-hero" aria-labelledby="article-h1">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/en/">Home</a><span class="sep">/</span>
          <a href="/en/knowledge">{t(locale, 'conocimiento.titulo')}</a><span class="sep">/</span
          ><span aria-current="page">{articulo.titulo}</span>
        </nav>
        <h1 id="article-h1">{articulo.titulo}</h1>
        <p class="ph-sub article-meta">
          {t(locale, 'conocimiento.publicado')}
          {
            new Date(articulo.created_at).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
          {' · '}
          {t(locale, 'conocimiento.actualizado')}
          {
            new Date(articulo.updated_at).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </p>
      </div>
    </header>

    <article class="section article-page">
      <div class="container article-shell">
        <figure class="article-cover">
          <img
            src={imagen.src}
            alt=""
            width={imagen.width}
            height={imagen.height}
            loading="eager"
            decoding="async"
          />
        </figure>
        <div
          class="article-body"
          set:html={renderMarkdown(articulo.cuerpo || t(locale, 'conocimiento.vacio'))}
        />
        <div class="article-footer">
          <a href="/en/knowledge" class="btn btn-outline">← {t(locale, 'conocimiento.volver')}</a>
          <a href="/en/contact" class="btn btn-primary">{t(locale, 'conocimiento.cta_contacto')}</a>
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .site-faithful .article-shell {
    max-width: 860px;
  }
  .site-faithful .article-meta {
    font-size: 0.95rem;
  }
  .site-faithful .article-cover {
    margin: 0 0 32px;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    box-shadow: 0 18px 40px rgba(15, 76, 92, 0.14);
  }
  .site-faithful .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .site-faithful .article-body {
    color: var(--text-mid, #3c4a55);
    line-height: 1.75;
    font-size: 1.02rem;
  }
  .site-faithful .article-body :global(h2),
  .site-faithful .article-body :global(h3) {
    color: var(--ink, #131b22);
    margin-top: 1.8em;
  }
  .site-faithful .article-body :global(a) {
    color: var(--teal, #0f4c5c);
  }
  .site-faithful .article-footer {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border, #e2e8f0);
  }
</style>
