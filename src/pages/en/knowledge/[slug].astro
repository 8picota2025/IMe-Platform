---
import Layout from '../../../layouts/Layout.astro';
import {
  buildPageTitle,
  buildCanonical,
  buildOrganizationJsonLd,
  buildBreadcrumbJsonLd,
  combineJsonLd,
} from '../../../lib/seo';
import type { Articulo } from '../../../lib/datos';
import { getArticulosConocimiento, esBorrador } from '../../../lib/conocimiento-borradores';
import { relacionadosEnTema, rutasConocimiento } from '../../../lib/conocimiento-clusters';
import RelacionadosTema from '../../../components/conocimiento/RelacionadosTema.astro';
import { stripMarkdown } from '../../../lib/markdown';
import { renderArticleBody } from '../../../lib/conocimiento-articulo';
import {
  resolverImagenArticulo,
  resolverOgImagenArticulo,
  absoluteImagenUrl,
} from '../../../lib/conocimiento-imagenes';
import { t } from '../../../i18n/utils';
import '../../../styles/site-faithful.css';

const locale = 'en';

export async function getStaticPaths() {
  const articulos = await getArticulosConocimiento('en');
  return articulos.map(articulo => ({
    params: { slug: articulo.slug },
    props: { articulo, relacionados: relacionadosEnTema(articulo, articulos) },
  }));
}

interface Props {
  articulo: Articulo;
  relacionados: Articulo[];
}

const { articulo, relacionados } = Astro.props as Props;
const tema = articulo.cluster;
const canonical = buildCanonical(`/en/knowledge/${articulo.slug}`);
const title = buildPageTitle(articulo.titulo);
const description = stripMarkdown(articulo.cuerpo || articulo.titulo).slice(0, 155);
const imagen = resolverImagenArticulo(articulo, locale);
const ogImagen = resolverOgImagenArticulo(articulo, locale);
const ogImage = absoluteImagenUrl(ogImagen.src);

const jsonLd = combineJsonLd(
  buildOrganizationJsonLd(),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/en/') },
    { name: t(locale, 'conocimiento.titulo'), url: buildCanonical('/en/knowledge') },
    ...(tema
      ? [{ name: tema.nombre, url: buildCanonical(rutasConocimiento.tema(locale, tema.slug)) }]
      : []),
    { name: articulo.titulo, url: canonical },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articulo.titulo,
    description,
    image: absoluteImagenUrl(imagen.src),
    datePublished: articulo.created_at,
    dateModified: articulo.updated_at,
    author: {
      '@type': 'Organization',
      name: 'I-ME International Medical Enterprise',
    },
    mainEntityOfPage: canonical,
  }
);
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath={`/en/knowledge/${articulo.slug}`}
  ogImage={ogImage}
  ogImageWidth={ogImagen.width}
  ogImageHeight={ogImagen.height}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="site-faithful">
    <header class="page-hero" aria-labelledby="article-h1">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/en/">Home</a><span class="sep">/</span>
          <a href="/en/knowledge">{t(locale, 'conocimiento.titulo')}</a><span class="sep">/</span>
          {
            tema && (
              <>
                <a href={rutasConocimiento.tema(locale, tema.slug)}>{tema.nombre}</a>
                <span class="sep">/</span>
              </>
            )
          }
          <span aria-current="page">{articulo.titulo}</span>
        </nav>
        {
          esBorrador(articulo) && (
            <p class="borrador-aviso" role="note">
              {t(locale, 'conocimiento.borrador_aviso')}
            </p>
          )
        }
        <h1 id="article-h1">{articulo.titulo}</h1>
        <p class="ph-sub article-meta">
          {t(locale, 'conocimiento.publicado')}
          {
            new Date(articulo.created_at).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
          {' · '}
          {t(locale, 'conocimiento.actualizado')}
          {
            new Date(articulo.updated_at).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </p>
      </div>
    </header>

    <article class="section article-page">
      <div class="container article-shell">
        <div class="story-text">
          <div class="story-image">
            <div class="image-wrapper">
              <img
                src={imagen.src}
                alt={articulo.titulo}
                width={imagen.width}
                height={imagen.height}
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
          <div
            class="article-body"
            set:html={renderArticleBody(articulo.cuerpo, t(locale, 'conocimiento.vacio'))}
          />
        </div>
        <RelacionadosTema articulo={articulo} relacionados={relacionados} locale={locale} />
        <div class="article-footer">
          <a href="/en/knowledge" class="btn btn-outline">← {t(locale, 'conocimiento.volver')}</a>
          <a href="/en/contact/" class="btn btn-primary">{t(locale, 'conocimiento.cta_contacto')}</a
          >
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .site-faithful .borrador-aviso {
    display: inline-block;
    margin: 0 0 12px;
    padding: 4px 12px;
    border-radius: 6px;
    background: var(--white);
    color: var(--t900);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .site-faithful .article-shell {
    max-width: 860px;
  }
  .site-faithful .article-meta {
    font-size: 0.95rem;
  }

  .site-faithful .story-text {
    display: block;
  }

  .site-faithful .story-image {
    width: 100%;
    max-width: 100%;
    margin: 0 0 var(--space-lg);
    float: none;
  }

  .site-faithful .image-wrapper {
    position: relative;
    overflow: visible;
    border-radius: var(--radius-lg);
  }

  .site-faithful .image-wrapper img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: unset;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .site-faithful .article-body {
    color: var(--text-mid, #3c4a55);
    line-height: 1.75;
    font-size: 1.02rem;
  }
  .site-faithful .article-body :global(p),
  .site-faithful .article-body :global(li) {
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
    overflow-wrap: break-word;
  }
  .site-faithful .article-body :global(h2),
  .site-faithful .article-body :global(h3),
  .site-faithful .article-body :global(h4) {
    color: var(--ink, #131b22);
    margin-top: 1.8em;
    text-align: start;
    hyphens: none;
  }
  .site-faithful .article-body :global(a) {
    color: var(--teal, #0f4c5c);
  }
  .site-faithful .article-body :global(.md-table) {
    margin: 1.5em 0;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .site-faithful .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .site-faithful .article-body :global(th),
  .site-faithful .article-body :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    hyphens: none;
  }
  .site-faithful .article-body :global(th) {
    background: var(--t50);
    color: var(--ink);
    font-weight: 700;
  }
  .site-faithful .article-body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .site-faithful .article-body :global(ul),
  .site-faithful .article-body :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }
  .site-faithful .article-body :global(ul) {
    list-style: disc;
  }
  .site-faithful .article-body :global(ol) {
    list-style: decimal;
  }
  .site-faithful .article-body :global(li) {
    margin-bottom: 0.4em;
  }
  .site-faithful .article-body :global(li.md-task) {
    list-style: none;
    margin-left: -1.2em;
  }
  .site-faithful .article-body :global(.md-task__box) {
    color: var(--t900);
    font-weight: 700;
  }
  .site-faithful .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .site-faithful .article-footer {
    clear: both;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border, #e2e8f0);
  }
</style>
