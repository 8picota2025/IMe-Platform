---
import ModalidadLanding from '../../../components/ModalidadLanding.astro';
import { getProductosBySlugs } from '../../../lib/datos';
import {
  MODALIDADES_ESTERILIZACION,
  getModalidad,
  slugsDeModalidad,
} from '../../../data/modalidades';

export function getStaticPaths() {
  return MODALIDADES_ESTERILIZACION.map(pagina => ({ params: { slug: pagina.slug } }));
}

const locale = 'en' as const;
const pagina = getModalidad(MODALIDADES_ESTERILIZACION, Astro.params.slug ?? '');
if (!pagina) throw new Error('Sterilization modality is not published');
const productos = await getProductosBySlugs(slugsDeModalidad(pagina), locale);
---

<ModalidadLanding
  locale={locale}
  pagina={pagina}
  productos={productos}
  currentPath={`/en/sterilization/${pagina.slug}`}
  parentHref="/en/sterilization/"
  parentLabel="Sterilization"
/>
