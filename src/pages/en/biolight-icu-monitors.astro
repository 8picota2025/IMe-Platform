---
import CampaignLandingPage from '../../components/CampaignLandingPage.astro';
import { getCampaignLanding } from '../../data/comercial-landings';
import { getProductosBySlugs } from '../../lib/datos';

const locale = 'en' as const;
const content = getCampaignLanding('monitores_biolight', locale);
const productos = await getProductosBySlugs(content.productSlugs, locale);
---

<CampaignLandingPage locale={locale} content={content} productos={productos} />
