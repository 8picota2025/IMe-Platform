---
import Layout from '../../../layouts/Layout.astro';
import { buildCanonical, buildPageTitle } from '../../../lib/seo';

const currentPath = '/en/quote/formalize';
---

<Layout
  title={buildPageTitle('Pay quote by bank transfer')}
  description="Review your I-ME quote, transfer the amount and upload the payment receipt."
  canonical={buildCanonical(currentPath)}
  locale="en"
  currentPath={currentPath}
  noindex={true}
>
  <main class="formalizar container">
    <section class="formalizar__panel" data-formalizar-root>
      <h1>Pay by bank transfer</h1>
      <p class="formalizar__status" data-formalizar-status>Validating link…</p>
      <div data-formalizar-content hidden></div>
      <form class="formalizar__form" data-formalizar-form hidden>
        <h2>Bank details</h2>
        <pre class="formalizar__bank" data-formalizar-bank></pre>
        <label class="formalizar__field">
          <span>Transfer reference / concept (optional)</span>
          <input name="referencia_transferencia" type="text" maxlength="120" autocomplete="off" />
        </label>
        <label class="formalizar__field">
          <span>Payment receipt (PDF, JPG, PNG — max 5 MB)</span>
          <input
            name="comprobante"
            type="file"
            accept=".pdf,image/jpeg,image/png,image/webp"
            required
          />
        </label>
        <fieldset class="formalizar__fiscal" data-formalizar-fiscal hidden>
          <legend>Electronic invoice (DIAN)</legend>
          <p class="formalizar__help">
            Optional. Colombia (COP) only. Transfer total does not change.
          </p>
          <label class="formalizar__check">
            <input name="solicitar_factura_electronica" type="checkbox" data-fiscal-toggle />
            <span>I request an electronic invoice</span>
          </label>
          <div data-fiscal-fields hidden>
            <label class="formalizar__field">
              <span>Document type</span>
              <select name="tipo_documento" data-fiscal-required>
                <option value="">—</option>
                <option value="NIT">NIT</option>
                <option value="CC">CC</option>
                <option value="CE">CE</option>
                <option value="PP">Pasaporte</option>
              </select>
            </label>
            <label class="formalizar__field">
              <span>Document number</span>
              <input
                name="numero_documento"
                type="text"
                maxlength="32"
                data-fiscal-required
                data-nit-input
                placeholder="e.g. 901441908-2"
              />
              <small class="formalizar__help" data-nit-hint></small>
            </label>
            <label class="formalizar__field">
              <span>Person type</span>
              <select name="tipo_persona" data-fiscal-required>
                <option value="">—</option>
                <option value="natural">Natural person</option>
                <option value="juridica">Legal entity</option>
              </select>
            </label>
            <label class="formalizar__field">
              <span>Legal / fiscal name</span>
              <input name="razon_social" type="text" maxlength="180" data-fiscal-required />
            </label>
            <label class="formalizar__field">
              <span>Billing email</span>
              <input name="email_facturacion" type="email" data-fiscal-required />
            </label>
            <label class="formalizar__field">
              <span>Address</span>
              <input
                name="direccion_facturacion"
                type="text"
                maxlength="200"
                data-fiscal-required
              />
            </label>
            <label class="formalizar__field">
              <span>City</span>
              <input name="ciudad_facturacion" type="text" maxlength="80" data-fiscal-required />
            </label>
            <label class="formalizar__field">
              <span>Department (optional)</span>
              <input name="departamento_facturacion" type="text" maxlength="80" />
            </label>
            <label class="formalizar__check">
              <input name="responsable_iva" type="checkbox" />
              <span>VAT responsible</span>
            </label>
          </div>
        </fieldset>
        <label class="formalizar__check">
          <input name="consentimiento" type="checkbox" required />
          <span>I authorize processing of my data to validate payment and manage the order.</span>
        </label>
        <button type="submit" class="btn btn-primary" data-formalizar-submit>
          Submit receipt and formalize order
        </button>
        <p class="formalizar__help" data-formalizar-form-status></p>
      </form>
    </section>
  </main>
</Layout>

<style>
  .formalizar {
    min-height: 60vh;
    padding: 3rem 0 4rem;
  }
  .formalizar__panel h1 {
    margin: 0 0 0.75rem;
  }
  .formalizar__status {
    margin: 0 0 1.5rem;
  }
  .formalizar__error {
    color: #8b1e1e;
  }
  .formalizar__ok {
    color: #0b5c3b;
  }
  .formalizar__table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.25rem;
  }
  .formalizar__table th,
  .formalizar__table td {
    text-align: left;
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--border-color, #c9d6db);
  }
  .formalizar__condiciones,
  .formalizar__bank {
    white-space: pre-wrap;
    padding: 1rem;
    margin: 0 0 1.5rem;
    border: 1px solid var(--border-color, #c9d6db);
    background: rgba(255, 255, 255, 0.65);
  }
  .formalizar__total {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .formalizar__form {
    display: grid;
    gap: 1rem;
    max-width: 560px;
  }
  .formalizar__field {
    display: grid;
    gap: 0.35rem;
  }
  .formalizar__check {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .formalizar__fiscal {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--border-color, #c9d6db);
  }
  .formalizar__fiscal legend {
    padding: 0 0.35rem;
    font-weight: 600;
  }
  .formalizar__help {
    margin: 0;
    color: #3d5a63;
  }
</style>

<script>
  import { getSupabaseClient } from '../../../lib/supabase';
  import { verificarNitCampo } from '../../../lib/nit-dian';

  type Linea = {
    slug: string;
    nombre: string;
    cantidad: number;
    precio_unitario: number;
    subtotal: number;
    moneda: string;
  };

  type Preview = {
    id: string;
    nombre?: string;
    empresa?: string;
    email?: string;
    condiciones?: string;
    validez_hasta?: string;
    moneda: string;
    total: number;
    permite_factura_electronica?: boolean;
    lineas: Linea[];
  };

  const params = new URLSearchParams(location.search);
  const id = (params.get('id') ?? '').trim();
  // Email copy-paste may keep HTML entity as query key "amp;t"
  const token = (params.get('t') ?? params.get('amp;t') ?? '').trim();
  const statusEl = document.querySelector<HTMLElement>('[data-formalizar-status]');
  const contentEl = document.querySelector<HTMLElement>('[data-formalizar-content]');
  const form = document.querySelector<HTMLFormElement>('[data-formalizar-form]');
  const bankEl = document.querySelector<HTMLElement>('[data-formalizar-bank]');
  const formStatus = document.querySelector<HTMLElement>('[data-formalizar-form-status]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-formalizar-submit]');
  const fiscalBox = document.querySelector<HTMLElement>('[data-formalizar-fiscal]');
  const fiscalToggle = document.querySelector<HTMLInputElement>('[data-fiscal-toggle]');
  const fiscalFields = document.querySelector<HTMLElement>('[data-fiscal-fields]');

  function money(value: number, moneda: string): string {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: moneda || 'COP',
      maximumFractionDigits: moneda === 'COP' ? 0 : 2,
    }).format(value);
  }

  function escape(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function showError(msg: string) {
    if (statusEl) {
      statusEl.textContent = msg;
      statusEl.classList.add('formalizar__error');
    }
  }

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result ?? ''));
      reader.onerror = () => reject(new Error('No se pudo leer el archivo'));
      reader.readAsDataURL(file);
    });
  }

  function syncFiscalRequired() {
    const enabled = Boolean(fiscalToggle?.checked);
    if (fiscalFields) fiscalFields.hidden = !enabled;
    form
      ?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-fiscal-required]')
      .forEach(el => {
        el.required = enabled;
      });
  }

  fiscalToggle?.addEventListener('change', syncFiscalRequired);

  const nitInput = form?.querySelector<HTMLInputElement>('[data-nit-input]');
  const nitHint = form?.querySelector<HTMLElement>('[data-nit-hint]');
  const tipoDocSelect = form?.querySelector<HTMLSelectElement>('[name="tipo_documento"]');
  function syncNitHint() {
    if (!nitInput || !nitHint) return;
    const tipo = (tipoDocSelect?.value || 'NIT') as 'NIT' | 'CC' | 'CE' | 'PP' | 'OTRO';
    if (!nitInput.value.trim()) {
      nitHint.textContent = '';
      return;
    }
    const r = verificarNitCampo(nitInput.value, tipo);
    if (r.ok && r.numero) {
      nitInput.value = r.numero;
      nitHint.textContent =
        tipo === 'NIT' ? `Valid NIT: ${r.numero_formateado}` : 'Valid document format';
      nitHint.style.color = '#0b5c3b';
    } else {
      nitHint.textContent = r.errores[0] ?? 'Invalid document';
      nitHint.style.color = '#8b1e1e';
    }
  }
  nitInput?.addEventListener('blur', syncNitHint);
  tipoDocSelect?.addEventListener('change', syncNitHint);

  async function messageFromInvokeError(
    error: { message?: string; context?: unknown },
    fallback: string
  ): Promise<string> {
    const context = error.context;
    if (context instanceof Response) {
      try {
        const json = (await context.clone().json()) as {
          error?: { message?: string; code?: string };
        };
        if (json?.error?.message) return json.error.message;
      } catch {
        /* ignore */
      }
    }
    return error.message || fallback;
  }

  async function load() {
    if (!statusEl || !contentEl || !form || !bankEl) return;
    if (!id || !token) {
      showError('Incomplete link. Use the link from the quote email.');
      return;
    }
    const supabase = getSupabaseClient();
    if (!supabase) {
      showError('Could not connect. Try again later.');
      return;
    }
    const { data, error } = await supabase.functions.invoke('formalizar-cotizacion', {
      body: { action: 'preview', cotizacion_id: id, token },
    });
    if (error) {
      showError(await messageFromInvokeError(error, 'Could not validate the quote.'));
      return;
    }
    const json = data as {
      ok?: boolean;
      error?: { message?: string };
      cotizacion?: Preview;
      transferencia?: { texto?: string };
    };
    if (!json?.ok || !json.cotizacion) {
      showError(json?.error?.message || 'Quote not available for formalization.');
      return;
    }

    const cotizacion = json.cotizacion;
    statusEl.textContent = `Hello ${cotizacion.nombre ?? 'customer'}. Review the offer, transfer the total and upload the receipt.`;
    statusEl.classList.remove('formalizar__error');
    contentEl.hidden = false;
    contentEl.innerHTML = `
      ${cotizacion.empresa ? `<p><strong>Company:</strong> ${escape(cotizacion.empresa)}</p>` : ''}
      ${cotizacion.validez_hasta ? `<p><strong>Valid until:</strong> ${escape(cotizacion.validez_hasta)}</p>` : ''}
      <table class="formalizar__table">
        <thead><tr><th>Product</th><th>Qty</th><th>Unit</th><th>Subtotal</th></tr></thead>
        <tbody>
          ${cotizacion.lineas
            .map(
              l => `<tr>
                <td>${escape(l.nombre)}</td>
                <td>${l.cantidad}</td>
                <td>${money(l.precio_unitario, l.moneda)}</td>
                <td>${money(l.subtotal, l.moneda)}</td>
              </tr>`
            )
            .join('')}
        </tbody>
      </table>
      <p class="formalizar__total">Amount to transfer: ${money(cotizacion.total, cotizacion.moneda)}</p>
      <h2>Notes / configuration</h2>
      <pre class="formalizar__condiciones">${escape(cotizacion.condiciones ?? '')}</pre>
    `;
    bankEl.textContent = json.transferencia?.texto ?? '';
    form.hidden = false;
    if (fiscalBox && cotizacion.permite_factura_electronica) {
      fiscalBox.hidden = false;
      const emailInput = form.querySelector<HTMLInputElement>('[name="email_facturacion"]');
      const razonInput = form.querySelector<HTMLInputElement>('[name="razon_social"]');
      if (emailInput && cotizacion.email) emailInput.value = cotizacion.email;
      if (razonInput && cotizacion.empresa) razonInput.value = cotizacion.empresa;
    }
    syncFiscalRequired();

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!submitBtn || !formStatus) return;
      const fd = new FormData(form);
      const file = fd.get('comprobante');
      if (!(file instanceof File) || file.size === 0) {
        formStatus.textContent = 'Attach the transfer receipt.';
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        formStatus.textContent = 'File exceeds 5 MB.';
        return;
      }
      submitBtn.disabled = true;
      formStatus.textContent = 'Submitting receipt…';
      try {
        const dataUrl = await fileToBase64(file);
        const solicitarFactura = fd.get('solicitar_factura_electronica') === 'on';
        const tipoDocumento = String(fd.get('tipo_documento') ?? '');
        let numeroDocumento = String(fd.get('numero_documento') ?? '');
        if (solicitarFactura && (tipoDocumento === 'NIT' || tipoDocumento === 'CC')) {
          const check = verificarNitCampo(numeroDocumento, tipoDocumento);
          if (!check.ok || !check.numero) {
            formStatus.textContent = check.errores[0] ?? 'Invalid tax ID';
            submitBtn.disabled = false;
            return;
          }
          numeroDocumento = check.numero;
          if (nitInput) nitInput.value = check.numero;
        }
        const fiscal = solicitarFactura
          ? {
              solicitar_factura_electronica: true,
              tipo_documento: tipoDocumento,
              numero_documento: numeroDocumento,
              tipo_persona: String(fd.get('tipo_persona') ?? ''),
              razon_social: String(fd.get('razon_social') ?? ''),
              email_facturacion: String(fd.get('email_facturacion') ?? ''),
              responsable_iva: fd.get('responsable_iva') === 'on',
              direccion_facturacion: {
                direccion: String(fd.get('direccion_facturacion') ?? ''),
                ciudad: String(fd.get('ciudad_facturacion') ?? ''),
                departamento: String(fd.get('departamento_facturacion') ?? '') || null,
                pais: 'CO',
              },
            }
          : { solicitar_factura_electronica: false };
        const { data: result, error: submitError } = await supabase.functions.invoke(
          'formalizar-cotizacion',
          {
            body: {
              action: 'registrar_transferencia',
              cotizacion_id: id,
              token,
              referencia_transferencia: String(fd.get('referencia_transferencia') ?? ''),
              comprobante_base64: dataUrl,
              comprobante_nombre: file.name,
              comprobante_mime: file.type || 'application/pdf',
              consentimiento_datos: true,
              fiscal,
            },
          }
        );
        if (submitError) {
          formStatus.textContent = await messageFromInvokeError(
            submitError,
            'Could not register payment.'
          );
          submitBtn.disabled = false;
          return;
        }
        const jsonResult = result as {
          ok?: boolean;
          error?: { message?: string };
          referencia?: string;
          facturacion_solicitada?: boolean;
        };
        if (!jsonResult?.ok) {
          formStatus.textContent = jsonResult?.error?.message || 'Could not register payment.';
          submitBtn.disabled = false;
          return;
        }
        form.hidden = true;
        statusEl.classList.remove('formalizar__error');
        statusEl.classList.add('formalizar__ok');
        statusEl.textContent = `Receipt received. Order ${jsonResult.referencia ?? ''} pending validation. We will confirm by email.`;
        contentEl.insertAdjacentHTML(
          'beforeend',
          `<p class="formalizar__ok">Thank you. Our team will validate the transfer.${
            jsonResult.facturacion_solicitada
              ? ' The electronic invoice will be issued when payment is confirmed.'
              : ''
          }</p>`
        );
      } catch {
        formStatus.textContent = 'Network error submitting the receipt.';
        submitBtn.disabled = false;
      }
    });
  }

  void load();
</script>
