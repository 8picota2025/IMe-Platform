---
import CampaignLandingPage from '../../components/CampaignLandingPage.astro';
import { getCampaignLandingCms } from '../../lib/landings-cms';

const locale = 'en' as const;
const cms = await getCampaignLandingCms('ventiladores_mecanicos', locale);
// arreglos011126 ítem 6: Monnal retirado del catálogo; la guía queda sin fichas ni menciones de marca.
const content = {
  ...cms,
  title: 'ICU mechanical ventilators | I-ME',
  description:
    'Criteria for evaluating adult and pediatric ICU mechanical ventilators. Quote via WhatsApp or online.',
  h1: 'Mechanical ventilators for the ICU',
  lead: 'Request a quote for the ICU mechanical ventilator by service and patient profile. Configuration and price are quoted.',
  productSlugs: [],
};
const productos: never[] = [];
---

<CampaignLandingPage locale={locale} content={content} productos={productos} />
