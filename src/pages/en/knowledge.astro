---
import Layout from '../../layouts/Layout.astro';
import {
  buildPageTitle,
  buildCanonical,
  buildOrganizationJsonLd,
  buildBreadcrumbJsonLd,
  combineJsonLd,
} from '../../lib/seo';
import { getArticulosConocimiento } from '../../lib/conocimiento-borradores';
import { agruparPorTema } from '../../lib/conocimiento-clusters';
import TarjetaArticulo from '../../components/conocimiento/TarjetaArticulo.astro';
import NavTemas from '../../components/conocimiento/NavTemas.astro';
import { t } from '../../i18n/utils';
import '../../styles/site-faithful.css';

const locale = 'en';
const title = buildPageTitle(t(locale, 'conocimiento.titulo'));
const description = t(locale, 'conocimiento.descripcion');
const canonical = buildCanonical('/en/knowledge');
const articulos = await getArticulosConocimiento(locale);
const temas = agruparPorTema(articulos);

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t(locale, 'conocimiento.listado_titulo'),
  itemListElement: articulos.map((articulo, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: buildCanonical(`/en/knowledge/${articulo.slug}`),
    name: articulo.titulo,
  })),
};

const jsonLd = combineJsonLd(
  buildOrganizationJsonLd(),
  buildBreadcrumbJsonLd([
    { name: t(locale, 'catalogo.migas_inicio'), url: buildCanonical('/en/') },
    { name: t(locale, 'conocimiento.titulo'), url: canonical },
  ]),
  itemListJsonLd
);
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath="/en/knowledge"
  jsonLd={jsonLd}
>
  <div class="site-faithful">
    <header class="page-hero" aria-labelledby="knowledge-h1">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/en/">Home</a><span class="sep">/</span><span aria-current="page"
            >{t(locale, 'conocimiento.titulo')}</span
          >
        </nav>
        <h1 id="knowledge-h1">{t(locale, 'conocimiento.titulo')}</h1>
        <p class="ph-sub">{t(locale, 'conocimiento.descripcion')}</p>
      </div>
    </header>

    <section class="section" aria-label={t(locale, 'conocimiento.listado_titulo')}>
      <div class="container">
        <NavTemas temas={temas} locale={locale} total={articulos.length} />
        <div class="s-header fade-in">
          <div class="s-label">
            {
              articulos.length
                ? `${articulos.length} published articles`
                : t(locale, 'conocimiento.proximamente')
            }
          </div>
          <h2 class="s-title">{t(locale, 'conocimiento.listado_titulo')}</h2>
        </div>

        {
          articulos.length ? (
            <div class="knowledge-grid">
              {articulos.map((articulo, index) => (
                <TarjetaArticulo articulo={articulo} locale={locale} index={index} />
              ))}
            </div>
          ) : (
            <div class="knowledge-empty fade-in">
              <h3>{t(locale, 'conocimiento.ninguno')}</h3>
              <p>{t(locale, 'conocimiento.vacio')}</p>
            </div>
          )
        }
      </div>
    </section>

    <section
      class="section section-off"
      aria-label="Submit article"
      hidden
      style="display:none!important"
    >
      <div class="container">
        <div
          class="cta-block fade-in"
          style="background-image: url('/assets/img/asesoramiento-integral-biomedico.webp'); background-size: cover; background-position: center; position: relative;"
        >
          <div style="position: absolute; inset: 0; background: rgba(15, 76, 92, 0.75);"></div>
          <div style="position: relative; z-index: 1;">
            <div class="s-label s-label-white">Get involved</div>
            <h2 class="cta-title">Do you have a biomedical topic to share?</h2>
            <p class="cta-sub">
              Submit an article for the knowledge center or contact us to resolve technical
              questions about biomedical equipment.
            </p>
            <div class="cta-btns">
              <a href="/en/knowledge/publish" class="btn btn-green">
                <i class="fas fa-pen" aria-hidden="true"></i> Submit article
              </a>
              <a href="/en/contact/" class="btn btn-outline-white"
                >{t(locale, 'conocimiento.cta_contacto')}</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .site-faithful .knowledge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 28px;
  }
  .site-faithful .knowledge-empty {
    padding: 40px;
    border: 1px dashed var(--border, #e2e8f0);
    border-radius: 16px;
    text-align: center;
    color: var(--text-mid, #4a5a66);
  }
</style>

<script>
  function initKnowledge() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const faders = document.querySelectorAll<HTMLElement>(
      '.site-faithful .fade-in:not([data-ime-bound])'
    );
    faders.forEach(el => (el.dataset.imeBound = '1'));
    if (reduce || !('IntersectionObserver' in window)) {
      faders.forEach(el => el.classList.add('visible'));
      return;
    }
    const io = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    faders.forEach(el => io.observe(el));
  }

  initKnowledge();
  document.addEventListener('astro:page-load', initKnowledge);
</script>
