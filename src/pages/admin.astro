---
import '../admin/admin.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>I-ME Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@500;600&family=Sora:wght@600;700&display=swap"
    />
  </head>
  <body class="admin-body">
    <main id="admin-app" class="admin-root">
      <section class="admin-loading" aria-live="polite">
        <span class="admin-loading__mark"></span>
        Cargando back-office
      </section>
    </main>
    <script>
      import '../admin/admin-app';
    </script>
  </body>
</html>
