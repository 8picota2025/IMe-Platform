---
/**
 * Language-neutral trust anchor for agents auditing /about.
 * Canonical localized pages: /es/nosotros/ and /en/about/
 */
import Layout from '../layouts/Layout.astro';
import {
  buildCanonical,
  buildOrganizationJsonLd,
  buildPageTitle,
  combineJsonLd,
  getInstitutionalOgImage,
} from '../lib/seo';
import '../styles/site-faithful.css';

const locale = 'en';
const title = buildPageTitle('About I-ME');
const description =
  'I-ME International Medical Enterprise — Colombian biomedical technology partner helping healthcare institutions identify, evaluate, and implement clinical solutions with end-to-end support.';
const canonical = buildCanonical('/about');

const jsonLd = combineJsonLd(buildOrganizationJsonLd(), {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: canonical,
  name: 'About I-ME',
  about: { '@id': 'https://i-me.com.co/#organization' },
  inLanguage: 'en',
});
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  currentPath="/about"
  ogImage={getInstitutionalOgImage()}
  jsonLd={jsonLd}
  monolingual={true}
>
  <div class="site-faithful">
    <header class="page-hero" aria-labelledby="about-h1">
      <div class="container">
        <h1 id="about-h1">About I-ME International Medical Enterprise</h1>
        <p class="ph-sub">
          Technology, experience, and execution capacity in service of healthcare.
        </p>
      </div>
    </header>

    <section class="section" aria-labelledby="about-body-h2">
      <div class="container" style="max-width: 760px">
        <h2 id="about-body-h2" class="s-title">Who we are</h2>
        <p>
          I-ME International Medical Enterprise S.A.S. (NIT 901871720-1) is a Colombian company
          specialized in biomedical technology and solutions for healthcare institutions,
          headquartered in Envigado, Antioquia.
        </p>
        <p>
          Our work goes beyond equipment distribution. We help hospitals, clinics, and healthcare
          professionals identify, evaluate, and implement technology solutions suited to clinical,
          technical, operational, and financial needs — including import, logistics, installation,
          training, and lifecycle support.
        </p>
        <p>
          Regulatory status (INVIMA, CE, FDA, or other) must be confirmed per reference before
          purchase — our commercial team validates this in every formal quotation.
        </p>
        <p>
          <strong>Localized pages:</strong>
          <a href="/es/nosotros/">Nosotros (ES)</a> ·
          <a href="/en/about/">About (EN)</a> ·
          <a href="/privacy/">Privacy policy</a> ·
          <a href="/contact/">Contact</a>
        </p>
      </div>
    </section>
  </div>
</Layout>
